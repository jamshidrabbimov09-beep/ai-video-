"text":"turib","start":72.62,"end":72.88,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"jang","start":72.92,"end":73.1,"type":"word","speaker":"speaker_0","confidence":1},{"text":"qilarmidingiz?","start":73.12,"end":73.82,"type":"word","speaker":"speaker_0","confidence":0.932},{"text":"Ha","start":74.24,"end":74.38,"type":"word","speaker":"speaker_0","confidence":1},{"text":"yoki","start":74.46,"end":74.74,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"yo‘q","start":74.8,"end":75.04,"type":"word","speaker":"speaker_0","confidence":0.995},{"text":"izohda","start":75.34,"end":75.68,"type":"word","speaker":"speaker_0","confidence":0.959},{"text":"yozing.","start":75.7,"end":76,"type":"word","speaker":"speaker_0","confidence":0.969}],"speakers":["speaker_0"],"duration":76.2775625,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/054412aa-e2da-4b34-8d61-d91dee801552.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.16,"end":1.98,"text":"Shahzoda filga qilich urdi.","wordRange":[0,3]},{"id":"s2","speaker":"Speaker 0","start":2.76,"end":5.32,"text":"Yuz yigirma jangovar fil Temurniki bo‘ldi.","wordRange":[4,9]},{"id":"s3","speaker":"Speaker 0","start":6.06,"end":10.54,"text":"Oldingi qismda Dehli ostonasida Temurga qarshi yuz yigirma fil chiqqan edi.","wordRange":[10,20]},{"id":"s4","speaker":"Speaker 0","start":11.16,"end":12.18,"text":"O'n yettinchi dekabr.","wordRange":[21,23]},{"id":"s5","speaker":"Speaker 0","start":12.72,"end":13.96,"text":"Fillar oldinga yuradi.","wordRange":[24,26]},{"id":"s6","speaker":"Speaker 0","start":14.5,"end":17.54,"text":"Shahzoda Pir Muhammad birinchi bo‘lib filga qilich uradi.","wordRange":[27,34]},{"id":"s7","speaker":"Speaker 0","start":18.02,"end":21.16,"text":"Askarlar fil ustidagi kamonchilarni kamondan otib tushiradi.","wordRange":[35,41]},{"id":"s8","speaker":"Speaker 0","start":21.5,"end":23.44,"text":"Fillarning xartumini qilich bilan chopadi.","wordRange":[42,46]},{"id":"s9","speaker":"Speaker 0","start":23.96,"end":25.36,"text":"Hind qo‘shini chekinadi.","wordRange":[47,49]},{"id":"s10","speaker":"Speaker 0","start":25.78,"end":31.48,"text":"Temurning nevarasi Xalil sulton bitta filni xuddi sigirdek haydab bobosining oldiga olib keladi.","wordRange":[50,62]},{"id":"s11","speaker":"Speaker 0","start":31.92,"end":35.76,"text":"O‘sha kechasi sulton Mahmud va Mallu xon shahardan qochib ketadi.","wordRange":[63,72]},{"id":"s12","speaker":"Speaker 0","start":36.52,"end":41.56,"text":"Dehli taslim bo‘ladi, lekin bir necha kundan keyin shaharda to‘qnashuvlar boshlanadi.","wordRange":[73,83]},{"id":"s13","speaker":"Speaker 0","start":42.02,"end":45.02,"text":"Askarlar Dehliyni talab, yoqib yuboradi.","wordRange":[84,88]},{"id":"s14","speaker":"Speaker 0","start":45.5,"end":50.94,"text":"Tarixchilar fikricha, bu Temur o‘z qo‘shinini to‘xtata olmagan kamdan-kam holatlardan biri edi.","wordRange":[89,100]},{"id":"s15","speaker":"Speaker 0","start":51.46,"end":55.72,"text":"Fillar Samarqand, Xirot, Tabriz va Sherozga jo‘natiladi.","wordRange":[101,107]},{"id":"s16","speaker":"Speaker 0","start":56.12,"end":59.84,"text":"Ming uch yuz to‘qson to‘qqizinchi yil bahorida ular Samarqandga kirib keladi.","wordRange":[108,118]},{"id":"s17","speaker":"Speaker 0","start":60.24,"end":66.12,"text":"Shahar xalqi filni umrida birinchi marta ko‘rib turardi, lekin Temur Samarqandda uzoq qolmadi.","wordRange":[119,131]},{"id":"s18","speaker":"Speaker 0","start":66.56,"end":69.48,"text":"G‘arbda usmonli sultoni Boyazid kuchayib borardi.","wordRange":[132,137]},{"id":"s19","speaker":"Speaker 0","start":69.96,"end":70.76,"text":"Keyingi qismda.","wordRange":[138,139]},{"id":"s20","speaker":"Speaker 0","start":71.26,"end":71.62,"text":"Siz-chi?","wordRange":[140,140]},{"id":"s21","speaker":"Speaker 0","start":72.08,"end":73.82,"text":"Fil ustida turib jang qilarmidingiz?","wordRange":[141,145]},{"id":"s22","speaker":"Speaker 0","start":74.24,"end":76,"text":"Ha yoki yo‘q izohda yozing.","wordRange":[146,150]}],"model":"elevenlabs-scribe"}