4,"type":"word","speaker":"speaker_0","confidence":0.997}],"speakers":["speaker_0"],"duration":146.5991875,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/1266adff-7c45-458d-8430-d6f6bfd4c526.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.26,"end":1.22,"text":"Sirdaryo bo'yi.","wordRange":[0,1]},{"id":"s2","speaker":"Speaker 0","start":1.8,"end":4.059,"text":"Butazor ichida bir odam yotibdi.","wordRange":[2,6]},{"id":"s3","speaker":"Speaker 0","start":4.8,"end":8.74,"text":"Yalango'ch, qo'li kamon o'qidan yaralangan, zo'rg'a nafas oladi.","wordRange":[7,14]},{"id":"s4","speaker":"Speaker 0","start":9.4,"end":11.78,"text":"Bu Chingizxon avlodidan bo'lgan shahzoda.","wordRange":[15,19]},{"id":"s5","speaker":"Speaker 0","start":12.4,"end":13.66,"text":"Ismi To'xtamish.","wordRange":[20,21]},{"id":"s6","speaker":"Speaker 0","start":14.2,"end":19.86,"text":"Bir kun kelib u Temurdan eng katta yaxshilikni ko'radi va eng og'ir xiyonatni qiladi.","wordRange":[22,35]},{"id":"s7","speaker":"Speaker 0","start":20.9,"end":25.24,"text":"Bundan oldin To'xtamish O'rusxondan qochib Temur huzuriga panoh so'rab kelgan edi.","wordRange":[36,46]},{"id":"s8","speaker":"Speaker 0","start":25.7,"end":28.94,"text":"Temur uni izzat bilan kutib oldi, katta ziyofat berdi.","wordRange":[47,55]},{"id":"s9","speaker":"Speaker 0","start":29.3,"end":33.06,"text":"Xon chodiri, nog'ora, tuya va ot podalarini hadya qildi.","wordRange":[56,64]},{"id":"s10","speaker":"Speaker 0","start":33.48,"end":35.84,"text":"Yazdiy yozishicha, uni o'g'lidek ko'rdi.","wordRange":[65,69]},{"id":"s11","speaker":"Speaker 0","start":36.32,"end":38.62,"text":"O'tiror va sig'noq yerlarni ham unga berdi.","wordRange":[70,76]},{"id":"s12","speaker":"Speaker 0","start":39.16,"end":42.4,"text":"Lekin To'xtamish O'rusxonning o'g'illariga bas kela olmadi.","wordRange":[77,83]},{"id":"s13","speaker":"Speaker 0","start":42.82,"end":44.96,"text":"Bir jangda yengilib daryoga o'zini tashladi.","wordRange":[84,89]},{"id":"s14","speaker":"Speaker 0","start":45.26,"end":46.74,"text":"Ortidan kamondan o'q otildi.","wordRange":[90,93]},{"id":"s15","speaker":"Speaker 0","start":47.1,"end":52.16,"text":"Temur yuborgan bek esa butazordan ingrash ovozini eshitib, uni tasodifan topib oldi.","wordRange":[94,105]},{"id":"s16","speaker":"Speaker 0","start":52.74,"end":54.12,"text":"O'rusxondan elchilar keladi.","wordRange":[106,108]},{"id":"s17","speaker":"Speaker 0","start":54.5,"end":55.52,"text":"U o'g'limni o'ldirdi.","wordRange":[109,111]},{"id":"s18","speaker":"Speaker 0","start":55.82,"end":56.44,"text":"Uni bizga ber.","wordRange":[112,114]},{"id":"s19","speaker":"Speaker 0","start":56.76,"end":58.2,"text":"Bermasang jang joyini ayt.","wordRange":[115,118]},{"id":"s20","speaker":"Speaker 0","start":58.56,"end":59.52,"text":"Temur javob beradi.","wordRange":[119,121]},{"id":"s21","speaker":"Speaker 0","start":59.84,"end":61.2,"text":"U bizdan panoh so'rab keldi.","wordRange":[122,126]},{"id":"s22","speaker":"Speaker 0","start":61.5,"end":62.92,"text":"Men uni hech kimga bermayman.","wordRange":[127,131]},{"id":"s23","speaker":"Speaker 0","start":63.2,"end":64.819,"text":"Urush istasangiz tayyormiz.","wordRange":[132,134]},{"id":"s24","speaker":"Speaker 0","start":65.26,"end":67.02,"text":"To'xtamish to'rt marta qochib keldi.","wordRange":[135,139]},{"id":"s25","speaker":"Speaker 0","start":67.34,"end":69.88,"text":"Temur har safar uni qaytadan oyoqqa turg'izdi.","wordRange":[140,146]},{"id":"s26","speaker":"Speaker 0","start":70.22,"end":72.66,"text":"Oxiri To'xtamish Dashti Qipchoq taxtiga o'tirdi.","wordRange":[147,152]},{"id":"s27","speaker":"Speaker 0","start":72.92,"end":75.1,"text":"Keyin butun Oltin ordani egalladi.","wordRange":[153,157]},{"id":"s28","speaker":"Speaker 0","start":75.46,"end":77.5,"text":"Endi u Jo'chi ulusining xoni edi.","wordRange":[158,163]},{"id":"s29","speaker":"Speaker 0","start":77.84,"end":78.62,"text":"Chingiz avlodi.","wordRange":[164,165]},{"id":"s30","speaker":"Speaker 0","start":79.02,"end":81.5,"text":"Temur esa, eslang, xon bo'la olmasdi.","wordRange":[166,171]},{"id":"s31","speaker":"Speaker 0","start":81.86,"end":85,"text":"Mo'g'ul an'anasiga ko'ra To'xtamish Temurdan yuqori turardi.","wordRange":[172,178]},{"id":"s32","speaker":"Speaker 0","start":85.44,"end":87.7,"text":"Bir qinga ikki qilich sig'masdi.","wordRange":[179,183]},{"id":"s33","speaker":"Speaker 0","start":88.58,"end":90.7,"text":"Ming uch yuz sakson beshinchi yil, qish.","wordRange":[184,190]},{"id":"s34","speaker":"Speaker 0","start":91.14,"end":95.26,"text":"To'xtamish qo'shini darband orqali o'tib Temurga tobe Tabrizni talaydi.","wordRange":[191,199]},{"id":"s35","speaker":"Speaker 0","start":95.62,"end":97.68,"text":"Ming uch yuz sakson yettinchi yil, bahor.","wordRange":[200,206]},{"id":"s36","speaker":"Speaker 0","start":97.96,"end":100.68,"text":"Kura daryosi bo'yida yana uning qo'shini paydo bo'ladi.","wordRange":[207,214]},{"id":"s37","speaker":"Speaker 0","start":100.98,"end":101.74,"text":"Temur buyuradi.","wordRange":[215,216]},{"id":"s38","speaker":"Speaker 0","start":102.06,"end":105.12,"text":"Agar ular To'xtamishning odamlari bo'lsa, jang qilmanglar.","wordRange":[217,223]},{"id":"s39","speaker":"Speaker 0","start":105.46,"end":106.64,"text":"Beklar ortga qaytadi.","wordRange":[224,226]},{"id":"s40","speaker":"Speaker 0","start":106.94,"end":109.94,"text":"Dushman esa ularning orqasidan kamondan o'q yog'diradi.","wordRange":[227,233]},{"id":"s41","speaker":"Speaker 0","start":110.26,"end":112.56,"text":"Mironshoh yetib kelib dushmanni quvib soladi.","wordRange":[234,239]},{"id":"s42","speaker":"Speaker 0","start":112.98,"end":115.74,"text":"Temur asirlarni qo'yib yuborib To'xtamishga xabar yo'llaydi.","wordRange":[240,246]},{"id":"s43","speaker":"Speaker 0","start":116.2,"end":117.8,"text":"Oramizda ota-bola munosabati bor.","wordRange":[247,250]},{"id":"s44","speaker":"Speaker 0","start":118.36,"end":119.32,"text":"Nega bunday qilyapsan?","wordRange":[251,253]},{"id":"s45","speaker":"Speaker 0","start":120.46,"end":121.98,"text":"Javob o'sha yil keldi.","wordRange":[254,257]},{"id":"s46","speaker":"Speaker 0","start":122.6,"end":124.86,"text":"Temur uzoq janubda, Forsda edi.","wordRange":[258,262]},{"id":"s47","speaker":"Speaker 0","start":125.44,"end":127.74,"text":"To'xtamish qo'shini Movarunnahrga bostirib kirdi.","wordRange":[263,267]},{"id":"s48","speaker":"Speaker 0","start":128,"end":129.139,"text":"Buxoroni qamal qildi.","wordRange":[268,270]},{"id":"s49","speaker":"Speaker 0","start":129.46,"end":130.5,"text":"Zanjir saroyini yoqdi.","wordRange":[271,273]},{"id":"s50","speaker":"Speaker 0","start":130.84,"end":132.72,"text":"Amudaryogacha bo'lgan yerlarni taladi.","wordRange":[274,277]},{"id":"s51","speaker":"Speaker 0","start":133.4,"end":136.78,"text":"Temur qutqargan odam endi uning uyini yondirgan edi.","wordRange":[278,285]},{"id":"s52","speaker":"Speaker 0","start":137.52,"end":138.64,"text":"Temur ortga qaytadi.","wordRange":[286,288]},{"id":"s53","speaker":"Speaker 0","start":139.12,"end":143.06,"text":"Bir necha yil o'tib u To'xtamishni dashning o'zida izlab topishga qaror qiladi.","wordRange":[289,300]},{"id":"s54","speaker":"Speaker 0","start":143.8,"end":145.08,"text":"Bu yurish qanday tugadi?","wordRange":[301,304]},{"id":"s55","speaker":"Speaker 0","start":145.58,"end":146.34,"text":"Keyingi qismda.","wordRange":[305,306]}],"model":"elevenlabs-scribe"}