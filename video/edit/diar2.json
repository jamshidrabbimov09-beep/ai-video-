nce":0.996},{"text":"butun","start":131.56,"end":131.8,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"yurtni","start":131.86,"end":132.08,"type":"word","speaker":"speaker_0","confidence":1},{"text":"boshqardi?","start":132.12,"end":132.62,"type":"word","speaker":"speaker_0","confidence":0.995},{"text":"Keyingi","start":133.16,"end":133.5,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"qismda","start":133.54,"end":133.94,"type":"word","speaker":"speaker_0","confidence":1}],"speakers":["speaker_0"],"duration":134.1359375,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/01dcf6d4-fc48-4878-84c0-a68a3916fb76.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.14,"end":2.44,"text":"Yolgʻiz yigit hech kimni yenga olmaydi.","wordRange":[0,5]},{"id":"s2","speaker":"Speaker 0","start":3.24,"end":4.64,"text":"Temur buni erta tushundi.","wordRange":[6,9]},{"id":"s3","speaker":"Speaker 0","start":5.16,"end":8.18,"text":"Unga doʻst kerak edi va u doʻstni topdi.","wordRange":[10,17]},{"id":"s4","speaker":"Speaker 0","start":9,"end":11.52,"text":"Bu Temur va Amir Husayn haqidagi qissa.","wordRange":[18,24]},{"id":"s5","speaker":"Speaker 0","start":12.06,"end":18.74,"text":"Ikki yaqin odam bitta orzu, lekin oʻsha doʻst bir kuni undan ham xavfli dushmanga aylandi.","wordRange":[25,39]},{"id":"s6","speaker":"Speaker 0","start":19.38,"end":23.4,"text":"Bir ming uch yuz oltmishinchi yil Movarounnahr parchalangan.","wordRange":[40,47]},{"id":"s7","speaker":"Speaker 0","start":23.86,"end":26.62,"text":"Mogʻul xoni Tugʻluq Temur lashkar bilan kirib keladi.","wordRange":[48,55]},{"id":"s8","speaker":"Speaker 0","start":27,"end":29.72,"text":"Mahalliy amirlar yo qochadi, yo boʻy sunadi.","wordRange":[56,62]},{"id":"s9","speaker":"Speaker 0","start":30.12,"end":32.22,"text":"Qarshilik qilish esa oʻlimni anglatardi.","wordRange":[63,67]},{"id":"s10","speaker":"Speaker 0","start":32.6,"end":34.52,"text":"Yosh Temur ham uning xizmatiga oʻtadi.","wordRange":[68,73]},{"id":"s11","speaker":"Speaker 0","start":34.94,"end":37.52,"text":"Bu majburiyatmi yoki hisob-kitobmi?","wordRange":[74,77]},{"id":"s12","speaker":"Speaker 0","start":37.86,"end":39.64,"text":"Tarixchilar hanuzgacha bahslashadi.","wordRange":[78,80]},{"id":"s13","speaker":"Speaker 0","start":39.96,"end":41.98,"text":"Tez orada u yoʻlini oʻzgartiradi.","wordRange":[81,85]},{"id":"s14","speaker":"Speaker 0","start":42.36,"end":44.22,"text":"Uning yonida Amir Husayn bor edi.","wordRange":[86,91]},{"id":"s15","speaker":"Speaker 0","start":44.62,"end":48.02,"text":"Yirik amir avlodi qudratli, ammo shuhratparast.","wordRange":[92,97]},{"id":"s16","speaker":"Speaker 0","start":48.38,"end":50.04,"text":"Temur uning singlisiga uylangan.","wordRange":[98,101]},{"id":"s17","speaker":"Speaker 0","start":50.36,"end":52.58,"text":"Shu bilan ittifoq-qarindoshlikka aylangan.","wordRange":[102,105]},{"id":"s18","speaker":"Speaker 0","start":52.86,"end":54.08,"text":"Ikkisi birga otlanadi.","wordRange":[106,108]},{"id":"s19","speaker":"Speaker 0","start":54.42,"end":56.78,"text":"Kuchlari kam, lekin ular toʻxtamaydi.","wordRange":[109,113]},{"id":"s20","speaker":"Speaker 0","start":57.14,"end":60.74,"text":"Bir ming uch yuz oltmish uchinchi yil atrofida Tugʻluq Temur vafot etadi.","wordRange":[114,125]},{"id":"s21","speaker":"Speaker 0","start":61.08,"end":63.68,"text":"Uning oʻgʻli Ilyos xoʻja Movarounnahrga qaytadi.","wordRange":[126,131]},{"id":"s22","speaker":"Speaker 0","start":64.12,"end":66.94,"text":"Bir ming uch yuz oltmish beshinchi yil Loy jangi.","wordRange":[132,140]},{"id":"s23","speaker":"Speaker 0","start":67.32,"end":68.96,"text":"Temur bilan Husayn yengiladi.","wordRange":[141,144]},{"id":"s24","speaker":"Speaker 0","start":69.3,"end":72.24,"text":"Bu Temurning kamdan-kam magʻlubiyatlardan biri edi.","wordRange":[145,150]},{"id":"s25","speaker":"Speaker 0","start":72.62,"end":77.44,"text":"Hamma ularning ishi tugadi deb oʻylagan, ammo ikkalasi ham taslim boʻlmadi.","wordRange":[151,161]},{"id":"s26","speaker":"Speaker 0","start":78.12,"end":83.62,"text":"Keyingi yillarda ular mamlakatni qaytarib oldi, lekin gʻalaba doʻstlikni saqlamadi.","wordRange":[162,171]},{"id":"s27","speaker":"Speaker 0","start":84.06,"end":86.22,"text":"Husayn tobora oʻzboshimcha boʻlib bordi.","wordRange":[172,176]},{"id":"s28","speaker":"Speaker 0","start":86.64,"end":89,"text":"U Temurning buyrugʻini ham ado etmay qoʻydi.","wordRange":[177,183]},{"id":"s29","speaker":"Speaker 0","start":89.68,"end":91.7,"text":"Ikki amir oʻrtasida ishonch yoʻqoldi.","wordRange":[184,188]},{"id":"s30","speaker":"Speaker 0","start":92.18,"end":93.76,"text":"Ikkalasi ham bir narsani bilardi.","wordRange":[189,193]},{"id":"s31","speaker":"Speaker 0","start":94.18,"end":96.36,"text":"Bir taxtga ikki hukmdor sigʻmaydi.","wordRange":[194,198]},{"id":"s32","speaker":"Speaker 0","start":96.86,"end":99.1,"text":"Kelishmovchilik ochiq urushga aylanadi.","wordRange":[199,202]},{"id":"s33","speaker":"Speaker 0","start":99.78,"end":106.42,"text":"Bir ming uch yuz yetmishinchi yil Temur Balxni qamal qiladi, Husayn magʻlub boʻladi va oʻldiriladi.","wordRange":[203,217]},{"id":"s34","speaker":"Speaker 0","start":107.18,"end":110.38,"text":"Bir paytlar yelkama-yelka turgan doʻst endi yoʻq edi.","wordRange":[218,225]},{"id":"s35","speaker":"Speaker 0","start":110.92,"end":114.16,"text":"Movarounnahrda Temurga teng keladigan raqib qolmadi.","wordRange":[226,231]},{"id":"s36","speaker":"Speaker 0","start":114.98,"end":119.48,"text":"Doʻstlik tugadi, ammo Temurning katta yoʻli endi boshlanayotgan edi.","wordRange":[232,240]},{"id":"s37","speaker":"Speaker 0","start":119.98,"end":122.84,"text":"Shu yili Balxda u hukmdor deb eʼlon qilinadi.","wordRange":[241,248]},{"id":"s38","speaker":"Speaker 0","start":123.62,"end":125.2,"text":"Lekin bitta toʻsiq bor edi.","wordRange":[249,253]},{"id":"s39","speaker":"Speaker 0","start":125.7,"end":128.96,"text":"U Chingiz avlodi emas, demak, xon boʻla olmaydi.","wordRange":[254,261]},{"id":"s40","speaker":"Speaker 0","start":129.78,"end":132.62,"text":"Xon boʻlmagan odam qanday qilib butun yurtni boshqardi?","wordRange":[262,269]},{"id":"s41","speaker":"Speaker 0","start":133.16,"end":133.94,"text":"Keyingi qismda","wordRange":[270,271]}],"model":"elevenlabs-scribe"}