audio/a17d46dc-6def-46b9-84c1-179c25d027df.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.06,"end":2.78,"text":"Tasavvur qil, sen Amir Temurning askarisan.","wordRange":[0,5]},{"id":"s2","speaker":"Speaker 0","start":3.02,"end":3.84,"text":"Faqat bir kun.","wordRange":[6,8]},{"id":"s3","speaker":"Speaker 0","start":4.12,"end":4.88,"text":"Tirik qolasanmi?","wordRange":[9,10]},{"id":"s4","speaker":"Speaker 0","start":5.28,"end":6.52,"text":"Tong, hali qorongʻi.","wordRange":[11,13]},{"id":"s5","speaker":"Speaker 0","start":6.88,"end":8.119,"text":"Nogʻora, karnay.","wordRange":[14,15]},{"id":"s6","speaker":"Speaker 0","start":8.42,"end":9.2,"text":"Sakrab turasan.","wordRange":[16,17]},{"id":"s7","speaker":"Speaker 0","start":9.5,"end":10.54,"text":"Sen yolgʻiz emassan.","wordRange":[18,20]},{"id":"s8","speaker":"Speaker 0","start":10.7,"end":11.74,"text":"Sen o'nlikdasan.","wordRange":[21,22]},{"id":"s9","speaker":"Speaker 0","start":12.02,"end":13.92,"text":"O'nta askar, boshingda o'n boshi.","wordRange":[23,27]},{"id":"s10","speaker":"Speaker 0","start":14.32,"end":18.68,"text":"O'nliklar yuzlikka, yuzliklar minglikka, mingliklar esa tumanga birlashadi.","wordRange":[28,35]},{"id":"s11","speaker":"Speaker 0","start":19.04,"end":20.76,"text":"Bitta tumanda o'n ming askar.","wordRange":[36,40]},{"id":"s12","speaker":"Speaker 0","start":21.12,"end":21.9,"text":"Avval tekshiruv.","wordRange":[41,42]},{"id":"s13","speaker":"Speaker 0","start":22.26,"end":25.88,"text":"Ikki ot, kamon, o'qdon, qilich, bolta, arqon.","wordRange":[43,49]},{"id":"s14","speaker":"Speaker 0","start":26.26,"end":27.68,"text":"Hammasi joyida bo'lishi shart.","wordRange":[50,53]},{"id":"s15","speaker":"Speaker 0","start":28.62,"end":29.06,"text":"Nonushta?","wordRange":[54,54]},{"id":"s16","speaker":"Speaker 0","start":29.48,"end":31.6,"text":"Quritilgan go'sht va qurut, shu xolos.","wordRange":[55,60]},{"id":"s17","speaker":"Speaker 0","start":31.88,"end":32.4,"text":"Keyin yo'l.","wordRange":[61,62]},{"id":"s18","speaker":"Speaker 0","start":32.759,"end":33.68,"text":"Kun bo'yi egarda.","wordRange":[63,65]},{"id":"s19","speaker":"Speaker 0","start":33.96,"end":34.96,"text":"Bitta ot charchadimi?","wordRange":[66,68]},{"id":"s20","speaker":"Speaker 0","start":35.18,"end":36.12,"text":"Ikkinchisiga o'tasan.","wordRange":[69,70]},{"id":"s21","speaker":"Speaker 0","start":36.46,"end":37.74,"text":"Tinch kunlarda ham dam yo'q.","wordRange":[71,75]},{"id":"s22","speaker":"Speaker 0","start":38.08,"end":39.82,"text":"Katta ov aslida jangga mashq.","wordRange":[76,80]},{"id":"s23","speaker":"Speaker 0","start":40.14,"end":43.32,"text":"Minglab chavandozlar halqa bo'lib ovni o'rtaga haydaydi.","wordRange":[81,87]},{"id":"s24","speaker":"Speaker 0","start":43.7,"end":44.44,"text":"Maoshing qancha?","wordRange":[88,89]},{"id":"s25","speaker":"Speaker 0","start":44.82,"end":46.68,"text":"Aytishlaricha, otingning narxicha.","wordRange":[90,92]},{"id":"s26","speaker":"Speaker 0","start":47.04,"end":48.4,"text":"Kechasi sen qora ovulsan.","wordRange":[93,96]},{"id":"s27","speaker":"Speaker 0","start":48.7,"end":50.98,"text":"Uxlab qolsang, butun qo'shin xavf ostida.","wordRange":[97,102]},{"id":"s28","speaker":"Speaker 0","start":51.42,"end":52.1,"text":"Ertaga jang.","wordRange":[103,104]},{"id":"s29","speaker":"Speaker 0","start":52.36,"end":56.64,"text":"Tanla: birinchi, oldingi saf, shon-shuhrat katta, xavf ham katta.","wordRange":[105,113]},{"id":"s30","speaker":"Speaker 0","start":57,"end":58.74,"text":"Ikkinchi, orqadagi kamonchilar.","wordRange":[114,116]},{"id":"s31","speaker":"Speaker 0","start":59.08,"end":59.86,"text":"Sen nima qilarding?","wordRange":[117,119]},{"id":"s32","speaker":"Speaker 0","start":60.1,"end":60.76,"text":"Izohda yoz.","wordRange":[120,121]}],"model":"elevenlabs-scribe"}