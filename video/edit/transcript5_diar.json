ence":1},{"text":"dashtda","start":157.4,"end":157.86,"type":"word","speaker":"speaker_0","confidence":0.997},{"text":"Temurning","start":158.22,"end":158.62,"type":"word","speaker":"speaker_0","confidence":1},{"text":"ortidan","start":158.68,"end":159.04,"type":"word","speaker":"speaker_0","confidence":1},{"text":"borarmidingiz?","start":159.06,"end":159.74,"type":"word","speaker":"speaker_0","confidence":0.98},{"text":"Javobingizni","start":160.12,"end":160.86,"type":"word","speaker":"speaker_0","confidence":0.991},{"text":"izohda","start":160.9,"end":161.22,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"yozing.","start":161.26,"end":161.54,"type":"word","speaker":"speaker_0","confidence":0.978}],"speakers":["speaker_0"],"duration":161.798375,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/0fd15625-f898-4434-b81e-6cc3eafde490.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.12,"end":1,"text":"Tasavvur qiling.","wordRange":[0,1]},{"id":"s2","speaker":"Speaker 0","start":1.84,"end":9.62,"text":"Olti oy, cheksiz dasht, suv yo'q, non yo'q, kechasi esa deyarli qorong'i tushmaydi.","wordRange":[2,14]},{"id":"s3","speaker":"Speaker 0","start":10.18,"end":13.52,"text":"Temur qo'shini To'xtamishni izlab dunyoning chetigacha boradi.","wordRange":[15,21]},{"id":"s4","speaker":"Speaker 0","start":15.14,"end":17,"text":"Ming uch yuz to'qson birinchi yil boshi.","wordRange":[22,28]},{"id":"s5","speaker":"Speaker 0","start":17.46,"end":20.4,"text":"Temur yurishga otlanganda To'xtamishtan elchilar keladi.","wordRange":[29,34]},{"id":"s6","speaker":"Speaker 0","start":20.82,"end":23.54,"text":"Ular to'qqizta ot va bitta lochin olib kelgan.","wordRange":[35,42]},{"id":"s7","speaker":"Speaker 0","start":23.92,"end":26.98,"text":"To'xtamish kechirim so'raydi: \"Temur menga otadek edi.","wordRange":[43,49]},{"id":"s8","speaker":"Speaker 0","start":27.4,"end":30.06,"text":"Bu ishlarni mendan bexabar yomon odamlar qildi\".","wordRange":[50,56]},{"id":"s9","speaker":"Speaker 0","start":30.54,"end":35.14,"text":"Temur javob beradi: \"Uni yarador holda olib kelishganda o'g'limdek qabul qildim.","wordRange":[57,67]},{"id":"s10","speaker":"Speaker 0","start":35.62,"end":37.38,"text":"Endi unga ishonib bo'lmaydi\".","wordRange":[68,71]},{"id":"s11","speaker":"Speaker 0","start":38.46,"end":39.66,"text":"Qo'shin dashtga kiradi.","wordRange":[72,74]},{"id":"s12","speaker":"Speaker 0","start":40.1,"end":41.48,"text":"Uch hafta suvsiz yurish.","wordRange":[75,78]},{"id":"s13","speaker":"Speaker 0","start":41.86,"end":43.14,"text":"Otlar holdan toyadi.","wordRange":[79,81]},{"id":"s14","speaker":"Speaker 0","start":43.6,"end":45.3,"text":"Keyin ochlik boshlanadi.","wordRange":[82,84]},{"id":"s15","speaker":"Speaker 0","start":45.78,"end":48.96,"text":"Bitta qo'chqor kallasining narxi besh yuz tangaga chiqadi.","wordRange":[85,92]},{"id":"s16","speaker":"Speaker 0","start":49.4,"end":52.8,"text":"Askarlar qush tuxumi va yovvoyi giyohlar bilan kun ko'radi.","wordRange":[93,101]},{"id":"s17","speaker":"Speaker 0","start":53.22,"end":57.56,"text":"Temur katta ov uyushtiradi va qo'shin ov go'shti bilan omon qoladi.","wordRange":[102,112]},{"id":"s18","speaker":"Speaker 0","start":58.02,"end":62.1,"text":"Ulug' tog' degan joyda Temur cho'qqiga chiqib yamyashil dashtga qaraydi.","wordRange":[113,122]},{"id":"s19","speaker":"Speaker 0","start":62.5,"end":64.28,"text":"Askarlarga tosh tashishni buyuradi.","wordRange":[123,126]},{"id":"s20","speaker":"Speaker 0","start":64.64,"end":66.56,"text":"Ular baland tosh minora qurishadi.","wordRange":[127,131]},{"id":"s21","speaker":"Speaker 0","start":66.9,"end":69.46,"text":"Temur deydi: \"Bizdan yodgorlik bo'lsin\".","wordRange":[132,136]},{"id":"s22","speaker":"Speaker 0","start":70.5,"end":73.42,"text":"Ming uch yuz to'qson birinchi yil o'n sakkizinchi iyun.","wordRange":[137,145]},{"id":"s23","speaker":"Speaker 0","start":73.72,"end":76.58,"text":"Qunduzcha degan joyda ikki qo'shin yuzma-yuz keladi.","wordRange":[146,152]},{"id":"s24","speaker":"Speaker 0","start":76.96,"end":78.4,"text":"Dushman qo'shini ko'proq edi.","wordRange":[153,156]},{"id":"s25","speaker":"Speaker 0","start":78.78,"end":84.5,"text":"Temur qo'shinini yetti qismga bo'lib saf tortadi, keyin hammaga otdan tushib chodir tikishni buyuradi.","wordRange":[157,170]},{"id":"s26","speaker":"Speaker 0","start":84.82,"end":87.54,"text":"To'xtamish hayron qoladi: \"Ular bizdan qo'rqmaydimi?\"","wordRange":[171,176]},{"id":"s27","speaker":"Speaker 0","start":88.08,"end":88.88,"text":"Jang boshlanadi.","wordRange":[177,178]},{"id":"s28","speaker":"Speaker 0","start":89.16,"end":99.62,"text":"To'xtamish oldindan yenga olmay, aylanib o'tib Temur qo'shinining orqasiga chiqadi, lekin Temurning o'zi unga qarab otlanganini ko'rgach, chiday olmaydi va jang maydonini tashlab qochadi.","wordRange":[179,202]},{"id":"s29","speaker":"Speaker 0","start":99.94,"end":104.16,"text":"Temur askarlari qochganlarni Itil, ya'ni Volga daryosigacha quvib boradi.","wordRange":[203,211]},{"id":"s30","speaker":"Speaker 0","start":104.48,"end":106.92,"text":"Oldinda keng daryo, orqada qilich.","wordRange":[212,216]},{"id":"s31","speaker":"Speaker 0","start":107.32,"end":111.06,"text":"Jo'chi ulusi tarqalib ketadi, lekin To'xtamish tirik qoldi.","wordRange":[217,224]},{"id":"s32","speaker":"Speaker 0","start":111.62,"end":114.34,"text":"Uch yil o'tib u yana Kavkazga bostirib kiradi.","wordRange":[225,232]},{"id":"s33","speaker":"Speaker 0","start":115.18,"end":116.76,"text":"Ming uch yuz to'qson beshinchi yil.","wordRange":[233,238]},{"id":"s34","speaker":"Speaker 0","start":117.38,"end":119.74,"text":"Terek daryosi bo'yida ular yana to'qnashadi.","wordRange":[239,244]},{"id":"s35","speaker":"Speaker 0","start":120.38,"end":124.24,"text":"To'xtamish yana yengiladi va taxtidan butunlay ayriladi.","wordRange":[245,251]},{"id":"s36","speaker":"Speaker 0","start":125.02,"end":128.56,"text":"Oltin O'rda bu zarbadan hech qachon o'ziga kela olmadi.","wordRange":[252,260]},{"id":"s37","speaker":"Speaker 0","start":129.84,"end":135.74,"text":"Temur o'z qo'li bilan qutqargan odam o'sha Temurning qo'lida saltanatini yo'qotdi.","wordRange":[261,271]},{"id":"s38","speaker":"Speaker 0","start":139.12,"end":142.02,"text":"To'xtamish hayron qoladi: \"Ular bizdan cho'chimaydimi?\"","wordRange":[272,277]},{"id":"s39","speaker":"Speaker 0","start":142.48,"end":144.76,"text":"Shimoldagi eng xavfli dushman yengildi.","wordRange":[278,282]},{"id":"s40","speaker":"Speaker 0","start":145.36,"end":149.22,"text":"Endi Temurning ko'zi janubga Eron va Hindistonga tushadi.","wordRange":[283,290]},{"id":"s41","speaker":"Speaker 0","start":149.74,"end":152.28,"text":"Hindistonda uni jangovor fillar kutardi.","wordRange":[291,295]},{"id":"s42","speaker":"Speaker 0","start":152.78,"end":153.88,"text":"Bu jang qanday tugadi?","wordRange":[296,299]},{"id":"s43","speaker":"Speaker 0","start":154.34,"end":155.08,"text":"Keyingi qismda.","wordRange":[300,301]},{"id":"s44","speaker":"Speaker 0","start":155.58,"end":159.74,"text":"Siz-chi, olti oy suvsiz dashtda Temurning ortidan borarmidingiz?","wordRange":[302,309]},{"id":"s45","speaker":"Speaker 0","start":160.12,"end":161.54,"text":"Javobingizni izohda yozing.","wordRange":[310,312]}],"model":"elevenlabs-scribe"}