art":57.66,"end":57.9,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"tanlaysan?","start":57.94,"end":58.44,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"Izohda","start":58.72,"end":59.06,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"yoz:","start":59.1,"end":59.32,"type":"word","speaker":"speaker_0","confidence":1},{"text":"bir,","start":59.58,"end":59.78,"type":"word","speaker":"speaker_0","confidence":0.965},{"text":"ikki","start":60.12,"end":60.54,"type":"word","speaker":"speaker_0","confidence":1},{"text":"yoki","start":60.6,"end":60.94,"type":"word","speaker":"speaker_0","confidence":0.997},{"text":"uch.","start":61.04,"end":61.26,"type":"word","speaker":"speaker_0","confidence":0.948}],"speakers":["speaker_0"],"duration":61.466125,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/4ea79735-372d-4f8f-8a2c-685f4da6833f.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.06,"end":4.16,"text":"Tasavvur qil, sen Amir Temurga bugungi qurollarning chizmasini olib bording.","wordRange":[0,9]},{"id":"s2","speaker":"Speaker 0","start":4.5,"end":6.3,"text":"Avtomat, tank, samolyot.","wordRange":[10,12]},{"id":"s3","speaker":"Speaker 0","start":6.74,"end":8.34,"text":"Dunyo xaritasi qanday o'zgaradi?","wordRange":[13,16]},{"id":"s4","speaker":"Speaker 0","start":8.72,"end":11.94,"text":"Temur chizmani ko'radi va ustalarga buyuradi: \"Yasanglar!\"","wordRange":[17,23]},{"id":"s5","speaker":"Speaker 0","start":12.34,"end":13.48,"text":"Lekin muammo bor.","wordRange":[24,26]},{"id":"s6","speaker":"Speaker 0","start":13.94,"end":16.02,"text":"Avtomatga kuchli porox va patron kerak.","wordRange":[27,32]},{"id":"s7","speaker":"Speaker 0","start":16.34,"end":16.84,"text":"Ular yo'q.","wordRange":[33,34]},{"id":"s8","speaker":"Speaker 0","start":17.26,"end":18.94,"text":"Tankka motor va benzin kerak.","wordRange":[35,39]},{"id":"s9","speaker":"Speaker 0","start":19.22,"end":19.86,"text":"Ular ham yo'q.","wordRange":[40,42]},{"id":"s10","speaker":"Speaker 0","start":20.26,"end":21.84,"text":"Samolyot esa umuman orzu.","wordRange":[43,46]},{"id":"s11","speaker":"Speaker 0","start":22.86,"end":23.78,"text":"Hammasi bekormi?","wordRange":[47,48]},{"id":"s12","speaker":"Speaker 0","start":24.22,"end":24.58,"text":"Yo'q!","wordRange":[49,49]},{"id":"s13","speaker":"Speaker 0","start":24.92,"end":26.38,"text":"Porox o'sha zamonda bor edi.","wordRange":[50,54]},{"id":"s14","speaker":"Speaker 0","start":26.7,"end":29.2,"text":"Demak, kuchli top va miltiq yasasa bo'ladi.","wordRange":[55,61]},{"id":"s15","speaker":"Speaker 0","start":29.54,"end":30.68,"text":"Temir raketalar ham.","wordRange":[62,64]},{"id":"s16","speaker":"Speaker 0","start":31,"end":32.38,"text":"Samolyot o'rniga havo shari.","wordRange":[65,68]},{"id":"s17","speaker":"Speaker 0","start":32.619,"end":34.08,"text":"Dushmanni osmondan ko'rasan.","wordRange":[69,71]},{"id":"s18","speaker":"Speaker 0","start":34.38,"end":36.82,"text":"Tank o'rniga temir aravalar va durbin.","wordRange":[72,77]},{"id":"s19","speaker":"Speaker 0","start":37.04,"end":39.5,"text":"Dushman seni ko'rmaydi, sen esa uni ko'rasan.","wordRange":[78,84]},{"id":"s20","speaker":"Speaker 0","start":39.9,"end":40.8,"text":"Endi xaritaga qara.","wordRange":[85,87]},{"id":"s21","speaker":"Speaker 0","start":41.22,"end":43.82,"text":"Temur bu qurollarsiz ham mana shuncha yerni olgan.","wordRange":[88,95]},{"id":"s22","speaker":"Speaker 0","start":44.2,"end":46.5,"text":"Bugungi xaritada bu o'ndan ortiq davlat.","wordRange":[96,101]},{"id":"s23","speaker":"Speaker 0","start":46.78,"end":48.36,"text":"Qo'lida top va miltiq bo'lsa-chi?","wordRange":[102,106]},{"id":"s24","speaker":"Speaker 0","start":48.76,"end":49.6,"text":"Uchta variant bor.","wordRange":[107,109]},{"id":"s25","speaker":"Speaker 0","start":49.92,"end":51.92,"text":"Birinchi, Hindiston va Misrgacha.","wordRange":[110,113]},{"id":"s26","speaker":"Speaker 0","start":52.34,"end":54.94,"text":"Ikkinchi, butun Osiyo, Xitoy bilan birga.","wordRange":[114,119]},{"id":"s27","speaker":"Speaker 0","start":55.34,"end":56.84,"text":"Uchinchi, Yevrogacha.","wordRange":[120,121]},{"id":"s28","speaker":"Speaker 0","start":57.18,"end":58.44,"text":"Sen qaysi birini tanlaysan?","wordRange":[122,125]},{"id":"s29","speaker":"Speaker 0","start":58.72,"end":61.26,"text":"Izohda yoz: bir, ikki yoki uch.","wordRange":[126,131]}],"model":"elevenlabs-scribe"}