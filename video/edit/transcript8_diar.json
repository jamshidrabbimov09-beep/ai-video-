d","speaker":"speaker_0","confidence":0.982},{"text":"oldiga","start":112.28,"end":112.56,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"olib","start":112.64,"end":112.8,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"keladi.","start":112.84,"end":113.16,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"Lekin","start":113.7,"end":114.06,"type":"word","speaker":"speaker_0","confidence":1},{"text":"Boyazid","start":114.42,"end":114.92,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"bir","start":115.18,"end":115.32,"type":"word","speaker":"speaker_0","confidence":1},{"text":"necha","start":115.38,"end":115.64,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"oydan","start":115.72,"end":116.02,"type":"word","speaker":"speaker_0","confidence":1},{"text":"keyin","start":116.08,"end":116.56,"type":"word","speaker":"speaker_0","confidence":0.879},{"text":"asirlikda","start":116.66,"end":117.24,"type":"word","speaker":"speaker_0","confidence":1},{"text":"vafot","start":117.3,"end":117.64,"type":"word","speaker":"speaker_0","confidence":1},{"text":"etdi.","start":117.7,"end":117.96,"type":"word","speaker":"speaker_0","confidence":0.986},{"text":"Ertaga","start":118.8,"end":119.6,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"uzoq","start":119.68,"end":120,"type":"word","speaker":"speaker_0","confidence":0.998},{"text":"Ispaniyadan","start":120.08,"end":120.76,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"bir","start":120.82,"end":120.98,"type":"word","speaker":"speaker_0","confidence":1},{"text":"elchi","start":121.1,"end":121.52,"type":"word","speaker":"speaker_0","confidence":0.964},{"text":"Samarqandga","start":121.6,"end":122.18,"type":"word","speaker":"speaker_0","confidence":1},{"text":"yetib","start":122.22,"end":122.44,"type":"word","speaker":"speaker_0","confidence":1},{"text":"keladi.","start":122.46,"end":122.78,"type":"word","speaker":"speaker_0","confidence":1},{"text":"U","start":123.44,"end":123.68,"type":"word","speaker":"speaker_0","confidence":0.837},{"text":"Temurni","start":123.74,"end":124.26,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"o'z","start":124.32,"end":124.5,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"ko'zi","start":124.54,"end":124.74,"type":"word","speaker":"speaker_0","confidence":1},{"text":"bilan","start":124.76,"end":124.98,"type":"word","speaker":"speaker_0","confidence":1},{"text":"ko'radi.","start":125.02,"end":125.34,"type":"word","speaker":"speaker_0","confidence":0.959},{"text":"Sizchi","start":125.86,"end":126.24,"type":"word","speaker":"speaker_0","confidence":0.972},{"text":"Temurning","start":126.86,"end":127.3,"type":"word","speaker":"speaker_0","confidence":1},{"text":"o'rnida","start":127.36,"end":127.92,"type":"word","speaker":"speaker_0","confidence":0.988},{"text":"Boyazidni","start":127.96,"end":128.44,"type":"word","speaker":"speaker_0","confidence":0.983},{"text":"kechirarmidingiz?","start":128.479,"end":129.32,"type":"word","speaker":"speaker_0","confidence":0.876},{"text":"Ha","start":129.919,"end":130.12,"type":"word","speaker":"speaker_0","confidence":0.996},{"text":"yoki","start":130.18,"end":130.46,"type":"word","speaker":"speaker_0","confidence":1},{"text":"yo'q","start":130.52,"end":130.74,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"izohda","start":131.1,"end":131.42,"type":"word","speaker":"speaker_0","confidence":0.988},{"text":"yozing.","start":131.46,"end":131.78,"type":"word","speaker":"speaker_0","confidence":0.918}],"speakers":["speaker_0"],"duration":131.970625,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/6fe9bf3e-d114-4431-9079-d854988dc533.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.14,"end":7.3,"text":"ming to'rt yuz ikkinchi yil iyul kechqurun Temurning chodiriga qo'llari bog'langan bir odamni olib kirishadi.","wordRange":[0,14]},{"id":"s2","speaker":"Speaker 0","start":8.039,"end":13.56,"text":"Bu usmonli sultoni Boyazid laqabi Yildirim, ya'ni chaqmoq.","wordRange":[15,22]},{"id":"s3","speaker":"Speaker 0","start":14.06,"end":16.32,"text":"Endi Temur uni nima qiladi?","wordRange":[23,27]},{"id":"s4","speaker":"Speaker 0","start":17.76,"end":20.66,"text":"Oldingi qismda Temur Hindistondan fillar bilan qaytdi.","wordRange":[28,34]},{"id":"s5","speaker":"Speaker 0","start":21.08,"end":23.38,"text":"Endi g'arbda Boyazid kuchayib borardi.","wordRange":[35,39]},{"id":"s6","speaker":"Speaker 0","start":23.78,"end":25.06,"text":"Temur unga maktub yozadi.","wordRange":[40,43]},{"id":"s7","speaker":"Speaker 0","start":25.42,"end":28.74,"text":"Chegaringdan oshma Boyazid kibr bilan javob qaytaradi.","wordRange":[44,50]},{"id":"s8","speaker":"Speaker 0","start":29.08,"end":31.84,"text":"Agar u kelmasa, men o'zim Tabriz gacha boraman.","wordRange":[51,58]},{"id":"s9","speaker":"Speaker 0","start":32.259,"end":37.18,"text":"Temurning amrlari Anadoluga yurishga ikkilanardi, lekin Temur baribir yo'lga chiqadi.","wordRange":[59,68]},{"id":"s10","speaker":"Speaker 0","start":37.54,"end":41.22,"text":"Boyazid katta qo'shin bilan o'rmonli tor yo'llarda uni kutib turardi.","wordRange":[69,78]},{"id":"s11","speaker":"Speaker 0","start":41.58,"end":43.28,"text":"Temur esa u yerga bormaydi.","wordRange":[79,83]},{"id":"s12","speaker":"Speaker 0","start":43.68,"end":46.1,"text":"U aylanib o'tib, to'g'ri Anqaraga yuradi.","wordRange":[84,89]},{"id":"s13","speaker":"Speaker 0","start":46.5,"end":47.08,"text":"Temur deydi.","wordRange":[90,91]},{"id":"s14","speaker":"Speaker 0","start":47.48,"end":49.02,"text":"Uning askarlari ko'pi piyoda.","wordRange":[92,95]},{"id":"s15","speaker":"Speaker 0","start":49.44,"end":51.62,"text":"Ortimizdan yetib kelguncha holdan toyadi.","wordRange":[96,100]},{"id":"s16","speaker":"Speaker 0","start":51.98,"end":54.18,"text":"Qo'shin yo'l yo'lakay quduq qazib boradi.","wordRange":[101,106]},{"id":"s17","speaker":"Speaker 0","start":54.58,"end":56.74,"text":"Ankara yonida Temur qarorgoh quradi.","wordRange":[107,111]},{"id":"s18","speaker":"Speaker 0","start":57.16,"end":61.54,"text":"Dushman tomondagi kichik buloqni esa yog'och bilan to'ldirib tashlashni buyuradi.","wordRange":[112,121]},{"id":"s19","speaker":"Speaker 0","start":62.04,"end":65.92,"text":"Jazirama iyul charchagan usmonli qo'shini yetib keladi.","wordRange":[122,128]},{"id":"s20","speaker":"Speaker 0","start":66.38,"end":68.46,"text":"Ertalab ikki qo'shin saf tortadi.","wordRange":[129,133]},{"id":"s21","speaker":"Speaker 0","start":68.78,"end":72.3,"text":"Temur fillariga sovut kiydiradi, ustiga kamonchilarni o'tkazadi.","wordRange":[134,140]},{"id":"s22","speaker":"Speaker 0","start":72.64,"end":77.08,"text":"Boyazid tomonida boshdan oyoq qora temir sovutdagi yevropalik otliqlar turardi.","wordRange":[141,150]},{"id":"s23","speaker":"Speaker 0","start":77.42,"end":79.22,"text":"Ulardan faqat ko'zlari ko'rinardi.","wordRange":[151,154]},{"id":"s24","speaker":"Speaker 0","start":79.68,"end":83.08,"text":"Ular qattiq turadi, lekin oxiri ular ham chekinadi.","wordRange":[155,162]},{"id":"s25","speaker":"Speaker 0","start":83.44,"end":84.98,"text":"Boyazid tepalikka chiqib qaraydi.","wordRange":[163,166]},{"id":"s26","speaker":"Speaker 0","start":85.22,"end":86.58,"text":"Qo'shini tarqalib ketgan edi.","wordRange":[167,170]},{"id":"s27","speaker":"Speaker 0","start":86.92,"end":89.84,"text":"U kechgacha jang qiladi, keyin qurshovni yorib qochadi.","wordRange":[171,178]},{"id":"s28","speaker":"Speaker 0","start":90.12,"end":92.66,"text":"Temurning bahodirlardan biri uni quvib yetadi.","wordRange":[179,184]},{"id":"s29","speaker":"Speaker 0","start":93.02,"end":93.78,"text":"Temur buyuradi.","wordRange":[185,186]},{"id":"s30","speaker":"Speaker 0","start":94.12,"end":96.28,"text":"Qo'llarini yeching, hurmat bilan olib kiring.","wordRange":[187,192]},{"id":"s31","speaker":"Speaker 0","start":96.62,"end":97.84,"text":"Uni ro'parasiga o'tkazadi.","wordRange":[193,195]},{"id":"s32","speaker":"Speaker 0","start":98.28,"end":99.92,"text":"Seni necha marta ogohlantirdim.","wordRange":[196,199]},{"id":"s33","speaker":"Speaker 0","start":100.22,"end":102.94,"text":"Quloq solmading, lekin menga g'alaba berildi.","wordRange":[200,205]},{"id":"s34","speaker":"Speaker 0","start":103.34,"end":105.82,"text":"Senga yaxshilikdan boshqa hech narsa qilmayman.","wordRange":[206,211]},{"id":"s35","speaker":"Speaker 0","start":106.22,"end":107.98,"text":"Boyazid xatosini tan oladi.","wordRange":[212,215]},{"id":"s36","speaker":"Speaker 0","start":108.38,"end":113.16,"text":"Temur unga shohona to'n kiydiradi va yo'qolgan o'g'lini topib oldiga olib keladi.","wordRange":[216,227]},{"id":"s37","speaker":"Speaker 0","start":113.7,"end":117.96,"text":"Lekin Boyazid bir necha oydan keyin asirlikda vafot etdi.","wordRange":[228,236]},{"id":"s38","speaker":"Speaker 0","start":118.8,"end":122.78,"text":"Ertaga uzoq Ispaniyadan bir elchi Samarqandga yetib keladi.","wordRange":[237,244]},{"id":"s39","speaker":"Speaker 0","start":123.44,"end":125.34,"text":"U Temurni o'z ko'zi bilan ko'radi.","wordRange":[245,250]},{"id":"s40","speaker":"Speaker 0","start":125.86,"end":129.32,"text":"Sizchi Temurning o'rnida Boyazidni kechirarmidingiz?","wordRange":[251,255]},{"id":"s41","speaker":"Speaker 0","start":129.919,"end":131.78,"text":"Ha yoki yo'q izohda yozing.","wordRange":[256,260]}],"model":"elevenlabs-scribe"}