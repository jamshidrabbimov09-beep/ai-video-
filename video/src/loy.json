{"fps": 30, "end": 75.139, "estimated": true, "sents": [{"id": "s1", "t0": 0.5, "t1": 4.572, "text": "1365-yil. Amir Temurning kamdan-kam mag'lubiyatlaridan biri: Loy jangi."}, {"id": "s2", "t0": 5.172, "t1": 8.385, "text": "Unga nima sabab bo'ldi: yomg'irmi yoki o'z ittifoqchisimi?"}, {"id": "s3", "t0": 8.985, "t1": 13.496, "text": "Bahor. Mo'g'uliston xoni Ilyosxo'ja qo'shin bilan yana Movarounnahrga bostirib keladi."}, {"id": "s4", "t0": 14.096, "t1": 19.397, "text": "Temur va Amir Husayn unga qarshi chiqadi. Ikki qo'shin Chinoz bilan Toshkent oralig'ida to'qnashadi."}, {"id": "s5", "t0": 19.997, "t1": 22.342, "text": "O'ng qanotda Husayn. Chap qanotda Temur."}, {"id": "s6", "t0": 22.942, "t1": 28.167, "text": "Jang boshlanishi bilan kuchli jala quyadi. Maydon loyga aylanadi, otlar joyidan qimirlay olmaydi."}, {"id": "s7", "t0": 28.767, "t1": 32.3, "text": "Rivoyatga ko'ra, dushman yomg'irni sehrli yada toshi bilan chaqirgan."}, {"id": "s8", "t0": 32.9, "t1": 37.558, "text": "Shunga qaramay, Temur chap qanotda dushmanni yorib o'tadi. Ilyosxo'ja qocha boshlaydi."}, {"id": "s9", "t0": 38.158, "t1": 40.332, "text": "Ammo o'ng qanotda Husaynning safi buziladi."}, {"id": "s10", "t0": 40.932, "t1": 44.713, "text": "Temur o'n yetti qo'shun bilan yordamga tashlanadi va dushmanni chekintiradi."}, {"id": "s11", "t0": 45.313, "t1": 52.965, "text": "U Husaynga ikki marta chopar yuboradi: birga hujum qilaylik. Yazdiyning yozishicha, Husayn choparlarni urib haydaydi va joyidan qimirlamaydi."}, {"id": "s12", "t0": 53.565, "t1": 57.703, "text": "Fursat boy beriladi. Dushman bayroq ostida qayta to'planib, hujumga o'tadi."}, {"id": "s13", "t0": 58.303, "t1": 64.604, "text": "Temur va Husayn qo'shini chekinadi. Ko'p askar loyda qolib ketadi. Yazdiy o'n ming kishi halok bo'lganini yozadi."}, {"id": "s14", "t0": 65.204, "t1": 70.939, "text": "Shu kundan ikki do'st o'rtasida ishonch yo'qoladi. Besh yildan keyin ular Balxda dushman sifatida uchrashadi."}], "subs": [{"t0": 0.46, "t1": 1.177, "text": "1365-yil."}, {"t0": 1.237, "t1": 2.446, "text": "Amir Temurning kamdan-kam"}, {"t0": 2.496, "t1": 3.905, "text": "mag'lubiyatlaridan biri:"}, {"t0": 3.965, "t1": 4.772, "text": "Loy jangi."}, {"t0": 5.132, "t1": 6.592, "text": "Unga nima sabab bo'ldi:"}, {"t0": 6.652, "t1": 8.585, "text": "yomg'irmi yoki o'z ittifoqchisimi?"}, {"t0": 8.945, "t1": 9.533, "text": "Bahor."}, {"t0": 9.593, "t1": 10.931, "text": "Mo'g'uliston xoni Ilyosxo'ja"}, {"t0": 10.981, "t1": 12.581, "text": "qo'shin bilan yana Movarounnahrga"}, {"t0": 12.631, "t1": 13.696, "text": "bostirib keladi."}, {"t0": 14.056, "t1": 15.359, "text": "Temur va Amir Husayn unga"}, {"t0": 15.409, "t1": 16.431, "text": "qarshi chiqadi."}, {"t0": 16.491, "t1": 17.747, "text": "Ikki qo'shin Chinoz bilan"}, {"t0": 17.797, "t1": 19.597, "text": "Toshkent oralig'ida to'qnashadi."}, {"t0": 19.957, "t1": 21.241, "text": "O'ng qanotda Husayn."}, {"t0": 21.301, "t1": 22.542, "text": "Chap qanotda Temur."}, {"t0": 22.902, "t1": 23.982, "text": "Jang boshlanishi bilan"}, {"t0": 24.032, "t1": 25.273, "text": "kuchli jala quyadi."}, {"t0": 25.333, "t1": 26.513, "text": "Maydon loyga aylanadi,"}, {"t0": 26.563, "t1": 28.367, "text": "otlar joyidan qimirlay olmaydi."}, {"t0": 28.727, "t1": 29.993, "text": "Rivoyatga ko'ra, dushman"}, {"t0": 30.043, "t1": 31.385, "text": "yomg'irni sehrli yada toshi"}, {"t0": 31.435, "t1": 32.5, "text": "bilan chaqirgan."}, {"t0": 32.86, "t1": 34.259, "text": "Shunga qaramay, Temur chap"}, {"t0": 34.309, "t1": 36.113, "text": "qanotda dushmanni yorib o'tadi."}, {"t0": 36.173, "t1": 37.758, "text": "Ilyosxo'ja qocha boshlaydi."}, {"t0": 38.118, "t1": 39.503, "text": "Ammo o'ng qanotda Husaynning"}, {"t0": 39.553, "t1": 40.532, "text": "safi buziladi."}, {"t0": 40.892, "t1": 42.062, "text": "Temur o'n yetti qo'shun"}, {"t0": 42.112, "t1": 43.321, "text": "bilan yordamga tashlanadi"}, {"t0": 43.371, "t1": 44.913, "text": "va dushmanni chekintiradi."}, {"t0": 45.273, "t1": 47.472, "te