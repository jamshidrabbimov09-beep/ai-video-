{"fps": 30, "end": 80.72, "estimated": false, "sents": [{"id": "s1", "t0": 0.12, "t1": 6.94, "text": "1365-yil. Amir Temurning kamdan-kam mag'lubiyatlaridan biri: Loy jangi."}, {"id": "s2", "t0": 7.64, "t1": 11.72, "text": "Unga nima sabab bo'ldi: yomg'irmi yoki o'z ittifoqchisimi?"}, {"id": "s3", "t0": 12.92, "t1": 18.24, "text": "Bahor. Mo'g'uliston xoni Ilyosxo'ja qo'shin bilan yana Movarounnahrga bostirib keladi."}, {"id": "s4", "t0": 18.7, "t1": 24.26, "text": "Temur va Amir Husayn unga qarshi chiqadi. Ikki qo'shin Chinoz bilan Toshkent oralig'ida to'qnashadi."}, {"id": "s5", "t0": 24.64, "t1": 27.36, "text": "O'ng qanotda Husayn. Chap qanotda Temur."}, {"id": "s6", "t0": 27.8, "t1": 33.64, "text": "Jang boshlanishi bilan kuchli jala quyadi. Maydon loyga aylanadi, otlar joyidan qimirlay olmaydi."}, {"id": "s7", "t0": 34, "t1": 37.74, "text": "Rivoyatga ko'ra, dushman yomg'irni sehrli yada toshi bilan chaqirgan."}, {"id": "s8", "t0": 38.06, "t1": 42.9, "text": "Shunga qaramay, Temur chap qanotda dushmanni yorib o'tadi. Ilyosxo'ja qocha boshlaydi."}, {"id": "s9", "t0": 43.24, "t1": 45.7, "text": "Ammo o'ng qanotda Husaynning safi buziladi."}, {"id": "s10", "t0": 46, "t1": 49.96, "text": "Temur o'n yetti qo'shun bilan yordamga tashlanadi va dushmanni chekintiradi."}, {"id": "s11", "t0": 50.28, "t1": 58.66, "text": "U Husaynga ikki marta chopar yuboradi: birga hujum qilaylik. Yazdiyning yozishicha, Husayn choparlarni urib haydaydi va joyidan qimirlamaydi."}, {"id": "s12", "t0": 59.02, "t1": 63.34, "text": "Fursat boy beriladi. Dushman bayroq ostida qayta to'planib, hujumga o'tadi."}, {"id": "s13", "t0": 63.6, "t1": 70.1, "text": "Temur va Husayn qo'shini chekinadi. Ko'p askar loyda qolib ketadi. Yazdiy o'n ming kishi halok bo'lganini yozadi."}, {"id": "s14", "t0": 70.44, "t1": 76.72, "text": "Shu kundan ikki do'st o'rtasida ishonch yo'qoladi. Besh yildan keyin ular Balxda dushman sifatida uchrashadi."}], "subs": [{"t0": 0.08, "t1": 2.1, "text": "1365-yil."}, {"t0": 3.14, "t1": 4.63, "text": "Amir Temurning kamdan-kam"}, {"t0": 4.68, "t1": 6.02, "text": "mag'lubiyatlaridan biri:"}, {"t0": 6.28, "t1": 7.14, "text": "Loy jangi."}, {"t0": 7.6, "t1": 9.12, "text": "Unga nima sabab bo'ldi:"}, {"t0": 9.38, "t1": 11.92, "text": "yomg'irmi yoki o'z ittifoqchisimi?"}, {"t0": 12.88, "t1": 13.52, "text": "Bahor."}, {"t0": 13.86, "t1": 15.55, "text": "Mo'g'uliston xoni Ilyosxo'ja"}, {"t0": 15.6, "t1": 17.39, "text": "qo'shin bilan yana Movarounnahrga"}, {"t0": 17.44, "t1": 18.44, "text": "bostirib keladi."}, {"t0": 18.66, "t1": 20.15, "text": "Temur va Amir Husayn unga"}, {"t0": 20.2, "t1": 21.1, "text": "qarshi chiqadi."}, {"t0": 21.22, "t1": 22.65, "text": "Ikki qo'shin Chinoz bilan"}, {"t0": 22.7, "t1": 24.46, "text": "Toshkent oralig'ida to'qnashadi."}, {"t0": 24.6, "t1": 25.92, "text": "O'ng qanotda Husayn."}, {"t0": 26.04, "t1": 27.56, "text": "Chap qanotda Temur."}, {"t0": 27.76, "t1": 28.73, "text": "Jang boshlanishi bilan"}, {"t0": 28.78, "t1": 30.06, "text": "kuchli jala quyadi."}, {"t0": 30.18, "t1": 31.68, "text": "Maydon loyga aylanadi,"}, {"t0": 31.82, "t1": 33.84, "text": "otlar joyidan qimirlay olmaydi."}, {"t0": 33.96, "t1": 35.25, "text": "Rivoyatga ko'ra, dushman"}, {"t0": 35.3, "t1": 36.93, "text": "yomg'irni sehrli yada toshi"}, {"t0": 36.98, "t1": 37.94, "text": "bilan chaqirgan."}, {"t0": 38.02, "t1": 39.43, "text": "Shunga qaramay, Temur chap"}, {"t0": 39.48, "t1": 41.24, "text": "qanotda dushmanni yorib o'tadi."}, {"t0": 41.34, "t1": 43.1, "text": "Ilyosxo'ja qocha boshlaydi."}, {"t0": 43.2, "t1": 44.89, "text": "Ammo o'ng qanotda Husaynning"}, {"t0": 44.94, "t1": 45.9, "text": "safi buziladi."}, {"t0": 45.96, "t1": 47.15, "text": "Temur o'n yetti qo'shun"}, {"t0": 47.2, "t1": 48.63, "text": "bilan yordamga tashlanadi"}, {"t0": 48.68, "t1": 50.16, "text": "va dushmanni chekintiradi."}, {"t0": 50.24, "t1": 52.54, "text": "U Husaynga ikki marta chopar yuboradi:"}, {"t0": 52.64, "t1": 53.9, "text": "birga hujum qilaylik."}, {"t0": 54.02, "t1": 55.17, "text": "Yazdiyning yozishicha,"}, {"t0": 55.22, "t1": 56.51, "text": "Husayn choparlarni urib"}, {"t0": 56.56, "t1": 58.86, "text": "haydaydi va joyidan qimirlamaydi."}, {"t0": 58.98, "t1": 60.35, "text": "Fursat boy beriladi."}, {"t0": 60.4, "t1": 61.91, "text": "Dushman bayroq ostida qayta"}, {"t0": 61.96, "t1": 63.51, "text": "to'planib, hujumga o'tadi."}, {"t0": 63.56, "t1": 65.56, "text": "Temur va Husayn qo'shini chekinadi."}, {"t0": 65.64, "t1": 67.46, "text": "Ko'p askar loyda qolib ketadi."}, {"t0": 67.64, "t1": 69.17, "text": "Yazdiy o'n ming kishi halok"}, {"t0": 69.22, "t1": 70.3, "text": "bo'lganini yozadi."}, {"t0": 70.4, "t1": 72.19, "text": "Shu kundan ikki do'st o'rtasida"}, {"t0": 72.24, "t1": 73.32, "text": "ishonch yo'qoladi."}, {"t0": 73.46, "t1": 74.73, "text": "Besh yildan keyin ular"}, {"t0": 74.78, "t1": 76.92, "text": "Balxda dushman sifatida uchrashadi."}]}