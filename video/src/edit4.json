": "fade", "grade": "warm"}, {"t0": 89.281, "t1": 92.656, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 92.656, "t1": 95.281, "img": "28", "mv": "panL", "tr": "fade", "grade": "warm"}, {"t0": 95.281, "t1": 98.656, "img": "13", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 98.656, "t1": 101.656, "img": "06", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 101.656, "t1": 104.281, "img": "29", "mv": "in", "tr": "fade", "grade": "cold"}, {"t0": 104.281, "t1": 106.906, "img": "30", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 106.906, "t1": 113.379, "img": "33", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 113.379, "t1": 116.281, "img": "32", "mv": "faceL", "tr": "fade", "grade": "cold"}, {"t0": 116.281, "t1": 120.596, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "title", "t0": 10.581, "t1": 13.381, "text": "AMIR TEMUR"}, {"k": "date", "t0": 14.281, "t1": 18.481, "text": "1363", "sub": "SEISTON", "sub_t": 2.28}, {"k": "name", "t0": 26.551, "t1": 30.751, "text": "TEMUR-I LANG", "sub": "Cho'loq Temur", "sub_t": 2.32}, {"k": "date", "t0": 37.906, "t1": 42.106, "text": "1336", "sub": "KESH", "sub_t": 2.1}, {"k": "date", "t0": 75.406, "t1": 78.206, "text": "1360"}, {"k": "tag", "t0": 54.681, "t1": 66.866, "text": "RIVOYAT"}, {"k": "map", "t0": 66.861, "t1": 71.656, "text": ""}, {"k": "end", "t0": 116.506, "t1": 120.596, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 18.781, "t1": 25.281}, {"k": "bars", "t0": 99.031, "t1": 106.931}, {"k": "bars", "t0": 113.556, "t1": 116.336}, {"k": "sub", "t0": 0.741, "t1": 2.621, "text": "Uni cho'loq deb masxara qilishdi."}, {"k": "sub", "t0": 2.991, "t1": 4.951, "text": "U na xon edi, na Chingiz"}, {"k": "sub", "t0": 4.971, "t1": 7.931, "text": "avlodi, lekin xonlarni taxtga o'tqazdi"}, {"k": "sub", "t0": 7.971, "t1": 9.451, "text": "va taxtdan tushirdi."}, {"k": "sub", "t0": 9.741, "t1": 11.881, "text": "Bu odam Amir Temur va uning"}, {"k": "sub", "t0": 11.901, "t1": 13.841, "text": "laqabi bir o'qdan tug'ilgan."}, {"k": "sub", "t0": 14.241, "t1": 17.621, "text": "1363-yil Seiston dashti,"}, {"k": "sub", "t0": 17.881, "t1": 18.381, "text": "tun."}, {"k": "sub", "t0": 18.741, "t1": 20.741, "text": "Kamondan uchgan o'q yigitning o'ng"}, {"k": "sub", "t0": 20.761, "t1": 22.701, "text": "qo'li va oyog'ini teshib o'tadi."}, {"k": "sub", "t0": 23.241, "t1": 25.201, "text": "U umrbod cho'loq bo'lib qoladi."}, {"k": "sub", "t0": 25.491, "t1": 27.471, "text": "Dushmanlari uni Temur-i Lang deb"}, {"k": "sub", "t0": 27.491, "t1": 29.831, "text": "ataydi, ya'ni Cho'loq Temur."}, {"k": "sub", "t0": 30.366, "t1": 32.466, "text": "Ammo ular bir narsani bilmasdi."}, {"k": "sub", "t0": 32.991, "t1": 35.111, "text": "Bu yigit tiz cho'kishni bilmaydi."}, {"k": "sub", "t0": 35.616, "t1": 37.396, "text": "Keling, boshidan boshlaymiz."}, {"k": "sub", "t0": 37.866, "t1": 40.526, "text": "1336-yil, Kesh."}, {"k": "sub", "t0": 40.866, "t1": 43.186, "text": "Hozirgi Shahrisabz yaqinida Barlos"}, {"k": "sub", "t0": 43.206, "t1": 45.146, "text": "qabilasidan bir o'g'il tug'iladi."}, {"k": "sub", "t0": 45.741, "t1": 48.021, "text": "Otasi Kichik Amir Tarag'ay."}, {"k": "sub", "t0": 48.366, "t1": 50.326, "text": "Aniq sanasi manbalarda har xil."}, {"k": "sub", "t0": 50.616, "t1": 52.076, "text": "Shuning uchun biz bunga ishonch"}, {"k": "sub", "t0": 52.096, "t1": 54.196, "text": "bilan aynan shu kuni demaymiz."}, {"k": "sub", "t0": 54.741, "t1": 56.761, "text": "Bolaligi haqida ko'p rivoyat bor."}, {"k": "sub", "t0": 57.366, "t1": 59.746, "text": "Ularning ko'pi yillar o'tib yozilgan."}, {"k": "sub", "t0": 60.366, "t1": 61.166, "text": "Biri shunday:"}, {"k": "sub", "t0": 61.326, "t1": 63.086, "text": "u yoshligidanoq ot minib,"}, {"k": "sub", "t0": 63.106, "t1": 64.566, "text": "kamon otishni o'rgangan."}, {"k": "sub", "t0": 64.866, "t1": 66.786, "text": "Rivoyat hali tarix emas."}, {"k": "sub", "t0": 67.116, "t1": 69.416, "text": "O'sha davrda Movarounnahr parchalangan"}, {"k": "sub", "t0": 69.436, "t1": 69.936, "text": "edi."}, {"k": "sub", "t0": 70.491, "t1": 71.851, "text": "Mo'g'ul xonlari bir-biri bilan"}, {"k": "sub", "t0": 71.871, "t1": 74.091, "text": "urushar, amirlar esa o'z manfaatini"}, {"k": "sub", "t0": 74.111, "t1": 74.791, "text": "o'ylardi."}, {"k": "sub", "t0": 75.366, "t1": 78.886, "text": "1360-yil Mo'g'ul xoni Tug'luq Temur"}, {"k": "sub", "t0": 78.906, "t1": 80.306, "text": "lashkar bilan kirib keldi."}, {"k": "sub", "t0": 80.616, "t1": 82.696, "text": "Yosh Temur uning xizmatiga o'tdi."}, {"k": "sub", "t0": 83.241, "t1": 85.041, "text": "Buni ba'zilar xiyonat deydi,"}, {"k": "sub", "t0": 85.241, "t1": 86.621, "text": "ba'zilar aql."}, {"k": "sub", "t0": 86.991, "t1": 89.111, "text": "Tez orada u yo'lini o'zgartirdi."}, {"k": "sub", "t0": 89.616, "t1": 91.336, "text": "Do'sti va qaynog'i Amir Husayn"}, {"k": "sub", "t0": 91.356, "t1": 92.676, "text": "bilan ittifoq tuzdi."}, {"k": "sub", "t0": 92.991, "t1": 95.271, "text": "Ikkisi birga dashtlar bo'ylab otlandi."}, {"k": "sub", "t0": 95.616, "t1": 96.736, "text": "Kuchlari kam edi,"}, {"k": "sub", "t0": 96.876, "t1": 98.436, "text": "ammo ular to'xtamadi."}, {"k": "sub", "t0": 98.991, "t1": 101.651, "text": "Shunday yurishlardan birida Seistonda"}, {"k": "sub", "t0": 101.671, "t1": 104.011, "text": "o'sha o'q uni umrbod nogiron qildi,"}, {"k": "sub", "t0": 104.351, "t1": 106.951, "text": "lekin u jang maydonini tark etmadi."}, {"k": "sub", "t0": 107.241, "t1": 109.041, "text": "Hali hech kim uni tanimasdi,"}, {"k": "sub", "t0": 109.281, "t1": 111.541, "text": "ammo bu ittifoq tez orada uning"}, {"k": "sub", "t0": 111.561, "t1": 113.321, "text": "eng katta xavfiga aylanadi."}, {"k": "sub", "t0": 113.616, "t1": 115.456, "text": "Do'st dushmanga aylanganda nima"}, {"k": "sub", "t0": 115.476, "t1": 116.056, "text": "bo'ladi?"}, {"k": "sub", "t0": 116.616, "t1": 117.616, "text": "Keyingi qismda"}]}