"t1": 74.43, "img": "10", "mv": "inslow", "tr": "dip", "grade": "warm"}], "over": [{"k": "hook", "t0": 0.25, "t1": 6.58, "text": "120", "sub": "JANGOVAR FIL"}, {"k": "tag", "t0": 7.12, "t1": 12.96, "text": "6-QISM"}, {"k": "date", "t0": 13.28, "t1": 15.3, "text": "1398"}, {"k": "date", "t0": 26.68, "t1": 28.48, "text": "DEKABR", "sub": "DEHLI", "sub_t": 1.06}, {"k": "date", "t0": 53.82, "t1": 56.02, "text": "17", "sub": "DEKABR", "sub_t": 0.72}, {"k": "q", "t0": 65.94, "t1": 71.23, "pop": 35}, {"k": "subend", "t0": 71.23, "t1": 74.43, "text": "ERTAGA 7-QISM"}, {"k": "bars", "t0": 40.08, "t1": 48.64}, {"k": "bars", "t0": 58.38, "t1": 66.12}, {"k": "sub", "t0": 2.96, "t1": 3.7, "text": "Temurning baʼzi"}, {"k": "sub", "t0": 3.72, "t1": 5.32, "text": "askarlari filni umrida"}, {"k": "sub", "t0": 5.34, "t1": 6.6, "text": "birinchi marta ko'rardi."}, {"k": "sub", "t0": 7.28, "t1": 9.04, "text": "Oldingi qismda Temur To'xtamishni"}, {"k": "sub", "t0": 9.06, "t1": 10.06, "text": "dashtda yengdi."}, {"k": "sub", "t0": 10.22, "t1": 11.64, "text": "Endi u janubga"}, {"k": "sub", "t0": 11.68, "t1": 12.88, "text": "Hindistonga yuradi."}, {"k": "sub", "t0": 15.42, "t1": 16.64, "text": "Afg'oniston tog'larida"}, {"k": "sub", "t0": 16.66, "t1": 17.54, "text": "yozda ham qor"}, {"k": "sub", "t0": 17.56, "t1": 18.94, "text": "shunchalik chuqur ediki,"}, {"k": "sub", "t0": 19.04, "t1": 20.36, "text": "otlar botib qolardi."}, {"k": "sub", "t0": 20.56, "t1": 21.74, "text": "Tik qoyadan Temurni"}, {"k": "sub", "t0": 21.76, "t1": 23.52, "text": "yog'och kajavada arqonlarda"}, {"k": "sub", "t0": 23.54, "t1": 24.62, "text": "pastga tushirishadi."}, {"k": "sub", "t0": 24.96, "t1": 25.92, "text": "Besh marta."}, {"k": "sub", "t0": 28.58, "t1": 29.54, "text": "Sulton Mahmud va"}, {"k": "sub", "t0": 29.56, "t1": 31.52, "text": "Mallu Xon o'n ming otliq,"}, {"k": "sub", "t0": 31.54, "t1": 32.819, "text": "qirq ming piyoda va"}, {"k": "sub", "t0": 32.839, "t1": 34.54, "text": "yuz yigirma fil bilan chiqadi."}, {"k": "sub", "t0": 34.76, "t1": 36.38, "text": "Fillarga sovut kiydirilgan."}, {"k": "sub", "t0": 36.44, "t1": 37.72, "text": "Ustida yog'och supa,"}, {"k": "sub", "t0": 37.8, "t1": 39.8, "text": "supada besh-olti kamonchi."}, {"k": "sub", "t0": 40.04, "t1": 42.1, "text": "Temur olimlaridan so'raydi: Jangda"}, {"k": "sub", "t0": 42.12, "t1": 43.24, "text": "qayerda turasizlar?\""}, {"k": "sub", "t0": 43.46, "t1": 45.16, "text": "Ular titrab aytadi: Bizning"}, {"k": "sub", "t0": 45.18, "t1": 46.94, "text": "joyimiz ayollar yonida.\""}, {"k": "sub", "t0": 47.12, "t1": 48.56, "text": "Temur kulib yuboradi."}, {"k": "sub", "t0": 48.72, "t1": 50.12, "text": "Temur qarorgoh atrofiga"}, {"k": "sub", "t0": 50.14, "t1": 51.26, "text": "xandaq qazdiradi."}, {"k": "sub", "t0": 51.28, "t1": 52.2, "text": "To'siq oldiga"}, {"k": "sub", "t0": 52.22, "t1": 53.6, "text": "buyvollarni bog'latadi."}, {"k": "sub", "t0": 56.18, "t1": 58.08, "text": "Fillar oldinga yura boshlaydi."}, {"k": "sub", "t0": 58.34, "t1": 59.48, "text": "Temur fillarga"}, {"k": "sub", "t0": 59.5, "t1": 60.58, "text": "qarshi nima qildi?"}, {"k": "sub", "t0": 60.8, "t1": 61.82, "text": "Bitta shahzoda"}, {"k": "sub", "t0": 61.84, "t1": 62.84, "text": "filning ro'parasiga"}, {"k": "sub", "t0": 62.86, "t1": 63.92, "text": "qilich bilan chiqdi."}, {"k": "sub", "t0": 64.16, "t1": 65.94, "text": "Ertaga yettinchi qismda."}, {"k": "sub", "t0": 66.1, "t1": 67.68, "text": "Siz-chi, fillarga qarshi"}, {"k": "sub", "t0": 67.7, "t1": 68.98, "text": "oldinga chiqarmidingiz?"}, {"k": "sub", "t0": 69.1, "t1": 71.1, "text": "Ha yoki yo'q izohda yozing."}]}