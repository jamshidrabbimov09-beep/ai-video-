{"fps": 30, "end": 116.92, "shots": [{"t0": 0.0, "t1": 2.72, "img": "01", "mv": "in2", "tr": "dip", "grade": "warm"}, {"t0": 2.72, "t1": 6.28, "img": "03", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 6.28, "t1": 10.55, "img": "10", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 10.55, "t1": 15.0, "img": "02", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 15.0, "t1": 18.53, "img": "05", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 18.53, "t1": 23.02, "img": "06", "mv": "in", "tr": "fade", "grade": "cold"}, {"t0": 23.02, "t1": 28.46, "img": "mo:gather", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 28.46, "t1": 33.059, "img": "04", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 33.059, "t1": 35.96, "img": "11", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 35.96, "t1": 45.01, "img": "mo:tree", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 45.01, "t1": 48.42, "img": "16", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 48.42, "t1": 53.44, "img": "17", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 53.44, "t1": 57.57, "img": "19", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 57.57, "t1": 62.28, "img": "mo:puppet", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 62.28, "t1": 65.7, "img": "22", "mv": "in2", "tr": "dip", "grade": "warm"}, {"t0": 65.7, "t1": 70.68, "img": "23", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 70.68, "t1": 73.27, "img": "25", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 73.27, "t1": 79.93, "img": "mo:koragon", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 79.93, "t1": 85.05, "img": "mo:capital", "mv": "none", "tr": "dip", "grade": "warm"}, {"t0": 85.05, "t1": 87.8, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 87.8, "t1": 91.15, "img": "30", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 91.15, "t1": 95.08, "img": "32", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 95.08, "t1": 99.25, "img": "33", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 99.25, "t1": 102.84, "img": "34", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 102.84, "t1": 105.74, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 105.74, "t1": 110.35, "img": "36", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 110.35, "t1": 113.09, "img": "01", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 113.09, "t1": 116.92, "img": "02", "mv": "inslow", "tr": "fade", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.3, "text": "3-QISM"}, {"k": "date", "t0": 15.24, "t1": 19.24, "text": "1370", "sub": "BAHOR. BALX", "sub_t": 1.78}, {"k": "name", "t0": 51.26, "t1": 54.26, "text": "SUYURG'ATMISH"}, {"k": "name", "t0": 64.04, "t1": 67.04, "text": "SAROYMULKXONIM"}, {"k": "name", "t0": 100.04, "t1": 103.04, "text": "TO'XTAMISH"}, {"k": "end", "t0": 115.17, "t1": 116.92, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 18.9, "t1": 20.46}, {"k": "bars", "t0": 105.92, "t1": 113.32}, {"k": "sub", "t0": 0.36, "t1": 2.18, "text": "U ulkan saltanat qurdi,"}, {"k": "sub", "t0": 2.78, "t1": 4.48, "text": "lekin umrining oxirigacha"}, {"k": "sub", "t0": 4.66, "t1": 6.2, "text": "o'zini xon deb atamadi."}, {"k": "sub", "t0": 6.54, "t1": 7.06, "text": "Nega?"}, {"k": "sub", "t0": 8.18, "t1": 9.08, "text": "Chunki bunga uning"}, {"k": "sub", "t0": 9.1, "t1": 10.1, "text": "haqqi yo'q edi."}, {"k": "sub", "t0": 11.18, "t1": 12.8, "text": "Bu Amir Temur hokimiyatni"}, {"k": "sub", "t0": 12.82, "t1": 13.9, "text": "qanday qo'lga olgani"}, {"k": "sub", "t0": 13.92, "t1": 14.98, "text": "haqidagi qissa."}, {"k": "sub", "t0": 18.86, "t1": 20.38, "text": "Amir Husayn endi yo'q."}, {"k": "sub", "t0": 20.72, "t1": 21.94, "text": "Temurga teng keladigan"}, {"k": "sub", "t0": 21.96, "t1": 23.06, "text": "raqib qolmadi."}, {"k": "sub", "t0": 23.16, "t1": 24.1, "text": "Chig'atoy ulusining"}, {"k": "sub", "t0": 24.12, "t1": 25.06, "text": "amirlari Balxda"}, {"k": "sub", "t0": 25.08, "t1": 26.96, "text": "to'planadi va Temurni o'z"}, {"k": "sub", "t0": 26.98, "t1": 28.46, "text": "yetakchisi deb tan oladi."}, {"k": "sub", "t0": 28.64, "t1": 29.94, "text": "Go'yo hammasi hal"}, {"k": "sub", "t0": 29.96, "t1": 30.96, "text": "bo'lgandek edi,"}, {"k": "sub", "t0": 31.2, "t1": 33.12, "text": "lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 33.18, "t1": 34.54, "text": "Chingizxon zamonidan beri"}, {"k": "sub", "t0": 34.56, "t1": 35.98, "text": "bir qoida amal qilardi."}, {"k": "sub", "t0": 36.12, "t1": 36.98, "text": "Xon faqat"}, {"k": "sub", "t0": 37.0, "t1": 38.52, "text": "Chingiz avlodidan bo'ladi."}, {"k": "sub", "t0": 38.58, "t1": 39.92, "text": "Temur esa Barlos"}, {"k": "sub", "t0": 39.94, "t1": 40.82, "text": "urug'idan edi."}, {"k": "sub", "t0": 40.94, "t1": 41.86, "text": "Lashkari bor,"}, {"k": "sub", "t0": 41.96, "t1": 43.6, "text": "kuchi bor, ammo xon"}, {"k": "sub", "t0": 43.62, "t1": 45.02, "text": "bo'lishga haqqi yo'q."}, {"k": "sub", "t0": 45.18, "t1": 46.94, "text": "Temur bu qoidani buzmadi."}, {"k": "sub", "t0": 47.16, "t1": 48.48, "text": "U boshqa yo'l topdi."}, {"k": "sub", "t0": 48.54, "t1": 49.86, "text": "Balxga yetmasdan u"}, {"k": "sub", "t0": 49.88, "t1": 51.2, "text": "Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 51.22, "t1": 52.34, "text": "Suyurg'atmishni xon"}, {"k": "sub", "t0": 52.36, "t1": 53.48, "text": "qilib ko'targan edi."}, {"k": "sub", "t0": 53.58, "t1": 54.98, "text": "Xon taxtda o'tiradi,"}, {"k": "sub", "t0": 55.06, "t1": 56.06, "text": "Temur esa uning"}, {"k": "sub", "t0": 56.08, "t1": 57.58, "text": "nomidan hukm yuritadi."}, {"k": "sub", "t0": 57.74, "t1": 59.9, "text": "Aslida xon faqat nom edi."}, {"k": "sub", "t0": 60.04, "t1": 61.02, "text": "Butun hokimiyat"}, {"k": "sub", "t0": 61.04, "t1": 62.32, "text": "Temurning qo'lida edi."}, {"k": "sub", "t0": 62.42, "t1": 63.44, "text": "Ikkinchi qadam."}, {"k": "sub", "t0": 63.54, "t1": 65.74, "text": "Temur Saroymulkxonimga uylanadi."}, {"k": "sub", "t0": 65.84, "t1": 67.36, "text": "U Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 67.38, "t1": 68.94, "text": "Qozonxonning qizi va"}, {"k": "sub", "t0": 68.96, "t1": 70.74, "text": "Amir Husaynning bevasi edi."}, {"k": "sub", "t0": 70.8, "t1": 72.06, "text": "Shu nikoh bilan Temur"}, {"k": "sub", "t0": 72.08, "t1": 73.34, "text": "yangi unvon oladi."}, {"k": "sub", "t0": 73.38, "t1": 75.68, "text": "Ko'ragon, ya'ni xon kuyovi."}, {"k": "sub", "t0": 75.76, "t1": 76.92, "text": "O'zi esa umrining"}, {"k": "sub", "t0": 76.94, "t1": 78.08, "text": "oxirigacha bitta"}, {"k": "sub", "t0": 78.1, "t1": 79.26, "text": "unvon bilan qoladi."}, {"k": "sub", "t0": 79.46, "t1": 79.98, "text": "Amir."}, {"k": "sub", "t0": 80.06, "t1": 80.96, "text": "Poytaxt qilib u"}, {"k": "sub", "t0": 80.98, "t1": 82.32, "text": "Samarqandni tanlaydi."}, {"k": "sub", "t0": 82.34, "t1": 83.82, "text": "Shahar atrofida mustahkam"}, {"k": "sub", "t0": 83.84, "t1": 85.1, "text": "devorlar qurdiradi."}, {"k": "sub", "t0": 85.18, "t1": 87.88, "text": "Xon emas, lekin xondan kuchli."}, {"k": "sub", "t0": 87.9, "t1": 89.66, "text": "Temur endi Movarounnahrning"}, {"k": "sub", "t0": 89.68, "t1": 91.2, "text": "haqiqiy hukmdori edi."}, {"k": "sub", "t0": 91.28, "t1": 92.36, "text": "Lekin bu hokimiyatni"}, {"k": "sub", "t0": 92.38, "t1": 93.56, "text": "saqlab qolish uchun u"}, {"k": "sub", "t0": 93.58, "t1": 95.12, "text": "hali ko'p yil kurashadi."}, {"k": "sub", "t0": 95.22, "t1": 96.7, "text": "Oradan bir necha yil o'tib,"}, {"k": "sub", "t0": 96.72, "t1": 97.8, "text": "uning huzuriga bir"}, {"k": "sub", "t0": 97.82, "t1": 99.3, "text": "qochoq shahzoda keladi."}, {"k": "sub", "t0": 99.38, "t1": 100.84, "text": "Ismi To'xtamish."}, {"k": "sub", "t0": 100.88, "t1": 101.76, "text": "Temur uni quchoq"}, {"k": "sub", "t0": 101.78, "t1": 102.86, "text": "ochib kutib oladi,"}, {"k": "sub", "t0": 102.9, "t1": 104.32, "text": "himoya qiladi va xon"}, {"k": "sub", "t0": 104.34, "t1": 105.78, "text": "bo'lishiga yordam beradi."}, {"k": "sub", "t0": 105.88, "t1": 107.14, "text": "Bir kun kelib, aynan"}, {"k": "sub", "t0": 107.16, "t1": 108.76, "text": "shu odam Temurning eng"}, {"k": "sub", "t0": 108.78, "t1": 110.38, "text": "xavfli raqibiga aylanadi."}, {"k": "sub", "t0": 110.5, "t1": 111.8, "text": "O'zi xon qilgan odam"}, {"k": "sub", "t0": 111.82, "t1": 113.14, "text": "nega unga qarshi chiqdi?"}, {"k": "sub", "t0": 113.22, "t1": 114.36, "text": "Buni keyingi qismda"}, {"k": "sub", "t0": 114.38, "t1": 115.24, "text": "bilib olasiz."}]}