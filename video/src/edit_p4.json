"fade", "grade": "warm"}, {"t0": 75.42, "t1": 77.81, "img": "21", "mv": "in2", "tr": "dip", "grade": "warm"}, {"t0": 77.81, "t1": 85.36, "img": "mo:line2", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 85.36, "t1": 88.28, "img": "22", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 88.28, "t1": 91.06, "img": "mo:tabriz", "mv": "none", "tr": "dip", "grade": "warm"}, {"t0": 91.06, "t1": 93.48, "img": "23", "mv": "panR", "tr": "fade", "grade": "cold"}, {"t0": 93.48, "t1": 95.58, "img": "24", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 95.58, "t1": 100.97, "img": "25", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 100.97, "t1": 105.43, "img": "26", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 105.43, "t1": 108.1, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 108.1, "t1": 110.24, "img": "28", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 110.24, "t1": 112.91, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 112.91, "t1": 116.11, "img": "30", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 116.11, "t1": 120.03, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 120.03, "t1": 122.43, "img": "32", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 122.43, "t1": 125.29, "img": "33", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 125.29, "t1": 129.44, "img": "mo:invade", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 129.44, "t1": 133.2, "img": "34", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 133.2, "t1": 137.29, "img": "35", "mv": "in2", "tr": "dip", "grade": "cold"}, {"t0": 137.29, "t1": 143.57, "img": "36", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 143.57, "t1": 158.236, "img": "37", "mv": "inslow", "tr": "fade", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.0, "text": "4-QISM"}, {"k": "name", "t0": 13.24, "t1": 15.44, "text": "TO'XTAMISH"}, {"k": "name", "t0": 22.3, "t1": 24.9, "text": "O'RUSXON"}, {"k": "date", "t0": 88.72, "t1": 91.09, "text": "1385", "sub": "QISH", "sub_t": 1.86}, {"k": "date", "t0": 95.76, "t1": 98.07, "text": "1387", "sub": "BAHOR", "sub_t": 1.72}, {"k": "name", "t0": 110.4, "t1": 112.8, "text": "MIRONSHOH"}, {"k": "q", "t0": 146.88, "t1": 155.436}, {"k": "subend", "t0": 155.436, "t1": 158.236}, {"k": "bars", "t0": 0.1, "t1": 9.18}, {"k": "bars", "t0": 133.54, "t1": 137.32}, {"k": "sub", "t0": 0.36, "t1": 1.58, "text": "Sirdaryo bo'yi."}, {"k": "sub", "t0": 1.9, "t1": 3.02, "text": "Butazor ichida"}, {"k": "sub", "t0": 3.28, "t1": 4.419, "text": "bir odam yotibdi."}, {"k": "sub", "t0": 4.9, "t1": 6.24, "text": "Yalang'och, qo'li"}, {"k": "sub", "t0": 6.26, "t1": 7.74, "text": "kamon o'qidan yaralangan,"}, {"k": "sub", "t0": 7.98, "t1": 9.1, "text": "zo'rg'a nafas oladi."}, {"k": "sub", "t0": 9.5, "t1": 10.98, "text": "Bu Chingizxon avlodidan"}, {"k": "sub", "t0": 11.0, "t1": 12.14, "text": "bo'lgan shahzoda."}, {"k": "sub", "t0": 12.5, "t1": 14.02, "text": "Ismi To'xtamish."}, {"k": "sub", "t0": 14.3, "t1": 15.86, "text": "Bir kun kelib u Temurdan"}, {"k": "sub", "t0": 15.88, "t1": 16.86, "text": "eng katta yaxshilikni"}, {"k": "sub", "t0": 16.88, "t1": 19.0, "text": "ko'radi va eng og'ir"}, {"k": "sub", "t0": 19.02, "t1": 20.22, "text": "xiyonatni qiladi."}, {"k": "sub", "t0": 21.0, "t1": 22.24, "text": "Bundan oldin To'xtamish"}, {"k": "sub", "t0": 22.26, "t1": 23.38, "text": "O'rusxondan qochib"}, {"k": "sub", "t0": 23.4, "t1": 24.52, "text": "Temur huzuriga panoh"}, {"k": "sub", "t0": 24.54, "t1": 25.6, "text": "so'rab kelgan edi."}, {"k": "sub", "t0": 25.8, "t1": 26.8, "text": "Temur uni izzat"}, {"k": "sub", "t0": 26.82, "t1": 27.84, "text": "bilan kutib oldi,"}, {"k": "sub", "t0": 27.94, "t1": 29.3, "text": "katta ziyofat berdi."}, {"k": "sub", "t0": 29.4, "t1": 31.08, "text": "Xon chodiri, nog'ora,"}, {"k": "sub", "t0": 31.1, "t1": 32.54, "text": "tuya va ot podalarini"}, {"k": "sub", "t0": 32.56, "t1": 33.42, "text": "hadya qildi."}, {"k": "sub", "t0": 33.58, "t1": 34.74, "text": "Yazdiy yozishicha,"}, {"k": "sub", "t0": 34.82, "t1": 36.2, "text": "uni o'g'lidek ko'rdi."}, {"k": "sub", "t0": 36.42, "t1": 37.42, "text": "O'tror va Sig'noq"}, {"k": "sub", "t0": 37.44, "t1": 38.98, "text": "yerlarni ham unga berdi."}, {"k": "sub", "t0": 39.26, "t1": 40.34, "text": "Lekin To'xtamish"}, {"k": "sub", "t0": 40.36, "t1": 41.64, "text": "O'rusxonning o'g'illariga"}, {"k": "sub", "t0": 41.66, "t1": 42.76, "text": "bas kela olmadi."}, {"k": "sub", "t0": 42.92, "t1": 43.9, "text": "Bir jangda yengilib"}, {"k": "sub", "t0": 43.92, "t1": 45.32, "text": "daryoga o'zini tashladi."}, {"k": "sub", "t0": 45.36, "t1": 47.1, "text": "Ortidan kamondan o'q otildi."}, {"k": "sub", "t0": 47.2, "t1": 48.68, "text": "Temur yuborgan bek esa"}, {"k": "sub", "t0": 48.7, "t1": 49.78, "text": "butazordan ingrash"}, {"k": "sub", "t0": 49.8, "t1": 50.82, "text": "ovozini eshitib,"}, {"k": "sub", "t0": 50.88, "t1": 52.52, "text": "uni tasodifan topib oldi."}, {"k": "sub", "t0": 52.84, "t1": 54.48, "text": "O'rusxondan elchilar keladi."}, {"k": "sub", "t0": 54.6, "t1": 55.88, "text": "U o'g'limni o'ldirdi."}, {"k": "sub", "t0": 55.92, "t1": 56.8, "text": "Uni bizga ber."}, {"k": "sub", "t0": 56.86, "t1": 58.56, "text": "Bermasang jang joyini ayt."}, {"k": "sub", "t0": 58.66, "t1": 59.88, "text": "Temur javob beradi."}, {"k": "sub", "t0": 59.94, "t1": 61.56, "text": "U bizdan panoh so'rab keldi."}, {"k": "sub", "t0": 61.6, "t1": 63.28, "text": "Men uni hech kimga bermayman."}, {"k": "sub", "t0": 63.3, "t1": 65.179, "text": "Urush istasangiz tayyormiz."}, {"k": "sub", "t0": 65.36, "t1": 66.48, "text": "To'xtamish to'rt marta"}, {"k": "sub", "t0": 66.5, "t1": 67.38, "text": "qochib keldi."}, {"k": "sub", "t0": 67.44, "t1": 68.68, "text": "Temur har safar uni"}, {"k": "sub", "t0": 68.7, "t1": 70.24, "text": "qaytadan oyoqqa turg'izdi."}, {"k": "sub", "t0": 70.32, "t1": 71.32, "text": "Oxiri To'xtamish"}, {"k": "sub", "t0": 71.34, "t1": 73.0, "text": "Dashti Qipchoq taxtiga o'tirdi."}, {"k": "sub", "t0": 73.02, "t1": 73.96, "text": "Keyin butun"}, {"k": "sub", "t0": 73.98, "t1": 75.46, "text": "Oltin O'rdani egalladi."}, {"k": "sub", "t0": 75.56, "t1": 77.04, "text": "Endi u Jo'chi ulusining"}, {"k": "sub", "t0": 77.06, "t1": 77.86, "text": "xoni edi."}, {"k": "sub", "t0": 77.94, "t1": 78.98, "text": "Chingiz avlodi."}, {"k": "sub", "t0": 79.12, "t1": 80.6, "text": "Temur esa, eslang,"}, {"k": "sub", "t0": 80.64, "t1": 81.86, "text": "xon bo'la olmasdi."}, {"k": "sub", "t0": 81.96, "t1": 83.2, "text": "Mo'g'ul an'anasiga ko'ra"}, {"k": "sub", "t0": 83.22, "t1": 84.3, "text": "To'xtamish Temurdan"}, {"k": "sub", "t0": 84.32, "t1": 85.36, "text": "yuqori turardi."}, {"k": "sub", "t0": 85.54, "t1": 86.36, "text": "Bir qinga"}, {"k": "sub", "t0": 86.58, "t1": 88.06, "text": "ikki qilich sig'masdi."}, {"k": "sub", "t0": 91.24, "t1": 92.66, "text": "To'xtamish qo'shini Darband"}, {"k": "sub", "t0": 92.68, "t1": 94.12, "text": "orqali o'tib Temurga"}, {"k": "sub", "t0": 94.14, "t1": 95.62, "text": "tobe Tabrizni talaydi."}, {"k": "sub", "t0": 98.06, "t1": 99.26, "text": "Kura daryosi bo'yida"}, {"k": "sub", "t0": 99.28, "t1": 100.12, "text": "yana uning qo'shini"}, {"k": "sub", "t0": 100.14, "t1": 101.04, "text": "paydo bo'ladi."}, {"k": "sub", "t0": 101.08, "t1": 102.1, "text": "Temur buyuradi."}, {"k": "sub", "t0": 102.16, "t1": 103.38, "text": "Agar ular To'xtamishning"}, {"k": "sub", "t0": 103.4, "t1": 104.4, "text": "odamlari bo'lsa,"}, {"k": "sub", "t0": 104.48, "t1": 105.48, "text": "jang qilmanglar."}, {"k": "sub", "t0": 105.56, "t1": 107.0, "text": "Beklar ortga qaytadi."}, {"k": "sub", "t0": 107.04, "t1": 108.14, "text": "Dushman esa ularning"}, {"k": "sub", "t0": 108.16, "t1": 109.32, "text": "orqasidan kamondan"}, {"k": "sub", "t0": 109.34, "t1": 110.3, "text": "o'q yog'diradi."}, {"k": "sub", "t0": 110.36, "t1": 111.44, "text": "Mironshoh yetib kelib"}, {"k": "sub", "t0": 111.46, "t1": 112.92, "text": "dushmanni quvib soladi."}, {"k": "sub", "t0": 113.08, "t1": 113.86, "text": "Temur asirlarni"}, {"k": "sub", "t0": 113.88, "t1": 115.2, "text": "qo'yib yuborib To'xtamishga"}, {"k": "sub", "t0": 115.22, "t1": 116.1, "text": "xabar yo'llaydi."}, {"k": "sub", "t0": 116.3, "t1": 117.18, "text": "Oramizda ota-bola"}, {"k": "sub", "t0": 117.2, "t1": 118.16, "text": "munosabati bor."}, {"k": "sub", "t0": 118.46, "t1": 119.68, "text": "Nega bunday qilyapsan?"}, {"k": "sub", "t0": 120.56, "t1": 122.34, "text": "Javob o'sha yil keldi."}, {"k": "sub", "t0": 122.7, "t1": 124.18, "text": "Temur uzoq janubda,"}, {"k": "sub", "t0": 124.34, "t1": 125.22, "text": "Forsda edi."}, {"k": "sub", "t0": 125.54, "t1": 126.32, "text": "To'xtamish qo'shini"}, {"k": "sub", "t0": 126.34, "t1": 128.08, "text": "Movarounnahrga bostirib kirdi."}, {"k": "sub", "t0": 128.1, "t1": 129.499, "text": "Buxoroni qamal qildi."}, {"k": "sub", "t0": 129.56, "t1": 130.86, "text": "Zanjirsaroyini yoqdi."}, {"k": "sub", "t0": 130.94, "t1": 131.96, "text": "Amudaryogacha bo'lgan"}, {"k": "sub", "t0": 131.98, "t1": 133.08, "text": "yerlarni taladi."}, {"k": "sub", "t0": 133.5, "t1": 135.6, "text": "Temur qutqargan odam endi"}, {"k": "sub", "t0": 135.62, "t1": 137.14, "text": "uning uyini yondirgan edi."}, {"k": "sub", "t0": 137.62, "t1": 139.0, "text": "Temur ortga qaytadi."}, {"k": "sub", "t0": 139.22, "t1": 140.26, "text": "Bir necha yil o'tib"}, {"k": "sub", "t0": 140.28, "t1": 141.06, "text": "u To'xtamishni"}, {"k": "sub", "t0": 141.08, "t1": 142.12, "text": "dashtning o'zida izlab"}, {"k": "sub", "t0": 142.14, "t1": 143.42, "text": "topishga qaror qiladi."}, {"k": "sub", "t0": 143.9, "t1": 145.44, "text": "Bu yurish qanday tugadi?"}, {"k": "sub", "t0": 145.68, "t1": 146.7, "text": "Keyingi qismda."}, {"k": "sub", "t0": 147.08, "t1": 147.99, "text": "Siz-chi?"}, {"k": "sub", "t0": 148.52, "t1": 150.6, "text": "Temurning o'rnida bo'lganingizda..."}, {"k": "sub", "t0": 150.65, "t1": 152.82, "text": "To'xtamishni yana kechirarmidingiz?"}, {"k": "sub", "t0": 153.37, "t1": 155.26, "text": "Javobingizni izohda yozing."}]}