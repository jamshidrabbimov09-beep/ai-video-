"tr": "fade", "grade": "cold"}, {"t0": 83.281, "t1": 85.906, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 85.906, "t1": 92.281, "img": "28", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 92.281, "t1": 95.281, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 95.281, "t1": 98.281, "img": "15", "mv": "in", "tr": "fade", "grade": "cold"}, {"t0": 98.281, "t1": 100.906, "img": "30", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 100.906, "t1": 106.156, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 106.156, "t1": 109.156, "img": "32", "mv": "out", "tr": "fade", "grade": "cold"}, {"t0": 109.156, "t1": 113.656, "img": "33", "mv": "in", "tr": "dip", "grade": "warm"}, {"t0": 113.656, "t1": 116.656, "img": "34", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 116.656, "t1": 120.406, "img": "03", "mv": "inslow", "tr": "fade", "grade": "sepia"}, {"t0": 120.406, "t1": 124.531, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 124.531, "t1": 129.781, "img": "38", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 129.781, "t1": 133.531, "img": "36", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 133.531, "t1": 139.906, "img": "37", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 139.906, "t1": 143.656, "img": "02", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 143.656, "t1": 148.011, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.4, "t1": 5.381, "text": "2-QISM"}, {"k": "title", "t0": 9.781, "t1": 14.381, "text": "DO'ST VA DUSHMAN", "sub": "Temur va Amir Husayn", "sub_t": 1.08}, {"k": "date", "t0": 20.656, "t1": 24.856, "text": "1360", "sub": "MOVAROUNNAHR", "sub_t": 2.32}, {"k": "name", "t0": 47.311, "t1": 51.311, "text": "AMIR HUSAYN", "sub": "Temurning ittifoqchisi", "sub_t": 0.7}, {"k": "date", "t0": 63.406, "t1": 67.406, "text": "1363", "sub": "ATROFIDA", "sub_t": 1.52}, {"k": "date", "t0": 71.281, "t1": 75.481, "text": "1365", "sub": "LOY JANGI", "sub_t": 2.18}, {"k": "date", "t0": 109.531, "t1": 113.931, "text": "1370", "sub": "BALX", "sub_t": 2.32}, {"k": "end", "t0": 143.881, "t1": 148.011, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 15.976, "t1": 20.136}, {"k": "bars", "t0": 71.281, "t1": 80.146}, {"k": "bars", "t0": 109.531, "t1": 116.571}, {"k": "sub", "t0": 0.741, "t1": 2.581, "text": "Yolg'iz yigit hech kimni yenga"}, {"k": "sub", "t0": 2.601, "t1": 3.301, "text": "olmaydi."}, {"k": "sub", "t0": 3.741, "t1": 5.401, "text": "Temur buni erta tushundi."}, {"k": "sub", "t0": 5.991, "t1": 8.211, "text": "Unga do'st kerak edi va u"}, {"k": "sub", "t0": 8.311, "t1": 9.271, "text": "do'stni topdi."}, {"k": "sub", "t0": 9.741, "t1": 11.861, "text": "Bu Temur va Amir Husayn haqidagi"}, {"k": "sub", "t0": 11.881, "t1": 12.521, "text": "qissa."}, {"k": "sub", "t0": 13.116, "t1": 15.516, "text": "Ikki yaqin odam bitta orzu."}, {"k": "sub", "t0": 16.036, "t1": 18.296, "text": "Lekin o'sha do'st bir kuni undan"}, {"k": "sub", "t0": 18.316, "t1": 20.056, "text": "ham xavfli dushmanga aylandi."}, {"k": "sub", "t0": 20.616, "t1": 22.436, "text": "1360-yil."}, {"k": "sub", "t0": 22.936, "t1": 24.896, "text": "Movarounnahr parchalangan."}, {"k": "sub", "t0": 25.491, "t1": 27.431, "text": "Mo'g'ul xoni Tug'luq Temur lashkar"}, {"k": "sub", "t0": 27.451, "t1": 28.511, "text": "bilan kirib keladi."}, {"k": "sub", "t0": 28.866, "t1": 30.746, "text": "Mahalliy amirlar yo qochadi,"}, {"k": "sub", "t0": 30.766, "t1": 31.846, "text": "yo bo'ysunadi."}, {"k": "sub", "t0": 32.241, "t1": 34.601, "text": "Qarshilik qilish esa o'limni anglatardi."}, {"k": "sub", "t0": 35.241, "t1": 36.801, "text": "Yosh Temur ham uning xizmatiga"}, {"k": "sub", "t0": 36.821, "t1": 37.421, "text": "o'tadi."}, {"k": "sub", "t0": 37.866, "t1": 40.706, "text": "Bu majburiyatmi yoki hisob-kitobmi?"}, {"k": "sub", "t0": 41.241, "t1": 43.281, "text": "Tarixchilar hanuzgacha bahslashadi."}, {"k": "sub", "t0": 43.866, "t1": 46.146, "text": "Tez orada u yo'lini o'zgartiradi."}, {"k": "sub", "t0": 46.491, "t1": 48.611, "text": "Uning yonida Amir Husayn bor edi."}, {"k": "sub", "t0": 49.116, "t1": 50.416, "text": "Yirik amir avlodi,"}, {"k": "sub", "t0": 50.436, "t1": 52.776, "text": "qudratli, ammo shuhratparast."}, {"k": "sub", "t0": 53.241, "t1": 55.161, "text": "Temur uning singlisiga uylangan."}, {"k": "sub", "t0": 55.491, "t1": 57.171, "text": "Shu bilan ittifoq qarindoshlikka"}, {"k": "sub", "t0": 57.191, "t1": 57.971, "text": "aylangan."}, {"k": "sub", "t0": 58.491, "t1": 59.971, "text": "Ikkisi birga otlanadi."}, {"k": "sub", "t0": 60.366, "t1": 62.986, "text": "Kuchlari kam, lekin ular to'xtamaydi."}, {"k": "sub", "t0": 63.366, "t1": 66.286, "text": "1363-yil atrofida Tug'luq Temur"}, {"k": "sub", "t0": 66.306, "t1": 67.226, "text": "vafot etadi."}, {"k": "sub", "t0": 67.866, "t1": 70.066, "text": "Uning o'g'li Ilyosxo'ja Movarounnahrga"}, {"k": "sub", "t0": 70.086, "t1": 70.726, "text": "qaytadi."}, {"k": "sub", "t0": 71.241, "t1": 73.181, "text": "1365-yil."}, {"k": "sub", "t0": 73.421, "t1": 74.321, "text": "Loy jangi."}, {"k": "sub", "t0": 74.616, "t1": 76.516, "text": "Temur bilan Husayn yengiladi."}, {"k": "sub", "t0": 76.866, "t1": 79.326, "text": "Bu Temurning kamdan-kam mag'lubiyatlaridan"}, {"k": "sub", "t0": 79.346, "t1": 80.066, "text": "biri edi."}, {"k": "sub", "t0": 80.616, "t1": 82.336, "text": "Hamma ularning ishi tugadi deb"}, {"k": "sub", "t0": 82.356, "t1": 84.976, "text": "o'ylagan, ammo ikkalasi ham taslim"}, {"k": "sub", "t0": 84.996, "t1": 85.696, "text": "bo'lmadi."}, {"k": "sub", "t0": 86.241, "t1": 88.141, "text": "Keyingi yillarda ular mamlakatni"}, {"k": "sub", "t0": 88.161, "t1": 91.161, "text": "qaytarib oldi, lekin g'alaba do'stlikni"}, {"k": "sub", "t0": 91.181, "t1": 92.001, "text": "saqlamadi."}, {"k": "sub", "t0": 92.616, "t1": 94.456, "text": "Husayn tobora o'zboshimcha bo'lib"}, {"k": "sub", "t0": 94.476, "t1": 95.036, "text": "bordi."}, {"k": "sub", "t0": 95.616, "t1": 97.376, "text": "U Temurning buyrug'ini ham ado"}, {"k": "sub", "t0": 97.396, "t1": 98.236, "text": "etmay qo'ydi."}, {"k": "sub", "t0": 98.616, "t1": 100.896, "text": "Ikki amir o'rtasida ishonch yo'qoldi."}, {"k": "sub", "t0": 101.241, "t1": 103.081, "text": "Ikkalasi ham bir narsani bilardi:"}, {"k": "sub", "t0": 103.491, "t1": 105.931, "text": "Bir taxtga ikki hukmdor sig'maydi."}, {"k": "sub", "t0": 106.491, "t1": 108.991, "text": "Kelishmovchilik ochiq urushga aylanadi."}, {"k": "sub", "t0": 109.491, "t1": 111.331, "text": "1370-yil."}, {"k": "sub", "t0": 111.471, "t1": 113.211, "text": "Temur Balxni qamal qiladi,"}, {"k": "sub", "t0": 113.711, "t1": 116.391, "text": "Husayn mag'lub bo'ladi va o'ldiriladi."}, {"k": "sub", "t0": 116.991, "t1": 118.851, "text": "Bir paytlar yelkama-yelka turgan"}, {"k": "sub", "t0": 118.871, "t1": 120.451, "text": "do'st endi yo'q edi."}, {"k": "sub", "t0": 120.741, "t1": 123.121, "text": "Movarounnahrda Temurga teng keladigan"}, {"k": "sub", "t0": 123.141, "t1": 124.241, "text": "raqib qolmadi."}, {"k": "sub", "t0": 124.866, "t1": 125.946, "text": "Do'stlik tugadi,"}, {"k": "sub", "t0": 126.346, "t1": 128.466, "text": "ammo Temurning katta yo'li endi"}, {"k": "sub", "t0": 128.486, "t1": 129.626, "text": "boshlanayotgan edi."}, {"k": "sub", "t0": 130.116, "t1": 132.256, "text": "Shu yili Balxda u hukmdor deb"}, {"k": "sub", "t0": 132.276, "t1": 133.236, "text": "e'lon qilinadi."}, {"k": "sub", "t0": 133.866, "t1": 135.706, "text": "Lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 136.116, "t1": 137.776, "text": "U Chingiz avlodi emas,"}, {"k": "sub", "t0": 137.876, "t1": 139.636, "text": "demak, xon bo'la olmaydi."}, {"k": "sub", "t0": 140.241, "t1": 142.001, "text": "Xon bo'lmagan odam qanday qilib"}, {"k": "sub", "t0": 142.021, "t1": 143.341, "text": "butun yurtni boshqardi?"}, {"k": "sub", "t0": 143.991, "t1": 145.031, "text": "Keyingi qismda"}]}