": "fade", "grade": "cold"}, {"t0": 82.906, "t1": 85.531, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 85.531, "t1": 91.906, "img": "28", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 91.906, "t1": 94.906, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 94.906, "t1": 97.906, "img": "15", "mv": "in", "tr": "fade", "grade": "cold"}, {"t0": 97.906, "t1": 100.531, "img": "30", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 100.531, "t1": 105.781, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 105.781, "t1": 108.781, "img": "32", "mv": "out", "tr": "fade", "grade": "cold"}, {"t0": 108.781, "t1": 113.281, "img": "33", "mv": "in", "tr": "dip", "grade": "warm"}, {"t0": 113.281, "t1": 116.281, "img": "34", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 116.281, "t1": 120.031, "img": "03", "mv": "inslow", "tr": "fade", "grade": "sepia"}, {"t0": 120.031, "t1": 124.156, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 124.156, "t1": 129.406, "img": "38", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 129.406, "t1": 133.156, "img": "36", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 133.156, "t1": 139.531, "img": "37", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 139.531, "t1": 143.281, "img": "12", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 143.281, "t1": 146.336, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.3, "text": "2-QISM"}, {"k": "date", "t0": 20.281, "t1": 22.881, "text": "1360"}, {"k": "name", "t0": 46.936, "t1": 50.136, "text": "AMIR HUSAYN"}, {"k": "date", "t0": 70.906, "t1": 75.106, "text": "1365", "sub": "LOY JANGI", "sub_t": 2.18}, {"k": "date", "t0": 109.156, "t1": 113.556, "text": "1370", "sub": "BALX", "sub_t": 2.32}, {"k": "end", "t0": 143.506, "t1": 146.336, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 15.601, "t1": 19.761}, {"k": "bars", "t0": 70.906, "t1": 79.771}, {"k": "bars", "t0": 109.156, "t1": 116.196}, {"k": "sub", "t0": 0.366, "t1": 1.566, "text": "Yolg'iz yigit hech"}, {"k": "sub", "t0": 1.586, "t1": 2.926, "text": "kimni yenga olmaydi."}, {"k": "sub", "t0": 3.366, "t1": 5.026, "text": "Temur buni erta tushundi."}, {"k": "sub", "t0": 5.616, "t1": 7.036, "text": "Unga do'st kerak edi"}, {"k": "sub", "t0": 7.276, "t1": 8.896, "text": "va u do'stni topdi."}, {"k": "sub", "t0": 9.366, "t1": 11.006, "text": "Bu Temur va Amir Husayn"}, {"k": "sub", "t0": 11.026, "t1": 12.146, "text": "haqidagi qissa."}, {"k": "sub", "t0": 12.741, "t1": 15.141, "text": "Ikki yaqin odam bitta orzu."}, {"k": "sub", "t0": 15.661, "t1": 17.121, "text": "Lekin o'sha do'st bir"}, {"k": "sub", "t0": 17.141, "t1": 18.501, "text": "kuni undan ham xavfli"}, {"k": "sub", "t0": 18.521, "t1": 19.681, "text": "dushmanga aylandi."}, {"k": "sub", "t0": 22.561, "t1": 24.521, "text": "Movarounnahr parchalangan."}, {"k": "sub", "t0": 25.116, "t1": 25.916, "text": "Mo'g'ul xoni"}, {"k": "sub", "t0": 25.936, "t1": 27.056, "text": "Tug'luq Temur lashkar"}, {"k": "sub", "t0": 27.076, "t1": 28.136, "text": "bilan kirib keladi."}, {"k": "sub", "t0": 28.491, "t1": 29.671, "text": "Mahalliy amirlar yo"}, {"k": "sub", "t0": 29.691, "t1": 31.471, "text": "qochadi, yo bo'ysunadi."}, {"k": "sub", "t0": 31.866, "t1": 33.026, "text": "Qarshilik qilish esa"}, {"k": "sub", "t0": 33.046, "t1": 34.226, "text": "o'limni anglatardi."}, {"k": "sub", "t0": 34.866, "t1": 35.946, "text": "Yosh Temur ham uning"}, {"k": "sub", "t0": 35.966, "t1": 37.046, "text": "xizmatiga o'tadi."}, {"k": "sub", "t0": 37.491, "t1": 38.811, "text": "Bu majburiyatmi"}, {"k": "sub", "t0": 38.831, "t1": 40.331, "text": "yoki hisob-kitobmi?"}, {"k": "sub", "t0": 40.866, "t1": 42.906, "text": "Tarixchilar hanuzgacha bahslashadi."}, {"k": "sub", "t0": 43.491, "t1": 44.451, "text": "Tez orada u"}, {"k": "sub", "t0": 44.471, "t1": 45.771, "text": "yo'lini o'zgartiradi."}, {"k": "sub", "t0": 46.116, "t1": 46.876, "text": "Uning yonida"}, {"k": "sub", "t0": 46.896, "t1": 48.236, "text": "Amir Husayn bor edi."}, {"k": "sub", "t0": 48.741, "t1": 50.841, "text": "Yirik amir avlodi, qudratli,"}, {"k": "sub", "t0": 50.981, "t1": 52.401, "text": "ammo shuhratparast."}, {"k": "sub", "t0": 52.866, "t1": 53.506, "text": "Temur uning"}, {"k": "sub", "t0": 53.526, "t1": 54.786, "text": "singlisiga uylangan."}, {"k": "sub", "t0": 55.116, "t1": 55.636, "text": "Shu bilan"}, {"k": "sub", "t0": 55.656, "t1": 57.596, "text": "ittifoq qarindoshlikka aylangan."}, {"k": "sub", "t0": 58.116, "t1": 59.596, "text": "Ikkisi birga otlanadi."}, {"k": "sub", "t0": 59.991, "t1": 60.971, "text": "Kuchlari kam,"}, {"k": "sub", "t0": 60.991, "t1": 62.611, "text": "lekin ular to'xtamaydi."}, {"k": "sub", "t0": 62.991, "t1": 65.191, "text": "1363-yil atrofida"}, {"k": "sub", "t0": 65.211, "t1": 66.851, "text": "Tug'luq Temur vafot etadi."}, {"k": "sub", "t0": 67.491, "t1": 68.871, "text": "Uning o'g'li Ilyosxo'ja"}, {"k": "sub", "t0": 68.891, "t1": 70.351, "text": "Movarounnahrga qaytadi."}, {"k": "sub", "t0": 74.241, "t1": 76.141, "text": "Temur bilan Husayn yengiladi."}, {"k": "sub", "t0": 76.491, "t1": 78.011, "text": "Bu Temurning kamdan-kam"}, {"k": "sub", "t0": 78.031, "t1": 79.691, "text": "mag'lubiyatlaridan biri edi."}, {"k": "sub", "t0": 80.241, "t1": 81.781, "text": "Hamma ularning ishi tugadi"}, {"k": "sub", "t0": 81.801, "t1": 83.941, "text": "deb o'ylagan, ammo ikkalasi"}, {"k": "sub", "t0": 83.961, "t1": 85.321, "text": "ham taslim bo'lmadi."}, {"k": "sub", "t0": 85.866, "t1": 87.186, "text": "Keyingi yillarda ular"}, {"k": "sub", "t0": 87.206, "t1": 88.766, "text": "mamlakatni qaytarib oldi,"}, {"k": "sub", "t0": 89.346, "t1": 90.306, "text": "lekin g'alaba"}, {"k": "sub", "t0": 90.326, "t1": 91.626, "text": "do'stlikni saqlamadi."}, {"k": "sub", "t0": 92.241, "t1": 93.181, "text": "Husayn tobora"}, {"k": "sub", "t0": 93.201, "t1": 94.661, "text": "o'zboshimcha bo'lib bordi."}, {"k": "sub", "t0": 95.241, "t1": 96.461, "text": "U Temurning buyrug'ini"}, {"k": "sub", "t0": 96.481, "t1": 97.861, "text": "ham ado etmay qo'ydi."}, {"k": "sub", "t0": 98.241, "t1": 99.461, "text": "Ikki amir o'rtasida"}, {"k": "sub", "t0": 99.481, "t1": 100.521, "text": "ishonch yo'qoldi."}, {"k": "sub", "t0": 100.866, "t1": 101.706, "text": "Ikkalasi ham bir"}, {"k": "sub", "t0": 101.726, "t1": 102.706, "text": "narsani bilardi:"}, {"k": "sub", "t0": 103.116, "t1": 104.216, "text": "Bir taxtga ikki"}, {"k": "sub", "t0": 104.236, "t1": 105.556, "text": "hukmdor sig'maydi."}, {"k": "sub", "t0": 106.116, "t1": 107.536, "text": "Kelishmovchilik ochiq"}, {"k": "sub", "t0": 107.556, "t1": 108.616, "text": "urushga aylanadi."}, {"k": "sub", "t0": 111.096, "t1": 112.836, "text": "Temur Balxni qamal qiladi,"}, {"k": "sub", "t0": 113.336, "t1": 114.816, "text": "Husayn mag'lub bo'ladi"}, {"k": "sub", "t0": 114.836, "t1": 116.016, "text": "va o'ldiriladi."}, {"k": "sub", "t0": 116.616, "t1": 117.336, "text": "Bir paytlar"}, {"k": "sub", "t0": 117.356, "t1": 118.476, "text": "yelkama-yelka turgan"}, {"k": "sub", "t0": 118.496, "t1": 120.076, "text": "do'st endi yo'q edi."}, {"k": "sub", "t0": 120.366, "t1": 122.206, "text": "Movarounnahrda Temurga teng"}, {"k": "sub", "t0": 122.226, "t1": 123.866, "text": "keladigan raqib qolmadi."}, {"k": "sub", "t0": 124.491, "t1": 125.571, "text": "Do'stlik tugadi,"}, {"k": "sub", "t0": 125.971, "t1": 127.831, "text": "ammo Temurning katta yo'li"}, {"k": "sub", "t0": 127.851, "t1": 129.251, "text": "endi boshlanayotgan edi."}, {"k": "sub", "t0": 129.741, "t1": 131.681, "text": "Shu yili Balxda u hukmdor"}, {"k": "sub", "t0": 131.701, "t1": 132.861, "text": "deb e'lon qilinadi."}, {"k": "sub", "t0": 133.491, "t1": 135.331, "text": "Lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 135.741, "t1": 137.401, "text": "U Chingiz avlodi emas,"}, {"k": "sub", "t0": 137.501, "t1": 139.261, "text": "demak, xon bo'la olmaydi."}, {"k": "sub", "t0": 139.866, "t1": 141.006, "text": "Xon bo'lmagan odam"}, {"k": "sub", "t0": 141.026, "t1": 141.926, "text": "qanday qilib butun"}, {"k": "sub", "t0": 141.946, "t1": 142.966, "text": "yurtni boshqardi?"}, {"k": "sub", "t0": 143.616, "t1": 144.656, "text": "Keyingi qismda"}]}