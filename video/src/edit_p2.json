"tr": "fade", "grade": "cold"}, {"t0": 83.281, "t1": 85.906, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 85.906, "t1": 92.281, "img": "28", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 92.281, "t1": 95.281, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 95.281, "t1": 98.281, "img": "15", "mv": "in", "tr": "fade", "grade": "cold"}, {"t0": 98.281, "t1": 100.906, "img": "30", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 100.906, "t1": 106.156, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 106.156, "t1": 109.156, "img": "32", "mv": "out", "tr": "fade", "grade": "cold"}, {"t0": 109.156, "t1": 113.656, "img": "33", "mv": "in", "tr": "dip", "grade": "warm"}, {"t0": 113.656, "t1": 116.656, "img": "34", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 116.656, "t1": 120.406, "img": "03", "mv": "inslow", "tr": "fade", "grade": "sepia"}, {"t0": 120.406, "t1": 124.531, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 124.531, "t1": 129.781, "img": "38", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 129.781, "t1": 133.531, "img": "36", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 133.531, "t1": 139.906, "img": "37", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 139.906, "t1": 143.656, "img": "02", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 143.656, "t1": 148.011, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "name", "t0": 0.5, "t1": 5.3, "text": "DO'ST VA DUSHMAN", "sub": "2-qism", "sub_t": 0.7}, {"k": "date", "t0": 20.656, "t1": 23.256, "text": "1360"}, {"k": "name", "t0": 47.311, "t1": 50.511, "text": "AMIR HUSAYN"}, {"k": "date", "t0": 71.281, "t1": 75.481, "text": "1365", "sub": "LOY JANGI", "sub_t": 2.18}, {"k": "date", "t0": 109.531, "t1": 113.931, "text": "1370", "sub": "BALX", "sub_t": 2.32}, {"k": "end", "t0": 143.881, "t1": 148.011, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 15.976, "t1": 20.136}, {"k": "bars", "t0": 71.281, "t1": 80.146}, {"k": "bars", "t0": 109.531, "t1": 116.571}, {"k": "sub", "t0": 0.741, "t1": 1.941, "text": "Yolg'iz yigit hech"}, {"k": "sub", "t0": 1.961, "t1": 3.301, "text": "kimni yenga olmaydi."}, {"k": "sub", "t0": 3.741, "t1": 5.401, "text": "Temur buni erta tushundi."}, {"k": "sub", "t0": 5.991, "t1": 7.411, "text": "Unga do'st kerak edi"}, {"k": "sub", "t0": 7.651, "t1": 9.271, "text": "va u do'stni topdi."}, {"k": "sub", "t0": 9.741, "t1": 11.381, "text": "Bu Temur va Amir Husayn"}, {"k": "sub", "t0": 11.401, "t1": 12.521, "text": "haqidagi qissa."}, {"k": "sub", "t0": 13.116, "t1": 15.516, "text": "Ikki yaqin odam bitta orzu."}, {"k": "sub", "t0": 16.036, "t1": 17.496, "text": "Lekin o'sha do'st bir"}, {"k": "sub", "t0": 17.516, "t1": 18.876, "text": "kuni undan ham xavfli"}, {"k": "sub", "t0": 18.896, "t1": 20.056, "text": "dushmanga aylandi."}, {"k": "sub", "t0": 22.936, "t1": 24.896, "text": "Movarounnahr parchalangan."}, {"k": "sub", "t0": 25.491, "t1": 26.291, "text": "Mo'g'ul xoni"}, {"k": "sub", "t0": 26.311, "t1": 27.431, "text": "Tug'luq Temur lashkar"}, {"k": "sub", "t0": 27.451, "t1": 28.511, "text": "bilan kirib keladi."}, {"k": "sub", "t0": 28.866, "t1": 30.046, "text": "Mahalliy amirlar yo"}, {"k": "sub", "t0": 30.066, "t1": 31.846, "text": "qochadi, yo bo'ysunadi."}, {"k": "sub", "t0": 32.241, "t1": 33.401, "text": "Qarshilik qilish esa"}, {"k": "sub", "t0": 33.421, "t1": 34.601, "text": "o'limni anglatardi."}, {"k": "sub", "t0": 35.241, "t1": 36.321, "text": "Yosh Temur ham uning"}, {"k": "sub", "t0": 36.341, "t1": 37.421, "text": "xizmatiga o'tadi."}, {"k": "sub", "t0": 37.866, "t1": 39.186, "text": "Bu majburiyatmi"}, {"k": "sub", "t0": 39.206, "t1": 40.706, "text": "yoki hisob-kitobmi?"}, {"k": "sub", "t0": 41.241, "t1": 43.281, "text": "Tarixchilar hanuzgacha bahslashadi."}, {"k": "sub", "t0": 43.866, "t1": 44.826, "text": "Tez orada u"}, {"k": "sub", "t0": 44.846, "t1": 46.146, "text": "yo'lini o'zgartiradi."}, {"k": "sub", "t0": 46.491, "t1": 47.251, "text": "Uning yonida"}, {"k": "sub", "t0": 47.271, "t1": 48.611, "text": "Amir Husayn bor edi."}, {"k": "sub", "t0": 49.116, "t1": 51.216, "text": "Yirik amir avlodi, qudratli,"}, {"k": "sub", "t0": 51.356, "t1": 52.776, "text": "ammo shuhratparast."}, {"k": "sub", "t0": 53.241, "t1": 53.881, "text": "Temur uning"}, {"k": "sub", "t0": 53.901, "t1": 55.161, "text": "singlisiga uylangan."}, {"k": "sub", "t0": 55.491, "t1": 56.011, "text": "Shu bilan"}, {"k": "sub", "t0": 56.031, "t1": 57.971, "text": "ittifoq qarindoshlikka aylangan."}, {"k": "sub", "t0": 58.491, "t1": 59.971, "text": "Ikkisi birga otlanadi."}, {"k": "sub", "t0": 60.366, "t1": 61.346, "text": "Kuchlari kam,"}, {"k": "sub", "t0": 61.366, "t1": 62.986, "text": "lekin ular to'xtamaydi."}, {"k": "sub", "t0": 63.366, "t1": 65.566, "text": "1363-yil atrofida"}, {"k": "sub", "t0": 65.586, "t1": 67.226, "text": "Tug'luq Temur vafot etadi."}, {"k": "sub", "t0": 67.866, "t1": 69.246, "text": "Uning o'g'li Ilyosxo'ja"}, {"k": "sub", "t0": 69.266, "t1": 70.726, "text": "Movarounnahrga qaytadi."}, {"k": "sub", "t0": 74.616, "t1": 76.516, "text": "Temur bilan Husayn yengiladi."}, {"k": "sub", "t0": 76.866, "t1": 78.386, "text": "Bu Temurning kamdan-kam"}, {"k": "sub", "t0": 78.406, "t1": 80.066, "text": "mag'lubiyatlaridan biri edi."}, {"k": "sub", "t0": 80.616, "t1": 82.156, "text": "Hamma ularning ishi tugadi"}, {"k": "sub", "t0": 82.176, "t1": 84.316, "text": "deb o'ylagan, ammo ikkalasi"}, {"k": "sub", "t0": 84.336, "t1": 85.696, "text": "ham taslim bo'lmadi."}, {"k": "sub", "t0": 86.241, "t1": 87.561, "text": "Keyingi yillarda ular"}, {"k": "sub", "t0": 87.581, "t1": 89.141, "text": "mamlakatni qaytarib oldi,"}, {"k": "sub", "t0": 89.721, "t1": 90.681, "text": "lekin g'alaba"}, {"k": "sub", "t0": 90.701, "t1": 92.001, "text": "do'stlikni saqlamadi."}, {"k": "sub", "t0": 92.616, "t1": 93.556, "text": "Husayn tobora"}, {"k": "sub", "t0": 93.576, "t1": 95.036, "text": "o'zboshimcha bo'lib bordi."}, {"k": "sub", "t0": 95.616, "t1": 96.836, "text": "U Temurning buyrug'ini"}, {"k": "sub", "t0": 96.856, "t1": 98.236, "text": "ham ado etmay qo'ydi."}, {"k": "sub", "t0": 98.616, "t1": 99.836, "text": "Ikki amir o'rtasida"}, {"k": "sub", "t0": 99.856, "t1": 100.896, "text": "ishonch yo'qoldi."}, {"k": "sub", "t0": 101.241, "t1": 102.081, "text": "Ikkalasi ham bir"}, {"k": "sub", "t0": 102.101, "t1": 103.081, "text": "narsani bilardi:"}, {"k": "sub", "t0": 103.491, "t1": 104.591, "text": "Bir taxtga ikki"}, {"k": "sub", "t0": 104.611, "t1": 105.931, "text": "hukmdor sig'maydi."}, {"k": "sub", "t0": 106.491, "t1": 107.911, "text": "Kelishmovchilik ochiq"}, {"k": "sub", "t0": 107.931, "t1": 108.991, "text": "urushga aylanadi."}, {"k": "sub", "t0": 111.471, "t1": 113.211, "text": "Temur Balxni qamal qiladi,"}, {"k": "sub", "t0": 113.711, "t1": 115.191, "text": "Husayn mag'lub bo'ladi"}, {"k": "sub", "t0": 115.211, "t1": 116.391, "text": "va o'ldiriladi."}, {"k": "sub", "t0": 116.991, "t1": 117.711, "text": "Bir paytlar"}, {"k": "sub", "t0": 117.731, "t1": 118.851, "text": "yelkama-yelka turgan"}, {"k": "sub", "t0": 118.871, "t1": 120.451, "text": "do'st endi yo'q edi."}, {"k": "sub", "t0": 120.741, "t1": 122.581, "text": "Movarounnahrda Temurga teng"}, {"k": "sub", "t0": 122.601, "t1": 124.241, "text": "keladigan raqib qolmadi."}, {"k": "sub", "t0": 124.866, "t1": 125.946, "text": "Do'stlik tugadi,"}, {"k": "sub", "t0": 126.346, "t1": 128.206, "text": "ammo Temurning katta yo'li"}, {"k": "sub", "t0": 128.226, "t1": 129.626, "text": "endi boshlanayotgan edi."}, {"k": "sub", "t0": 130.116, "t1": 132.056, "text": "Shu yili Balxda u hukmdor"}, {"k": "sub", "t0": 132.076, "t1": 133.236, "text": "deb e'lon qilinadi."}, {"k": "sub", "t0": 133.866, "t1": 135.706, "text": "Lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 136.116, "t1": 137.776, "text": "U Chingiz avlodi emas,"}, {"k": "sub", "t0": 137.876, "t1": 139.636, "text": "demak, xon bo'la olmaydi."}, {"k": "sub", "t0": 140.241, "t1": 141.381, "text": "Xon bo'lmagan odam"}, {"k": "sub", "t0": 141.401, "t1": 142.301, "text": "qanday qilib butun"}, {"k": "sub", "t0": 142.321, "t1": 143.341, "text": "yurtni boshqardi?"}, {"k": "sub", "t0": 143.991, "t1": 145.031, "text": "Keyingi qismda"}]}