n", "tr": "fade", "grade": "warm"}, {"t0": 83.281, "t1": 87.406, "img": "27", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 87.406, "t1": 90.406, "img": "28", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 90.406, "t1": 93.781, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 93.781, "t1": 96.781, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 96.781, "t1": 100.531, "img": "30", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 100.531, "t1": 105.031, "img": "32", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 105.031, "t1": 108.031, "img": "33", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 108.031, "t1": 111.406, "img": "34", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 111.406, "t1": 117.031, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 117.031, "t1": 122.281, "img": "36", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 122.281, "t1": 125.281, "img": "01", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 125.281, "t1": 129.316, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.3, "text": "3-QISM"}, {"k": "date", "t0": 15.031, "t1": 19.231, "text": "1370", "sub": "BAHOR. BALX", "sub_t": 1.76}, {"k": "name", "t0": 57.781, "t1": 60.781, "text": "SUYURG'ATMISH"}, {"k": "name", "t0": 74.941, "t1": 77.941, "text": "SAROYMULKXONIM"}, {"k": "name", "t0": 83.656, "t1": 86.656, "text": "KO'RAGON"}, {"k": "name", "t0": 111.781, "t1": 114.981, "text": "TO'XTAMISH"}, {"k": "end", "t0": 127.566, "t1": 129.316, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 18.781, "t1": 20.401}, {"k": "bars", "t0": 117.406, "t1": 125.516}, {"k": "sub", "t0": 0.366, "t1": 2.246, "text": "U ulkan saltanat qurdi,"}, {"k": "sub", "t0": 3.046, "t1": 4.686, "text": "lekin umrining oxirigacha"}, {"k": "sub", "t0": 4.706, "t1": 6.406, "text": "o'zini xon deb atamadi."}, {"k": "sub", "t0": 6.741, "t1": 7.301, "text": "Nega?"}, {"k": "sub", "t0": 7.866, "t1": 9.026, "text": "Chunki bunga uning"}, {"k": "sub", "t0": 9.046, "t1": 10.086, "text": "haqqi yo'q edi."}, {"k": "sub", "t0": 10.491, "t1": 12.411, "text": "Bu Amir Temur hokimiyatni"}, {"k": "sub", "t0": 12.431, "t1": 13.531, "text": "qanday qo'lga olgani"}, {"k": "sub", "t0": 13.551, "t1": 14.631, "text": "haqidagi qissa."}, {"k": "sub", "t0": 18.741, "t1": 20.321, "text": "Amir Husayn endi yo'q."}, {"k": "sub", "t0": 20.616, "t1": 21.776, "text": "Temurga teng keladigan"}, {"k": "sub", "t0": 21.796, "t1": 22.876, "text": "raqib qolmadi."}, {"k": "sub", "t0": 23.241, "t1": 24.201, "text": "Chig'atoy ulusining"}, {"k": "sub", "t0": 24.221, "t1": 25.201, "text": "amirlari Balxda"}, {"k": "sub", "t0": 25.221, "t1": 27.161, "text": "to'planadi va Temurni o'z"}, {"k": "sub", "t0": 27.181, "t1": 28.621, "text": "yetakchisi deb tan oladi."}, {"k": "sub", "t0": 29.241, "t1": 30.441, "text": "Go'yo hammasi hal"}, {"k": "sub", "t0": 30.461, "t1": 31.501, "text": "bo'lgandek edi,"}, {"k": "sub", "t0": 31.701, "t1": 33.621, "text": "lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 34.116, "t1": 35.556, "text": "Chingizxon zamonidan beri"}, {"k": "sub", "t0": 35.576, "t1": 37.076, "text": "bir qoida amal qilardi."}, {"k": "sub", "t0": 37.491, "t1": 38.371, "text": "Xon faqat"}, {"k": "sub", "t0": 38.391, "t1": 39.951, "text": "Chingiz avlodidan bo'ladi."}, {"k": "sub", "t0": 40.491, "t1": 41.831, "text": "Temur esa barlos"}, {"k": "sub", "t0": 41.851, "t1": 42.731, "text": "urug'idan edi."}, {"k": "sub", "t0": 43.116, "t1": 44.116, "text": "Lashkari bor,"}, {"k": "sub", "t0": 44.156, "t1": 45.816, "text": "kuchi bor, ammo xon"}, {"k": "sub", "t0": 45.836, "t1": 47.156, "text": "bo'lishga haqqi yo'q."}, {"k": "sub", "t0": 47.616, "t1": 49.356, "text": "Temur bu qoidani buzmadi."}, {"k": "sub", "t0": 49.866, "t1": 51.346, "text": "U boshqa yo'l topdi."}, {"k": "sub", "t0": 51.741, "t1": 53.241, "text": "Balxga yetmasdanoq u"}, {"k": "sub", "t0": 53.261, "t1": 54.781, "text": "Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 54.801, "t1": 56.021, "text": "Suyurg'atmishni xon"}, {"k": "sub", "t0": 56.041, "t1": 57.161, "text": "qilib ko'targan edi."}, {"k": "sub", "t0": 57.741, "t1": 59.161, "text": "Xon taxtda o'tiradi,"}, {"k": "sub", "t0": 59.301, "t1": 60.221, "text": "Temur esa uning"}, {"k": "sub", "t0": 60.241, "t1": 61.761, "text": "nomidan hukm yuritadi."}, {"k": "sub", "t0": 62.241, "t1": 64.421, "text": "Aslida xon faqat nom edi."}, {"k": "sub", "t0": 64.866, "t1": 65.946, "text": "Butun hokimiyat"}, {"k": "sub", "t0": 65.966, "t1": 67.286, "text": "Temurning qo'lida edi."}, {"k": "sub", "t0": 67.866, "t1": 68.946, "text": "Ikkinchi qadam."}, {"k": "sub", "t0": 69.366, "t1": 71.516, "text": "Temur Saroymulkxonimga uylanadi."}, {"k": "sub", "t0": 71.991, "t1": 73.531, "text": "U Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 73.551, "t1": 75.231, "text": "Qozonxonning qizi va"}, {"k": "sub", "t0": 75.251, "t1": 77.071, "text": "Amir Husaynning bevasi edi."}, {"k": "sub", "t0": 77.616, "t1": 78.876, "text": "Shu nikoh bilan Temur"}, {"k": "sub", "t0": 78.896, "t1": 80.216, "text": "yangi unvon oladi."}, {"k": "sub", "t0": 80.616, "t1": 83.186, "text": "Ko'ragon, ya'ni xon kuyovi."}, {"k": "sub", "t0": 83.616, "t1": 84.656, "text": "O'zi esa umrining"}, {"k": "sub", "t0": 84.676, "t1": 85.576, "text": "oxirigacha bitta"}, {"k": "sub", "t0": 85.596, "t1": 86.516, "text": "unvon bilan qoladi:"}, {"k": "sub", "t0": 86.536, "t1": 87.146, "text": "Amir."}, {"k": "sub", "t0": 87.741, "t1": 88.781, "text": "Poytaxt qilib u"}, {"k": "sub", "t0": 88.801, "t1": 90.221, "text": "Samarqandni tanlaydi."}, {"k": "sub", "t0": 90.741, "t1": 92.281, "text": "Shahar atrofida mustahkam"}, {"k": "sub", "t0": 92.301, "t1": 93.581, "text": "devorlar qurdiradi."}, {"k": "sub", "t0": 94.116, "t1": 96.776, "text": "Xon emas, lekin xondan kuchli."}, {"k": "sub", "t0": 97.116, "t1": 98.996, "text": "Temur endi Movarounnahrning"}, {"k": "sub", "t0": 99.016, "t1": 100.536, "text": "haqiqiy hukmdori edi."}, {"k": "sub", "t0": 100.866, "t1": 102.026, "text": "Lekin bu hokimiyatni"}, {"k": "sub", "t0": 102.046, "t1": 103.326, "text": "saqlab qolish uchun u"}, {"k": "sub", "t0": 103.346, "t1": 104.906, "text": "hali ko'p yil kurashadi."}, {"k": "sub", "t0": 105.366, "t1": 106.866, "text": "Oradan bir necha yil o'tib,"}, {"k": "sub", "t0": 106.886, "t1": 107.966, "text": "uning huzuriga bir"}, {"k": "sub", "t0": 107.986, "t1": 109.486, "text": "qochoq shahzoda keladi."}, {"k": "sub", "t0": 109.866, "t1": 111.246, "text": "Ismi To'xtamish."}, {"k": "sub", "t0": 111.741, "t1": 112.621, "text": "Temur uni quchoq"}, {"k": "sub", "t0": 112.641, "t1": 113.741, "text": "ochib kutib oladi,"}, {"k": "sub", "t0": 113.821, "t1": 115.281, "text": "himoya qiladi va xon"}, {"k": "sub", "t0": 115.301, "t1": 116.741, "text": "bo'lishiga yordam beradi."}, {"k": "sub", "t0": 117.366, "t1": 118.706, "text": "Bir kun kelib, aynan"}, {"k": "sub", "t0": 118.726, "t1": 120.326, "text": "shu odam Temurning eng"}, {"k": "sub", "t0": 120.346, "t1": 121.966, "text": "xavfli raqibiga aylanadi."}, {"k": "sub", "t0": 122.616, "t1": 123.936, "text": "O'zi xon qilgan odam"}, {"k": "sub", "t0": 123.956, "t1": 125.336, "text": "nega unga qarshi chiqdi?"}, {"k": "sub", "t0": 125.616, "t1": 126.716, "text": "Buni keyingi qismda"}, {"k": "sub", "t0": 126.736, "t1": 127.636, "text": "bilib olasiz."}]}