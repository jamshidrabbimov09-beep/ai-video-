n", "tr": "fade", "grade": "warm"}, {"t0": 83.281, "t1": 87.781, "img": "27", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 87.781, "t1": 90.781, "img": "28", "mv": "out", "tr": "dip", "grade": "warm"}, {"t0": 90.781, "t1": 94.156, "img": "29", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 94.156, "t1": 97.156, "img": "31", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 97.156, "t1": 100.906, "img": "30", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 100.906, "t1": 105.406, "img": "32", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 105.406, "t1": 108.406, "img": "33", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 108.406, "t1": 111.781, "img": "34", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 111.781, "t1": 117.406, "img": "35", "mv": "out", "tr": "fade", "grade": "warm"}, {"t0": 117.406, "t1": 122.656, "img": "36", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 122.656, "t1": 125.656, "img": "01", "mv": "in2", "tr": "fade", "grade": "cold"}, {"t0": 125.656, "t1": 129.691, "img": null, "mv": "none", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.3, "text": "3-QISM"}, {"k": "date", "t0": 15.031, "t1": 19.231, "text": "1370", "sub": "BAHOR. BALX", "sub_t": 1.76}, {"k": "name", "t0": 57.781, "t1": 61.181, "text": "SUYURG'ATMISH", "sub": "qo'g'irchoq xon", "sub_t": 0.5}, {"k": "name", "t0": 74.941, "t1": 78.541, "text": "SAROYMULKXONIM", "sub": "Chingiziy malika", "sub_t": 0.5}, {"k": "title", "t0": 83.656, "t1": 87.256, "text": "KO'RAGON", "sub": "xon kuyovi", "sub_t": 0.5}, {"k": "name", "t0": 112.156, "t1": 115.356, "text": "TO'XTAMISH"}, {"k": "end", "t0": 125.881, "t1": 129.691, "text": "KEYINGI QISMDA", "sub": "@unutilgan_qissalar"}, {"k": "bars", "t0": 18.781, "t1": 20.401}, {"k": "bars", "t0": 117.781, "t1": 125.891}, {"k": "sub", "t0": 0.366, "t1": 2.246, "text": "U ulkan saltanat qurdi,"}, {"k": "sub", "t0": 3.046, "t1": 4.686, "text": "lekin umrining oxirigacha"}, {"k": "sub", "t0": 4.706, "t1": 6.406, "text": "o'zini xon deb atamadi."}, {"k": "sub", "t0": 6.741, "t1": 7.301, "text": "Nega?"}, {"k": "sub", "t0": 7.866, "t1": 9.026, "text": "Chunki bunga uning"}, {"k": "sub", "t0": 9.046, "t1": 10.086, "text": "haqqi yo'q edi."}, {"k": "sub", "t0": 10.491, "t1": 12.411, "text": "Bu Amir Temur hokimiyatni"}, {"k": "sub", "t0": 12.431, "t1": 13.531, "text": "qanday qo'lga olgani"}, {"k": "sub", "t0": 13.551, "t1": 14.631, "text": "haqidagi qissa."}, {"k": "sub", "t0": 18.741, "t1": 20.321, "text": "Amir Husayn endi yo'q."}, {"k": "sub", "t0": 20.616, "t1": 21.776, "text": "Temurga teng keladigan"}, {"k": "sub", "t0": 21.796, "t1": 22.876, "text": "raqib qolmadi."}, {"k": "sub", "t0": 23.241, "t1": 24.201, "text": "Chig'atoy ulusining"}, {"k": "sub", "t0": 24.221, "t1": 25.201, "text": "amirlari Balxda"}, {"k": "sub", "t0": 25.221, "t1": 27.161, "text": "to'planadi va Temurni o'z"}, {"k": "sub", "t0": 27.181, "t1": 28.621, "text": "yetakchisi deb tan oladi."}, {"k": "sub", "t0": 29.241, "t1": 30.441, "text": "Go'yo hammasi hal"}, {"k": "sub", "t0": 30.461, "t1": 31.501, "text": "bo'lgandek edi,"}, {"k": "sub", "t0": 31.701, "t1": 33.621, "text": "lekin bitta to'siq bor edi."}, {"k": "sub", "t0": 34.116, "t1": 35.556, "text": "Chingizxon zamonidan beri"}, {"k": "sub", "t0": 35.576, "t1": 37.076, "text": "bir qoida amal qilardi."}, {"k": "sub", "t0": 37.491, "t1": 38.371, "text": "Xon faqat"}, {"k": "sub", "t0": 38.391, "t1": 39.951, "text": "Chingiz avlodidan bo'ladi."}, {"k": "sub", "t0": 40.491, "t1": 41.831, "text": "Temur esa barlos"}, {"k": "sub", "t0": 41.851, "t1": 42.731, "text": "urug'idan edi."}, {"k": "sub", "t0": 43.116, "t1": 44.116, "text": "Lashkari bor,"}, {"k": "sub", "t0": 44.156, "t1": 45.816, "text": "kuchi bor, ammo xon"}, {"k": "sub", "t0": 45.836, "t1": 47.156, "text": "bo'lishga haqqi yo'q."}, {"k": "sub", "t0": 47.616, "t1": 49.356, "text": "Temur bu qoidani buzmadi."}, {"k": "sub", "t0": 49.866, "t1": 51.346, "text": "U boshqa yo'l topdi."}, {"k": "sub", "t0": 51.741, "t1": 53.241, "text": "Balxga yetmasdanoq u"}, {"k": "sub", "t0": 53.261, "t1": 54.781, "text": "Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 54.801, "t1": 56.021, "text": "Suyurg'atmishni xon"}, {"k": "sub", "t0": 56.041, "t1": 57.161, "text": "qilib ko'targan edi."}, {"k": "sub", "t0": 57.741, "t1": 59.161, "text": "Xon taxtda o'tiradi,"}, {"k": "sub", "t0": 59.301, "t1": 60.221, "text": "Temur esa uning"}, {"k": "sub", "t0": 60.241, "t1": 61.761, "text": "nomidan hukm yuritadi."}, {"k": "sub", "t0": 62.241, "t1": 64.421, "text": "Aslida xon faqat nom edi."}, {"k": "sub", "t0": 64.866, "t1": 65.946, "text": "Butun hokimiyat"}, {"k": "sub", "t0": 65.966, "t1": 67.286, "text": "Temurning qo'lida edi."}, {"k": "sub", "t0": 67.866, "t1": 68.946, "text": "Ikkinchi qadam."}, {"k": "sub", "t0": 69.366, "t1": 71.516, "text": "Temur Saroymulkxonimga uylanadi."}, {"k": "sub", "t0": 71.991, "t1": 73.531, "text": "U Chingiz avlodidan bo'lgan"}, {"k": "sub", "t0": 73.551, "t1": 75.231, "text": "Qozonxonning qizi va"}, {"k": "sub", "t0": 75.251, "t1": 77.071, "text": "Amir Husaynning bevasi edi."}, {"k": "sub", "t0": 77.616, "t1": 78.876, "text": "Shu nikoh bilan Temur"}, {"k": "sub", "t0": 78.896, "t1": 80.216, "text": "yangi unvon oladi."}, {"k": "sub", "t0": 80.616, "t1": 83.186, "text": "Ko'ragon, ya'ni xon kuyovi."}, {"k": "sub", "t0": 83.616, "t1": 84.606, "text": "O'zi esa umrining"}, {"k": "sub", "t0": 84.626, "t1": 85.476, "text": "oxirigacha bitta"}, {"k": "sub", "t0": 85.496, "t1": 86.556, "text": "unvon bilan qoladi."}, {"k": "sub", "t0": 86.991, "t1": 87.491, "text": "Amir."}, {"k": "sub", "t0": 88.116, "t1": 89.156, "text": "Poytaxt qilib u"}, {"k": "sub", "t0": 89.176, "t1": 90.596, "text": "Samarqandni tanlaydi."}, {"k": "sub", "t0": 91.116, "t1": 92.656, "text": "Shahar atrofida mustahkam"}, {"k": "sub", "t0": 92.676, "t1": 93.956, "text": "devorlar qurdiradi."}, {"k": "sub", "t0": 94.491, "t1": 97.151, "text": "Xon emas, lekin xondan kuchli."}, {"k": "sub", "t0": 97.491, "t1": 99.371, "text": "Temur endi Movarounnahrning"}, {"k": "sub", "t0": 99.391, "t1": 100.911, "text": "haqiqiy hukmdori edi."}, {"k": "sub", "t0": 101.241, "t1": 102.401, "text": "Lekin bu hokimiyatni"}, {"k": "sub", "t0": 102.421, "t1": 103.701, "text": "saqlab qolish uchun u"}, {"k": "sub", "t0": 103.721, "t1": 105.281, "text": "hali ko'p yil kurashadi."}, {"k": "sub", "t0": 105.741, "t1": 107.241, "text": "Oradan bir necha yil o'tib,"}, {"k": "sub", "t0": 107.261, "t1": 108.341, "text": "uning huzuriga bir"}, {"k": "sub", "t0": 108.361, "t1": 109.861, "text": "qochoq shahzoda keladi."}, {"k": "sub", "t0": 110.241, "t1": 111.621, "text": "Ismi To'xtamish."}, {"k": "sub", "t0": 112.116, "t1": 112.996, "text": "Temur uni quchoq"}, {"k": "sub", "t0": 113.016, "t1": 114.116, "text": "ochib kutib oladi,"}, {"k": "sub", "t0": 114.196, "t1": 115.656, "text": "himoya qiladi va xon"}, {"k": "sub", "t0": 115.676, "t1": 117.116, "text": "bo'lishiga yordam beradi."}, {"k": "sub", "t0": 117.741, "t1": 119.081, "text": "Bir kun kelib, aynan"}, {"k": "sub", "t0": 119.101, "t1": 120.701, "text": "shu odam Temurning eng"}, {"k": "sub", "t0": 120.721, "t1": 122.341, "text": "xavfli raqibiga aylanadi."}, {"k": "sub", "t0": 122.991, "t1": 124.311, "text": "O'zi xon qilgan odam"}, {"k": "sub", "t0": 124.331, "t1": 125.711, "text": "nega unga qarshi chiqdi?"}, {"k": "sub", "t0": 125.991, "t1": 127.091, "text": "Buni keyingi qismda"}, {"k": "sub", "t0": 127.111, "t1": 128.011, "text": "bilib olasiz."}]}