I"}, {"k": "tag", "t0": 6.1, "t1": 11.08, "text": "7-QISM"}, {"k": "date", "t0": 11.4, "t1": 12.72, "text": "17", "sub": "DEKABR", "sub_t": 0.6}, {"k": "date", "t0": 56.36, "t1": 58.94, "text": "1399", "sub": "BAHOR", "sub_t": 1.48}, {"k": "name", "t0": 68.46, "t1": 71.3, "text": "BOYAZID", "sub": "USMONLI SULTONI", "sub_t": 0.0}, {"k": "q", "t0": 71.3, "t1": 76.59, "pop": 37}, {"k": "subend", "t0": 76.59, "t1": 79.79, "text": "TEZ ORADA 8-QISM"}, {"k": "bars", "t0": 32.16, "t1": 36.3}, {"k": "bars", "t0": 42.26, "t1": 51.58}, {"k": "sub", "t0": 6.26, "t1": 7.56, "text": "Oldingi qismda Dehli"}, {"k": "sub", "t0": 7.58, "t1": 9.34, "text": "ostonasida Temurga qarshi"}, {"k": "sub", "t0": 9.36, "t1": 11.0, "text": "yuz yigirma fil chiqqan edi."}, {"k": "sub", "t0": 12.92, "t1": 14.42, "text": "Fillar oldinga yuradi."}, {"k": "sub", "t0": 14.7, "t1": 16.1, "text": "Shahzoda Pir Muhammad"}, {"k": "sub", "t0": 16.12, "t1": 16.8, "text": "birinchi bo'lib"}, {"k": "sub", "t0": 16.82, "t1": 18.0, "text": "filga qilich uradi."}, {"k": "sub", "t0": 18.22, "t1": 19.5, "text": "Askarlar fil ustidagi"}, {"k": "sub", "t0": 19.52, "t1": 20.74, "text": "kamonchilarni kamondan"}, {"k": "sub", "t0": 20.76, "t1": 21.62, "text": "otib tushiradi."}, {"k": "sub", "t0": 21.7, "t1": 22.78, "text": "Fillarning xartumini"}, {"k": "sub", "t0": 22.8, "t1": 23.9, "text": "qilich bilan chopadi."}, {"k": "sub", "t0": 24.16, "t1": 25.82, "text": "Hind qo'shini chekinadi."}, {"k": "sub", "t0": 25.98, "t1": 27.28, "text": "Temurning nevarasi Xalil"}, {"k": "sub", "t0": 27.3, "t1": 29.16, "text": "Sulton bitta filni xuddi"}, {"k": "sub", "t0": 29.18, "t1": 30.8, "text": "sigirdek haydab bobosining"}, {"k": "sub", "t0": 30.82, "t1": 31.94, "text": "oldiga olib keladi."}, {"k": "sub", "t0": 32.12, "t1": 33.82, "text": "O'sha kechasi Sulton Mahmud"}, {"k": "sub", "t0": 33.84, "t1": 35.32, "text": "va Mallu Xon shahardan"}, {"k": "sub", "t0": 35.34, "t1": 36.22, "text": "qochib ketadi."}, {"k": "sub", "t0": 36.72, "t1": 38.34, "text": "Dehli taslim bo'ladi,"}, {"k": "sub", "t0": 38.62, "t1": 39.32, "text": "lekin bir necha"}, {"k": "sub", "t0": 39.34, "t1": 40.6, "text": "kundan keyin shaharda"}, {"k": "sub", "t0": 40.62, "t1": 42.02, "text": "to'qnashuvlar boshlanadi."}, {"k": "sub", "t0": 42.22, "t1": 44.3, "text": "Askarlar Dehlini talab,"}, {"k": "sub", "t0": 44.46, "t1": 45.48, "text": "yoqib yuboradi."}, {"k": "sub", "t0": 45.7, "t1": 46.9, "text": "Tarixchilar fikricha,"}, {"k": "sub", "t0": 46.92, "t1": 48.32, "text": "bu Temur o'z qo'shinini"}, {"k": "sub", "t0": 48.34, "t1": 49.94, "text": "to'xtata olmagan kamdan-kam"}, {"k": "sub", "t0": 49.96, "t1": 51.4, "text": "holatlardan biri edi."}, {"k": "sub", "t0": 51.66, "t1": 53.26, "text": "Fillar Samarqand,"}, {"k": "sub", "t0": 53.28, "t1": 54.82, "text": "Hirot, Tabriz va"}, {"k": "sub", "t0": 54.84, "t1": 56.18, "text": "Sherozga jo'natiladi."}, {"k": "sub", "t0": 57.8, "t1": 58.88, "text": "bahorida ular"}, {"k": "sub", "t0": 58.9, "t1": 60.3, "text": "Samarqandga kirib keladi."}, {"k": "sub", "t0": 60.44, "t1": 62.22, "text": "Shahar xalqi filni umrida"}, {"k": "sub", "t0": 62.24, "t1": 63.82, "text": "birinchi marta ko'rib turardi,"}, {"k": "sub", "t0": 64.0, "t1": 65.52, "text": "lekin Temur Samarqandda"}, {"k": "sub", "t0": 65.54, "t1": 66.58, "text": "uzoq qolmadi."}, {"k": "sub", "t0": 66.76, "t1": 68.4, "text": "G'arbda Usmonli sultoni"}, {"k": "sub", "t0": 68.42, "t1": 69.94, "text": "Boyazid kuchayib borardi."}, {"k": "sub", "t0": 70.16, "t1": 71.22, "text": "Keyingi qismda."}, {"k": "sub", "t0": 71.46, "t1": 72.08, "text": "Siz-chi?"}, {"k": "sub", "t0": 72.28, "t1": 73.1, "text": "Fil ustida turib"}, {"k": "sub", "t0": 73.12, "t1": 74.28, "text": "jang qilarmidingiz?"}, {"k": "sub", "t0": 74.44, "t1": 76.46, "text": "Ha yoki yo'q izohda yozing."}]}