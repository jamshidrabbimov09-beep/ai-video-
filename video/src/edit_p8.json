 "SULTON", "sub": "ASIRDA", "y": 760}, {"k": "timeline", "t0": 0.0, "t1": 4.2, "year": 1402}, {"k": "countdown", "t0": 119.06, "t1": 125.9, "text": "2 YIL 7 OY"}, {"k": "q", "t0": 125.92, "t1": 132.39, "pop": 75}, {"k": "subend", "t0": 132.39, "t1": 135.59, "text": "KEYINGI QISM: ELCHI"}, {"k": "bars", "t0": 0, "t1": 16.88}, {"k": "bars", "t0": 93.28, "t1": 106.38}, {"k": "bars", "t0": 113.96, "t1": 118.62}, {"k": "sub", "t0": 3.86, "t1": 5.1, "text": "Temurning chodiriga"}, {"k": "sub", "t0": 5.4, "t1": 6.54, "text": "qo'llari bog'langan bir"}, {"k": "sub", "t0": 6.56, "t1": 7.78, "text": "odamni olib kirishadi."}, {"k": "sub", "t0": 8.259, "t1": 10.14, "text": "Bu Usmonli sultoni"}, {"k": "sub", "t0": 10.18, "t1": 12.56, "text": "Boyazid laqabi Yildirim,"}, {"k": "sub", "t0": 12.72, "t1": 14.04, "text": "ya'ni Chaqmoq."}, {"k": "sub", "t0": 14.28, "t1": 16.8, "text": "Endi Temur uni nima qiladi?"}, {"k": "sub", "t0": 17.98, "t1": 18.74, "text": "Oldingi qismda"}, {"k": "sub", "t0": 18.76, "t1": 19.9, "text": "Temur Hindistondan"}, {"k": "sub", "t0": 19.92, "t1": 21.14, "text": "fillar bilan qaytdi."}, {"k": "sub", "t0": 21.3, "t1": 22.8, "text": "Endi g'arbda Boyazid"}, {"k": "sub", "t0": 22.82, "t1": 23.86, "text": "kuchayib borardi."}, {"k": "sub", "t0": 24.0, "t1": 25.54, "text": "Temur unga maktub yozadi."}, {"k": "sub", "t0": 25.64, "t1": 26.98, "text": "Chegarangdan oshma"}, {"k": "sub", "t0": 27.12, "t1": 28.18, "text": "Boyazid kibr bilan"}, {"k": "sub", "t0": 28.2, "t1": 29.22, "text": "javob qaytaradi."}, {"k": "sub", "t0": 29.3, "t1": 31.12, "text": "Agar u kelmasa, men o'zim"}, {"k": "sub", "t0": 31.14, "t1": 32.32, "text": "Tabrizgacha boraman."}, {"k": "sub", "t0": 32.479, "t1": 34.1, "text": "Temurning amirlari Anado'luga"}, {"k": "sub", "t0": 34.12, "t1": 35.4, "text": "yurishga ikkilanardi,"}, {"k": "sub", "t0": 35.54, "t1": 36.8, "text": "lekin Temur baribir"}, {"k": "sub", "t0": 36.82, "t1": 37.66, "text": "yo'lga chiqadi."}, {"k": "sub", "t0": 37.76, "t1": 39.24, "text": "Boyazid katta qo'shin bilan"}, {"k": "sub", "t0": 39.26, "t1": 40.58, "text": "o'rmonli tor yo'llarda"}, {"k": "sub", "t0": 40.6, "t1": 41.7, "text": "uni kutib turardi."}, {"k": "sub", "t0": 41.8, "t1": 43.76, "text": "Temur esa u yerga bormaydi."}, {"k": "sub", "t0": 43.9, "t1": 45.0, "text": "U aylanib o'tib,"}, {"k": "sub", "t0": 45.02, "t1": 46.58, "text": "to'g'ri Anqaraga yuradi."}, {"k": "sub", "t0": 46.72, "t1": 47.56, "text": "Temur deydi."}, {"k": "sub", "t0": 47.7, "t1": 49.5, "text": "Uning askarlari ko'pi piyoda."}, {"k": "sub", "t0": 49.66, "t1": 50.44, "text": "Ortimizdan yetib"}, {"k": "sub", "t0": 50.46, "t1": 52.1, "text": "kelguncha holdan toyadi."}, {"k": "sub", "t0": 52.2, "t1": 53.44, "text": "Qo'shin yo'l yo'lakay"}, {"k": "sub", "t0": 53.46, "t1": 54.66, "text": "quduq qazib boradi."}, {"k": "sub", "t0": 54.8, "t1": 55.7, "text": "Anqara yonida"}, {"k": "sub", "t0": 55.72, "t1": 57.22, "text": "Temur qarorgoh quradi."}, {"k": "sub", "t0": 57.38, "t1": 58.36, "text": "Dushman tomondagi"}, {"k": "sub", "t0": 58.38, "t1": 59.64, "text": "kichik buloqni esa"}, {"k": "sub", "t0": 59.82, "t1": 60.88, "text": "yog'och bilan to'ldirib"}, {"k": "sub", "t0": 60.9, "t1": 62.02, "text": "tashlashni buyuradi."}, {"k": "sub", "t0": 62.26, "t1": 63.8, "text": "Jazirama iyul"}, {"k": "sub", "t0": 63.94, "t1": 64.92, "text": "charchagan Usmonli"}, {"k": "sub", "t0": 64.94, "t1": 66.4, "text": "qo'shini yetib keladi."}, {"k": "sub", "t0": 66.6, "t1": 67.56, "text": "Ertalab ikki"}, {"k": "sub", "t0": 67.58, "t1": 68.94, "text": "qo'shin saf tortadi."}, {"k": "sub", "t0": 69.0, "t1": 70.22, "text": "Temur fillariga sovut"}, {"k": "sub", "t0": 70.24, "t1": 71.36, "text": "kiydiradi, ustiga"}, {"k": "sub", "t0": 71.38, "t1": 72.78, "text": "kamonchilarni o'tqazadi."}, {"k": "sub", "t0": 72.86, "t1": 73.84, "text": "Boyazid tomonida"}, {"k": "sub", "t0": 73.86, "t1": 75.2, "text": "boshdan oyoq qora temir"}, {"k": "sub", "t0": 75.22, "t1": 76.44, "text": "sovutdagi yevropalik"}, {"k": "sub", "t0": 76.46, "t1": 77.56, "text": "otliqlar turardi."}, {"k": "sub", "t0": 77.64, "t1": 78.5, "text": "Ulardan faqat"}, {"k": "sub", "t0": 78.52, "t1": 79.7, "text": "ko'zlari ko'rinardi."}, {"k": "sub", "t0": 79.9, "t1": 81.26, "text": "Ular qattiq turadi,"}, {"k": "sub", "t0": 81.38, "t1": 83.56, "text": "lekin oxiri ular ham chekinadi."}, {"k": "sub", "t0": 83.66, "t1": 84.58, "text": "Boyazid tepalikka"}, {"k": "sub", "t0": 84.6, "t1": 85.42, "text": "chiqib qaraydi."}, {"k": "sub", "t0": 85.44, "t1": 87.06, "text": "Qo'shini tarqalib ketgan edi."}, {"k": "sub", "t0": 87.14, "t1": 88.5, "text": "U kechgacha jang qiladi,"}, {"k": "sub", "t0": 88.52, "t1": 89.38, "text": "keyin qurshovni"}, {"k": "sub", "t0": 89.4, "t1": 90.32, "text": "yorib qochadi."}, {"k": "sub", "t0": 90.34, "t1": 91.58, "text": "Temurning bahodirlaridan"}, {"k": "sub", "t0": 91.6, "t1": 93.14, "text": "biri uni quvib yetadi."}, {"k": "sub", "t0": 93.24, "t1": 94.26, "text": "Temur buyuradi."}, {"k": "sub", "t0": 94.34, "t1": 95.38, "text": "Qo'llarini yeching,"}, {"k": "sub", "t0": 95.42, "t1": 96.76, "text": "hurmat bilan olib kiring."}, {"k": "sub", "t0": 96.84, "t1": 98.32, "text": "Uni ro'parasiga o'tqazadi."}, {"k": "sub", "t0": 98.5, "t1": 99.14, "text": "Seni necha"}, {"k": "sub", "t0": 99.16, "t1": 100.4, "text": "marta ogohlantirdim."}, {"k": "sub", "t0": 100.44, "t1": 101.46, "text": "Quloq solmading,"}, {"k": "sub", "t0": 101.6, "t1": 103.42, "text": "lekin menga g'alaba berildi."}, {"k": "sub", "t0": 103.56, "t1": 105.04, "text": "Senga yaxshilikdan boshqa"}, {"k": "sub", "t0": 105.06, "t1": 106.3, "text": "hech narsa qilmayman."}, {"k": "sub", "t0": 106.44, "t1": 108.46, "text": "Boyazid xatosini tan oladi."}, {"k": "sub", "t0": 108.6, "t1": 109.86, "text": "Temur unga shohona"}, {"k": "sub", "t0": 109.88, "t1": 110.96, "text": "to'n kiydiradi va"}, {"k": "sub", "t0": 110.98, "t1": 112.48, "text": "yo'qolgan o'g'lini topib"}, {"k": "sub", "t0": 112.5, "t1": 113.64, "text": "oldiga olib keladi."}, {"k": "sub", "t0": 113.92, "t1": 115.58, "text": "Lekin Boyazid bir"}, {"k": "sub", "t0": 115.6, "t1": 116.86, "text": "necha oydan keyin"}, {"k": "sub", "t0": 116.88, "t1": 118.44, "text": "asirlikda vafot etdi."}, {"k": "sub", "t0": 119.02, "t1": 121.02, "text": "Ertaga uzoq Ispaniyadan"}, {"k": "sub", "t0": 121.04, "t1": 122.42, "text": "bir elchi Samarqandga"}, {"k": "sub", "t0": 122.44, "t1": 123.26, "text": "yetib keladi."}, {"k": "sub", "t0": 123.66, "t1": 124.96, "text": "U Temurni o'z ko'zi"}, {"k": "sub", "t0": 124.98, "t1": 125.82, "text": "bilan ko'radi."}, {"k": "sub", "t0": 126.08, "t1": 128.16, "text": "Siz-chi, Temurning o'rnida"}, {"k": "sub", "t0": 128.18, "t1": 129.8, "text": "Boyazidni kechirarmidingiz?"}, {"k": "sub", "t0": 130.139, "t1": 132.26, "text": "Ha yoki yo'q izohda yozing."}]}