}, {"t0": 83.212, "t1": 86.542, "img": "23", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 86.542, "t1": 92.24, "img": "mo:flank", "mv": "none", "tr": "dip", "grade": "warm"}, {"t0": 92.24, "t1": 95.38, "img": "26", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 95.38, "t1": 98.52, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 98.52, "t1": 103.06, "img": "mo:pursuit", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 103.06, "t1": 105.86, "img": "28", "mv": "panR", "tr": "fade", "grade": "cold"}, {"t0": 105.86, "t1": 110.08, "img": "29", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 110.08, "t1": 113.5, "img": "30", "mv": "in", "tr": "dip", "grade": "cold"}, {"t0": 113.5, "t1": 115.81, "img": "31", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 115.81, "t1": 118.8, "img": "mo:terek", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 118.8, "t1": 123.37, "img": "32", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 123.37, "t1": 127.94, "img": "mo:fall", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 127.94, "t1": 131.84, "img": "40", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 131.84, "t1": 135.051, "img": "33", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 135.051, "t1": 138.203, "img": "34", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 138.203, "t1": 142.623, "img": "mo:south", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 142.623, "t1": 148.659, "img": "35", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 148.659, "t1": 158.206, "img": "16", "mv": "inslow", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.0, "text": "5-QISM"}, {"k": "date", "t0": 13.7, "t1": 15.86, "text": "1391", "sub": "YIL BOSHI", "sub_t": 1.52}, {"k": "name", "t0": 56.58, "t1": 59.18, "text": "ULUG' TOG'"}, {"k": "date", "t0": 69.06, "t1": 72.28, "text": "1391", "sub": "18-IYUN", "sub_t": 1.78}, {"k": "date", "t0": 113.92, "t1": 115.8, "text": "1395"}, {"k": "q", "t0": 148.896, "t1": 155.406, "pop": 39}, {"k": "subend", "t0": 155.406, "t1": 158.206}, {"k": "bars", "t0": 0.1, "t1": 12.38}, {"k": "bars", "t0": 128.58, "t1": 134.88}, {"k": "bars", "t0": 142.883, "t1": 148.623}, {"k": "sub", "t0": 0.36, "t1": 2.799, "text": "Olti oy, cheksiz dasht,"}, {"k": "sub", "t0": 3.3, "t1": 5.3, "text": "suv yo'q, non yo'q,"}, {"k": "sub", "t0": 5.6, "t1": 7.3, "text": "kechasi esa deyarli"}, {"k": "sub", "t0": 7.32, "t1": 8.4, "text": "qorong'i tushmaydi."}, {"k": "sub", "t0": 8.7, "t1": 9.92, "text": "Temur qo'shini To'xtamishni"}, {"k": "sub", "t0": 9.94, "t1": 11.18, "text": "izlab dunyoning"}, {"k": "sub", "t0": 11.2, "t1": 12.3, "text": "chetigacha boradi."}, {"k": "sub", "t0": 15.98, "t1": 16.62, "text": "Temur yurishga"}, {"k": "sub", "t0": 16.64, "t1": 18.14, "text": "otlanganda To'xtamishdan"}, {"k": "sub", "t0": 18.16, "t1": 19.18, "text": "elchilar keladi."}, {"k": "sub", "t0": 19.34, "t1": 20.8, "text": "Ular to'qqizta ot va"}, {"k": "sub", "t0": 20.82, "t1": 22.32, "text": "bitta lochin olib kelgan."}, {"k": "sub", "t0": 22.44, "t1": 23.34, "text": "To'xtamish kechirim"}, {"k": "sub", "t0": 23.36, "t1": 24.58, "text": "so'raydi: \"Temur"}, {"k": "sub", "t0": 24.6, "t1": 25.76, "text": "menga otadek edi."}, {"k": "sub", "t0": 25.92, "t1": 27.56, "text": "Bu ishlarni mendan bexabar"}, {"k": "sub", "t0": 27.58, "t1": 28.84, "text": "yomon odamlar qildi\"."}, {"k": "sub", "t0": 29.06, "t1": 30.34, "text": "Temur javob beradi:"}, {"k": "sub", "t0": 30.48, "t1": 31.42, "text": "\"Uni yarador holda"}, {"k": "sub", "t0": 31.44, "t1": 32.52, "text": "olib kelishganda"}, {"k": "sub", "t0": 32.54, "t1": 33.92, "text": "o'g'limdek qabul qildim."}, {"k": "sub", "t0": 34.14, "t1": 36.16, "text": "Endi unga ishonib bo'lmaydi\"."}, {"k": "sub", "t0": 36.98, "t1": 38.44, "text": "Qo'shin dashtga kiradi."}, {"k": "sub", "t0": 38.62, "t1": 40.26, "text": "Uch hafta suvsiz yurish."}, {"k": "sub", "t0": 40.38, "t1": 41.92, "text": "Otlar holdan toyadi."}, {"k": "sub", "t0": 42.12, "t1": 44.08, "text": "Keyin ochlik boshlanadi."}, {"k": "sub", "t0": 44.3, "t1": 45.02, "text": "Bitta qo'chqor"}, {"k": "sub", "t0": 45.04, "t1": 46.22, "text": "kallasining narxi"}, {"k": "sub", "t0": 46.38, "t1": 47.74, "text": "besh yuz tangaga chiqadi."}, {"k": "sub", "t0": 47.92, "t1": 49.42, "text": "Askarlar qush tuxumi"}, {"k": "sub", "t0": 49.44, "t1": 50.52, "text": "va yovvoyi giyohlar"}, {"k": "sub", "t0": 50.54, "t1": 51.58, "text": "bilan kun ko'radi."}, {"k": "sub", "t0": 51.74, "t1": 53.7, "text": "Temur katta ov uyushtiradi"}, {"k": "sub", "t0": 53.78, "t1": 55.02, "text": "va qo'shin ov go'shti"}, {"k": "sub", "t0": 55.04, "t1": 56.34, "text": "bilan omon qoladi."}, {"k": "sub", "t0": 56.54, "t1": 58.02, "text": "Ulug' tog' degan joyda"}, {"k": "sub", "t0": 58.04, "t1": 59.24, "text": "Temur cho'qqiga chiqib"}, {"k": "sub", "t0": 59.26, "t1": 60.88, "text": "yam-yashil dashtga qaraydi."}, {"k": "sub", "t0": 61.02, "t1": 63.06, "text": "Askarlarga tosh tashishni buyuradi."}, {"k": "sub", "t0": 63.16, "t1": 63.98, "text": "Ular baland"}, {"k": "sub", "t0": 64.0, "t1": 65.34, "text": "tosh minora qurishadi."}, {"k": "sub", "t0": 65.42, "t1": 66.96, "text": "Temur deydi: \"Bizdan"}, {"k": "sub", "t0": 66.98, "t1": 68.24, "text": "yodgorlik bo'lsin\"."}, {"k": "sub", "t0": 72.24, "t1": 73.5, "text": "Qunduzcha degan joyda"}, {"k": "sub", "t0": 73.52, "t1": 75.36, "text": "ikki qo'shin yuzma-yuz keladi."}, {"k": "sub", "t0": 75.48, "t1": 77.18, "text": "Dushman qo'shini ko'proq edi."}, {"k": "sub", "t0": 77.3, "t1": 78.86, "text": "Temur qo'shinini yetti qismga"}, {"k": "sub", "t0": 78.88, "t1": 80.08, "text": "bo'lib saf tortadi,"}, {"k": "sub", "t0": 80.16, "t1": 81.9, "text": "keyin hammaga otdan tushib"}, {"k": "sub", "t0": 81.92, "t1": 83.28, "text": "chodir tikishni buyuradi."}, {"k": "sub", "t0": 83.323, "t1": 84.223, "text": "To'xtamish hayron"}, {"k": "sub", "t0": 84.243, "t1": 85.243, "text": "qoladi: \"Ular"}, {"k": "sub", "t0": 85.263, "t1": 86.483, "text": "bizdan cho'chimaydimi?\""}, {"k": "sub", "t0": 86.78, "t1": 87.84, "text": "Jang boshlanadi."}, {"k": "sub", "t0": 87.86, "t1": 88.92, "text": "To'xtamish oldindan"}, {"k": "sub", "t0": 88.94, "t1": 90.08, "text": "yenga olmay, aylanib"}, {"k": "sub", "t0": 90.1, "t1": 91.24, "text": "o'tib Temur qo'shinining"}, {"k": "sub", "t0": 91.26, "t1": 92.26, "text": "orqasiga chiqadi,"}, {"k": "sub", "t0": 92.3, "t1": 93.82, "text": "lekin Temurning o'zi unga"}, {"k": "sub", "t0": 93.84, "t1": 95.38, "text": "qarab otlanganini ko'rgach,"}, {"k": "sub", "t0": 95.44, "t1": 96.72, "text": "chiday olmaydi va"}, {"k": "sub", "t0": 96.74, "t1": 98.58, "text": "jang maydonini tashlab qochadi."}, {"k": "sub", "t0": 98.64, "t1": 100.34, "text": "Temur askarlari qochganlarni"}, {"k": "sub", "t0": 100.36, "t1": 101.52, "text": "Itil, ya'ni Volga"}, {"k": "sub", "t0": 101.54, "t1": 103.12, "text": "daryosigacha quvib boradi."}, {"k": "sub", "t0": 103.18, "t1": 104.66, "text": "Oldinda keng daryo,"}, {"k": "sub", "t0": 104.76, "t1": 105.88, "text": "orqada qilich."}, {"k": "sub", "t0": 106.02, "t1": 107.18, "text": "Jo'chi ulusi tarqalib"}, {"k": "sub", "t0": 107.2, "t1": 108.62, "text": "ketadi, lekin"}, {"k": "sub", "t0": 108.64, "t1": 110.02, "text": "To'xtamish tirik qoldi."}, {"k": "sub", "t0": 110.32, "t1": 111.7, "text": "Uch yil o'tib u yana"}, {"k": "sub", "t0": 111.72, "t1": 113.3, "text": "Kavkazga bostirib kiradi."}, {"k": "sub", "t0": 116.08, "t1": 117.26, "text": "Terek daryosi bo'yida"}, {"k": "sub", "t0": 117.28, "t1": 118.7, "text": "ular yana to'qnashadi."}, {"k": "sub", "t0": 119.08, "t1": 120.06, "text": "To'xtamish yana"}, {"k": "sub", "t0": 120.08, "t1": 121.86, "text": "yengiladi va taxtidan"}, {"k": "sub", "t0": 121.88, "t1": 123.2, "text": "butunlay ayriladi."}, {"k": "sub", "t0": 123.72, "t1": 124.88, "text": "Oltin O'rda bu"}, {"k": "sub", "t0": 124.9, "t1": 126.2, "text": "zarbadan hech qachon"}, {"k": "sub", "t0": 126.22, "t1": 127.52, "text": "o'ziga kela olmadi."}, {"k": "sub", "t0": 128.54, "t1": 129.9, "text": "Temur o'z qo'li bilan"}, {"k": "sub", "t0": 129.92, "t1": 132.16, "text": "qutqargan odam o'sha"}, {"k": "sub", "t0": 132.18, "t1": 133.3, "text": "Temurning qo'lida"}, {"k": "sub", "t0": 133.32, "t1": 134.7, "text": "saltanatini yo'qotdi."}, {"k": "sub", "t0": 135.583, "t1": 136.903, "text": "Shimoldagi eng xavfli"}, {"k": "sub", "t0": 136.923, "t1": 138.123, "text": "dushman yengildi."}, {"k": "sub", "t0": 138.463, "t1": 139.783, "text": "Endi Temurning ko'zi"}, {"k": "sub", "t0": 139.803, "t1": 141.363, "text": "janubga Eron va"}, {"k": "sub", "t0": 141.383, "t1": 142.583, "text": "Hindistonga tushadi."}, {"k": "sub", "t0": 142.843, "t1": 143.943, "text": "Hindistonda uni"}, {"k": "sub", "t0": 143.963, "t1": 145.643, "text": "jangovar fillar kutardi."}, {"k": "sub", "t0": 145.883, "t1": 147.243, "text": "Bu jang qanday tugadi?"}, {"k": "sub", "t0": 147.443, "t1": 148.443, "text": "Keyingi qismda."}, {"k": "sub", "t0": 149.056, "t1": 149.676, "text": "Siz-chi,"}, {"k": "sub", "t0": 149.956, "t1": 150.856, "text": "olti oy suvsiz"}, {"k": "sub", "t0": 150.876, "t1": 152.136, "text": "dashtda Temurning"}, {"k": "sub", "t0": 152.156, "t1": 153.476, "text": "ortidan borarmidingiz?"}, {"k": "sub", "t0": 153.596, "t1": 155.276, "text": "Javobingizni izohda yozing."}]}