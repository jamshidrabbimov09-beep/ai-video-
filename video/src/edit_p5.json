{"t0": 84.13, "t1": 87.242, "img": "22", "mv": "inslow", "tr": "fade", "grade": "warm"}, {"t0": 87.242, "t1": 90.572, "img": "23", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 90.572, "t1": 96.27, "img": "mo:flank", "mv": "none", "tr": "dip", "grade": "warm"}, {"t0": 96.27, "t1": 99.41, "img": "26", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 99.41, "t1": 102.55, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 102.55, "t1": 107.09, "img": "mo:pursuit", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 107.09, "t1": 109.89, "img": "28", "mv": "panR", "tr": "fade", "grade": "cold"}, {"t0": 109.89, "t1": 114.11, "img": "29", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 114.11, "t1": 117.53, "img": "30", "mv": "in", "tr": "dip", "grade": "cold"}, {"t0": 117.53, "t1": 119.84, "img": "31", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 119.84, "t1": 122.83, "img": "mo:terek", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 122.83, "t1": 127.4, "img": "32", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 127.4, "t1": 131.97, "img": "mo:fall", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 131.97, "t1": 135.87, "img": "40", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 135.87, "t1": 139.082, "img": "33", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 139.082, "t1": 142.233, "img": "34", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 142.233, "t1": 146.653, "img": "mo:south", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 146.653, "t1": 152.689, "img": "35", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 152.689, "t1": 162.236, "img": "16", "mv": "inslow", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.0, "text": "5-QISM"}, {"k": "date", "t0": 17.73, "t1": 19.89, "text": "1391", "sub": "YIL BOSHI", "sub_t": 1.52}, {"k": "name", "t0": 60.61, "t1": 63.21, "text": "ULUG' TOG'"}, {"k": "date", "t0": 73.09, "t1": 76.31, "text": "1391", "sub": "18-IYUN", "sub_t": 1.78}, {"k": "date", "t0": 117.95, "t1": 119.83, "text": "1395"}, {"k": "q", "t0": 152.926, "t1": 159.436, "pop": 39}, {"k": "subend", "t0": 159.436, "t1": 162.236}, {"k": "bars", "t0": 0.1, "t1": 16.41}, {"k": "bars", "t0": 132.61, "t1": 138.91}, {"k": "bars", "t0": 146.913, "t1": 152.653}, {"k": "sub", "t0": 0.36, "t1": 1.08, "text": "Bitta qo'chqor"}, {"k": "sub", "t0": 1.1, "t1": 2.28, "text": "kallasining narxi"}, {"k": "sub", "t0": 2.44, "t1": 3.8, "text": "besh yuz tangaga chiqadi."}, {"k": "sub", "t0": 4.39, "t1": 6.829, "text": "Olti oy, cheksiz dasht,"}, {"k": "sub", "t0": 7.33, "t1": 9.33, "text": "suv yo'q, non yo'q,"}, {"k": "sub", "t0": 9.63, "t1": 11.33, "text": "kechasi esa deyarli"}, {"k": "sub", "t0": 11.35, "t1": 12.43, "text": "qorong'i tushmaydi."}, {"k": "sub", "t0": 12.73, "t1": 13.95, "text": "Temur qo'shini To'xtamishni"}, {"k": "sub", "t0": 13.97, "t1": 15.21, "text": "izlab dunyoning"}, {"k": "sub", "t0": 15.23, "t1": 16.33, "text": "chetigacha boradi."}, {"k": "sub", "t0": 20.01, "t1": 20.65, "text": "Temur yurishga"}, {"k": "sub", "t0": 20.67, "t1": 22.17, "text": "otlanganda To'xtamishdan"}, {"k": "sub", "t0": 22.19, "t1": 23.21, "text": "elchilar keladi."}, {"k": "sub", "t0": 23.37, "t1": 24.83, "text": "Ular to'qqizta ot va"}, {"k": "sub", "t0": 24.85, "t1": 26.35, "text": "bitta lochin olib kelgan."}, {"k": "sub", "t0": 26.47, "t1": 27.37, "text": "To'xtamish kechirim"}, {"k": "sub", "t0": 27.39, "t1": 28.61, "text": "so'raydi: \"Temur"}, {"k": "sub", "t0": 28.63, "t1": 29.79, "text": "menga otadek edi."}, {"k": "sub", "t0": 29.95, "t1": 31.59, "text": "Bu ishlarni mendan bexabar"}, {"k": "sub", "t0": 31.61, "t1": 32.87, "text": "yomon odamlar qildi\"."}, {"k": "sub", "t0": 33.09, "t1": 34.37, "text": "Temur javob beradi:"}, {"k": "sub", "t0": 34.51, "t1": 35.45, "text": "\"Uni yarador holda"}, {"k": "sub", "t0": 35.47, "t1": 36.55, "text": "olib kelishganda"}, {"k": "sub", "t0": 36.57, "t1": 37.95, "text": "o'g'limdek qabul qildim."}, {"k": "sub", "t0": 38.17, "t1": 40.19, "text": "Endi unga ishonib bo'lmaydi\"."}, {"k": "sub", "t0": 41.01, "t1": 42.47, "text": "Qo'shin dashtga kiradi."}, {"k": "sub", "t0": 42.65, "t1": 44.29, "text": "Uch hafta suvsiz yurish."}, {"k": "sub", "t0": 44.41, "t1": 45.95, "text": "Otlar holdan toyadi."}, {"k": "sub", "t0": 46.15, "t1": 48.11, "text": "Keyin ochlik boshlanadi."}, {"k": "sub", "t0": 48.33, "t1": 49.05, "text": "Bitta qo'chqor"}, {"k": "sub", "t0": 49.07, "t1": 50.25, "text": "kallasining narxi"}, {"k": "sub", "t0": 50.41, "t1": 51.77, "text": "besh yuz tangaga chiqadi."}, {"k": "sub", "t0": 51.95, "t1": 53.45, "text": "Askarlar qush tuxumi"}, {"k": "sub", "t0": 53.47, "t1": 54.55, "text": "va yovvoyi giyohlar"}, {"k": "sub", "t0": 54.57, "t1": 55.61, "text": "bilan kun ko'radi."}, {"k": "sub", "t0": 55.77, "t1": 57.73, "text": "Temur katta ov uyushtiradi"}, {"k": "sub", "t0": 57.81, "t1": 59.05, "text": "va qo'shin ov go'shti"}, {"k": "sub", "t0": 59.07, "t1": 60.37, "text": "bilan omon qoladi."}, {"k": "sub", "t0": 60.57, "t1": 62.05, "text": "Ulug' tog' degan joyda"}, {"k": "sub", "t0": 62.07, "t1": 63.27, "text": "Temur cho'qqiga chiqib"}, {"k": "sub", "t0": 63.29, "t1": 64.91, "text": "yam-yashil dashtga qaraydi."}, {"k": "sub", "t0": 65.05, "t1": 67.09, "text": "Askarlarga tosh tashishni buyuradi."}, {"k": "sub", "t0": 67.19, "t1": 68.01, "text": "Ular baland"}, {"k": "sub", "t0": 68.03, "t1": 69.37, "text": "tosh minora qurishadi."}, {"k": "sub", "t0": 69.45, "t1": 70.99, "text": "Temur deydi: \"Bizdan"}, {"k": "sub", "t0": 71.01, "t1": 72.27, "text": "yodgorlik bo'lsin\"."}, {"k": "sub", "t0": 76.27, "t1": 77.53, "text": "Qunduzcha degan joyda"}, {"k": "sub", "t0": 77.55, "t1": 79.39, "text": "ikki qo'shin yuzma-yuz keladi."}, {"k": "sub", "t0": 79.51, "t1": 81.21, "text": "Dushman qo'shini ko'proq edi."}, {"k": "sub", "t0": 81.33, "t1": 82.89, "text": "Temur qo'shinini yetti qismga"}, {"k": "sub", "t0": 82.91, "t1": 84.11, "text": "bo'lib saf tortadi,"}, {"k": "sub", "t0": 84.19, "t1": 85.93, "text": "keyin hammaga otdan tushib"}, {"k": "sub", "t0": 85.95, "t1": 87.31, "text": "chodir tikishni buyuradi."}, {"k": "sub", "t0": 87.353, "t1": 88.253, "text": "To'xtamish hayron"}, {"k": "sub", "t0": 88.273, "t1": 89.273, "text": "qoladi: \"Ular"}, {"k": "sub", "t0": 89.293, "t1": 90.513, "text": "bizdan cho'chimaydimi?\""}, {"k": "sub", "t0": 90.81, "t1": 91.87, "text": "Jang boshlanadi."}, {"k": "sub", "t0": 91.89, "t1": 92.95, "text": "To'xtamish oldindan"}, {"k": "sub", "t0": 92.97, "t1": 94.11, "text": "yenga olmay, aylanib"}, {"k": "sub", "t0": 94.13, "t1": 95.27, "text": "o'tib Temur qo'shinining"}, {"k": "sub", "t0": 95.29, "t1": 96.29, "text": "orqasiga chiqadi,"}, {"k": "sub", "t0": 96.33, "t1": 97.85, "text": "lekin Temurning o'zi unga"}, {"k": "sub", "t0": 97.87, "t1": 99.41, "text": "qarab otlanganini ko'rgach,"}, {"k": "sub", "t0": 99.47, "t1": 100.75, "text": "chiday olmaydi va"}, {"k": "sub", "t0": 100.77, "t1": 102.61, "text": "jang maydonini tashlab qochadi."}, {"k": "sub", "t0": 102.67, "t1": 104.37, "text": "Temur askarlari qochganlarni"}, {"k": "sub", "t0": 104.39, "t1": 105.55, "text": "Itil, ya'ni Volga"}, {"k": "sub", "t0": 105.57, "t1": 107.15, "text": "daryosigacha quvib boradi."}, {"k": "sub", "t0": 107.21, "t1": 108.69, "text": "Oldinda keng daryo,"}, {"k": "sub", "t0": 108.79, "t1": 109.91, "text": "orqada qilich."}, {"k": "sub", "t0": 110.05, "t1": 111.21, "text": "Jo'chi ulusi tarqalib"}, {"k": "sub", "t0": 111.23, "t1": 112.65, "text": "ketadi, lekin"}, {"k": "sub", "t0": 112.67, "t1": 114.05, "text": "To'xtamish tirik qoldi."}, {"k": "sub", "t0": 114.35, "t1": 115.73, "text": "Uch yil o'tib u yana"}, {"k": "sub", "t0": 115.75, "t1": 117.33, "text": "Kavkazga bostirib kiradi."}, {"k": "sub", "t0": 120.11, "t1": 121.29, "text": "Terek daryosi bo'yida"}, {"k": "sub", "t0": 121.31, "t1": 122.73, "text": "ular yana to'qnashadi."}, {"k": "sub", "t0": 123.11, "t1": 124.09, "text": "To'xtamish yana"}, {"k": "sub", "t0": 124.11, "t1": 125.89, "text": "yengiladi va taxtidan"}, {"k": "sub", "t0": 125.91, "t1": 127.23, "text": "butunlay ayriladi."}, {"k": "sub", "t0": 127.75, "t1": 128.91, "text": "Oltin O'rda bu"}, {"k": "sub", "t0": 128.93, "t1": 130.23, "text": "zarbadan hech qachon"}, {"k": "sub", "t0": 130.25, "t1": 131.55, "text": "o'ziga kela olmadi."}, {"k": "sub", "t0": 132.57, "t1": 133.93, "text": "Temur o'z qo'li bilan"}, {"k": "sub", "t0": 133.95, "t1": 136.19, "text": "qutqargan odam o'sha"}, {"k": "sub", "t0": 136.21, "t1": 137.33, "text": "Temurning qo'lida"}, {"k": "sub", "t0": 137.35, "t1": 138.73, "text": "saltanatini yo'qotdi."}, {"k": "sub", "t0": 139.613, "t1": 140.933, "text": "Shimoldagi eng xavfli"}, {"k": "sub", "t0": 140.953, "t1": 142.153, "text": "dushman yengildi."}, {"k": "sub", "t0": 142.493, "t1": 143.813, "text": "Endi Temurning ko'zi"}, {"k": "sub", "t0": 143.833, "t1": 145.393, "text": "janubga Eron va"}, {"k": "sub", "t0": 145.413, "t1": 146.613, "text": "Hindistonga tushadi."}, {"k": "sub", "t0": 146.873, "t1": 147.973, "text": "Hindistonda uni"}, {"k": "sub", "t0": 147.993, "t1": 149.673, "text": "jangovar fillar kutardi."}, {"k": "sub", "t0": 149.913, "t1": 151.273, "text": "Bu jang qanday tugadi?"}, {"k": "sub", "t0": 151.473, "t1": 152.473, "text": "Keyingi qismda."}, {"k": "sub", "t0": 153.086, "t1": 153.706, "text": "Siz-chi,"}, {"k": "sub", "t0": 153.986, "t1": 154.886, "text": "olti oy suvsiz"}, {"k": "sub", "t0": 154.906, "t1": 156.166, "text": "dashtda Temurning"}, {"k": "sub", "t0": 156.186, "t1": 157.506, "text": "ortidan borarmidingiz?"}, {"k": "sub", "t0": 157.626, "t1": 159.306, "text": "Javobingizni izohda yozing."}]}