arm"}, {"t0": 84.931, "t1": 88.262, "img": "23", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 88.262, "t1": 93.96, "img": "mo:flank", "mv": "none", "tr": "dip", "grade": "warm"}, {"t0": 93.96, "t1": 97.1, "img": "26", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 97.1, "t1": 100.24, "img": "27", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 100.24, "t1": 104.78, "img": "mo:pursuit", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 104.78, "t1": 107.58, "img": "28", "mv": "panR", "tr": "fade", "grade": "cold"}, {"t0": 107.58, "t1": 111.8, "img": "29", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 111.8, "t1": 115.22, "img": "30", "mv": "in", "tr": "dip", "grade": "cold"}, {"t0": 115.22, "t1": 117.53, "img": "31", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 117.53, "t1": 120.52, "img": "mo:terek", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 120.52, "t1": 125.09, "img": "32", "mv": "inslow", "tr": "fade", "grade": "cold"}, {"t0": 125.09, "t1": 129.66, "img": "mo:fall", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 129.66, "t1": 133.56, "img": "40", "mv": "inslow", "tr": "dip", "grade": "cold"}, {"t0": 133.56, "t1": 136.772, "img": "33", "mv": "in", "tr": "fade", "grade": "warm"}, {"t0": 136.772, "t1": 139.923, "img": "34", "mv": "inslow", "tr": "dip", "grade": "warm"}, {"t0": 139.923, "t1": 144.343, "img": "mo:south", "mv": "none", "tr": "fade", "grade": "warm"}, {"t0": 144.343, "t1": 150.379, "img": "35", "mv": "in2", "tr": "fade", "grade": "warm"}, {"t0": 150.379, "t1": 159.926, "img": "16", "mv": "inslow", "tr": "dip", "grade": "warm"}], "over": [{"k": "tag", "t0": 0.3, "t1": 5.0, "text": "5-QISM"}, {"k": "date", "t0": 15.42, "t1": 17.58, "text": "1391", "sub": "YIL BOSHI", "sub_t": 1.52}, {"k": "name", "t0": 58.3, "t1": 60.9, "text": "ULUG' TOG'"}, {"k": "date", "t0": 70.78, "t1": 74.0, "text": "1391", "sub": "18-IYUN", "sub_t": 1.78}, {"k": "date", "t0": 115.64, "t1": 117.52, "text": "1395"}, {"k": "q", "t0": 150.616, "t1": 157.126, "pop": 39}, {"k": "subend", "t0": 157.126, "t1": 159.926}, {"k": "bars", "t0": 0.1, "t1": 14.1}, {"k": "bars", "t0": 130.3, "t1": 136.6}, {"k": "bars", "t0": 144.603, "t1": 150.343}, {"k": "sub", "t0": 0.36, "t1": 1.5, "text": "Tasavvur qiling."}, {"k": "sub", "t0": 2.08, "t1": 4.519, "text": "Olti oy, cheksiz dasht,"}, {"k": "sub", "t0": 5.02, "t1": 7.02, "text": "suv yo'q, non yo'q,"}, {"k": "sub", "t0": 7.32, "t1": 9.02, "text": "kechasi esa deyarli"}, {"k": "sub", "t0": 9.04, "t1": 10.12, "text": "qorong'i tushmaydi."}, {"k": "sub", "t0": 10.42, "t1": 11.64, "text": "Temur qo'shini To'xtamishni"}, {"k": "sub", "t0": 11.66, "t1": 12.9, "text": "izlab dunyoning"}, {"k": "sub", "t0": 12.92, "t1": 14.02, "text": "chetigacha boradi."}, {"k": "sub", "t0": 17.7, "t1": 18.34, "text": "Temur yurishga"}, {"k": "sub", "t0": 18.36, "t1": 19.86, "text": "otlanganda To'xtamishdan"}, {"k": "sub", "t0": 19.88, "t1": 20.9, "text": "elchilar keladi."}, {"k": "sub", "t0": 21.06, "t1": 22.52, "text": "Ular to'qqizta ot va"}, {"k": "sub", "t0": 22.54, "t1": 24.04, "text": "bitta lochin olib kelgan."}, {"k": "sub", "t0": 24.16, "t1": 25.06, "text": "To'xtamish kechirim"}, {"k": "sub", "t0": 25.08, "t1": 26.3, "text": "so'raydi: \"Temur"}, {"k": "sub", "t0": 26.32, "t1": 27.48, "text": "menga otadek edi."}, {"k": "sub", "t0": 27.64, "t1": 29.28, "text": "Bu ishlarni mendan bexabar"}, {"k": "sub", "t0": 29.3, "t1": 30.56, "text": "yomon odamlar qildi\"."}, {"k": "sub", "t0": 30.78, "t1": 32.06, "text": "Temur javob beradi:"}, {"k": "sub", "t0": 32.2, "t1": 33.14, "text": "\"Uni yarador holda"}, {"k": "sub", "t0": 33.16, "t1": 34.24, "text": "olib kelishganda"}, {"k": "sub", "t0": 34.26, "t1": 35.64, "text": "o'g'limdek qabul qildim."}, {"k": "sub", "t0": 35.86, "t1": 37.88, "text": "Endi unga ishonib bo'lmaydi\"."}, {"k": "sub", "t0": 38.7, "t1": 40.16, "text": "Qo'shin dashtga kiradi."}, {"k": "sub", "t0": 40.34, "t1": 41.98, "text": "Uch hafta suvsiz yurish."}, {"k": "sub", "t0": 42.1, "t1": 43.64, "text": "Otlar holdan toyadi."}, {"k": "sub", "t0": 43.84, "t1": 45.8, "text": "Keyin ochlik boshlanadi."}, {"k": "sub", "t0": 46.02, "t1": 46.74, "text": "Bitta qo'chqor"}, {"k": "sub", "t0": 46.76, "t1": 47.94, "text": "kallasining narxi"}, {"k": "sub", "t0": 48.1, "t1": 49.46, "text": "besh yuz tangaga chiqadi."}, {"k": "sub", "t0": 49.64, "t1": 51.14, "text": "Askarlar qush tuxumi"}, {"k": "sub", "t0": 51.16, "t1": 52.24, "text": "va yovvoyi giyohlar"}, {"k": "sub", "t0": 52.26, "t1": 53.3, "text": "bilan kun ko'radi."}, {"k": "sub", "t0": 53.46, "t1": 55.42, "text": "Temur katta ov uyushtiradi"}, {"k": "sub", "t0": 55.5, "t1": 56.74, "text": "va qo'shin ov go'shti"}, {"k": "sub", "t0": 56.76, "t1": 58.06, "text": "bilan omon qoladi."}, {"k": "sub", "t0": 58.26, "t1": 59.74, "text": "Ulug' tog' degan joyda"}, {"k": "sub", "t0": 59.76, "t1": 60.96, "text": "Temur cho'qqiga chiqib"}, {"k": "sub", "t0": 60.98, "t1": 62.6, "text": "yam-yashil dashtga qaraydi."}, {"k": "sub", "t0": 62.74, "t1": 64.78, "text": "Askarlarga tosh tashishni buyuradi."}, {"k": "sub", "t0": 64.88, "t1": 65.7, "text": "Ular baland"}, {"k": "sub", "t0": 65.72, "t1": 67.06, "text": "tosh minora qurishadi."}, {"k": "sub", "t0": 67.14, "t1": 68.68, "text": "Temur deydi: \"Bizdan"}, {"k": "sub", "t0": 68.7, "t1": 69.96, "text": "yodgorlik bo'lsin\"."}, {"k": "sub", "t0": 73.96, "t1": 75.22, "text": "Qunduzcha degan joyda"}, {"k": "sub", "t0": 75.24, "t1": 77.08, "text": "ikki qo'shin yuzma-yuz keladi."}, {"k": "sub", "t0": 77.2, "t1": 78.9, "text": "Dushman qo'shini ko'proq edi."}, {"k": "sub", "t0": 79.02, "t1": 80.58, "text": "Temur qo'shinini yetti qismga"}, {"k": "sub", "t0": 80.6, "t1": 81.8, "text": "bo'lib saf tortadi,"}, {"k": "sub", "t0": 81.88, "t1": 83.62, "text": "keyin hammaga otdan tushib"}, {"k": "sub", "t0": 83.64, "t1": 85.0, "text": "chodir tikishni buyuradi."}, {"k": "sub", "t0": 85.043, "t1": 85.943, "text": "To'xtamish hayron"}, {"k": "sub", "t0": 85.963, "t1": 86.963, "text": "qoladi: \"Ular"}, {"k": "sub", "t0": 86.983, "t1": 88.203, "text": "bizdan cho'chimaydimi?\""}, {"k": "sub", "t0": 88.5, "t1": 89.56, "text": "Jang boshlanadi."}, {"k": "sub", "t0": 89.58, "t1": 90.64, "text": "To'xtamish oldindan"}, {"k": "sub", "t0": 90.66, "t1": 91.8, "text": "yenga olmay, aylanib"}, {"k": "sub", "t0": 91.82, "t1": 92.96, "text": "o'tib Temur qo'shinining"}, {"k": "sub", "t0": 92.98, "t1": 93.98, "text": "orqasiga chiqadi,"}, {"k": "sub", "t0": 94.02, "t1": 95.54, "text": "lekin Temurning o'zi unga"}, {"k": "sub", "t0": 95.56, "t1": 97.1, "text": "qarab otlanganini ko'rgach,"}, {"k": "sub", "t0": 97.16, "t1": 98.44, "text": "chiday olmaydi va"}, {"k": "sub", "t0": 98.46, "t1": 100.3, "text": "jang maydonini tashlab qochadi."}, {"k": "sub", "t0": 100.36, "t1": 102.06, "text": "Temur askarlari qochganlarni"}, {"k": "sub", "t0": 102.08, "t1": 103.24, "text": "Itil, ya'ni Volga"}, {"k": "sub", "t0": 103.26, "t1": 104.84, "text": "daryosigacha quvib boradi."}, {"k": "sub", "t0": 104.9, "t1": 106.38, "text": "Oldinda keng daryo,"}, {"k": "sub", "t0": 106.48, "t1": 107.6, "text": "orqada qilich."}, {"k": "sub", "t0": 107.74, "t1": 108.9, "text": "Jo'chi ulusi tarqalib"}, {"k": "sub", "t0": 108.92, "t1": 110.34, "text": "ketadi, lekin"}, {"k": "sub", "t0": 110.36, "t1": 111.74, "text": "To'xtamish tirik qoldi."}, {"k": "sub", "t0": 112.04, "t1": 113.42, "text": "Uch yil o'tib u yana"}, {"k": "sub", "t0": 113.44, "t1": 115.02, "text": "Kavkazga bostirib kiradi."}, {"k": "sub", "t0": 117.8, "t1": 118.98, "text": "Terek daryosi bo'yida"}, {"k": "sub", "t0": 119.0, "t1": 120.42, "text": "ular yana to'qnashadi."}, {"k": "sub", "t0": 120.8, "t1": 121.78, "text": "To'xtamish yana"}, {"k": "sub", "t0": 121.8, "t1": 123.58, "text": "yengiladi va taxtidan"}, {"k": "sub", "t0": 123.6, "t1": 124.92, "text": "butunlay ayriladi."}, {"k": "sub", "t0": 125.44, "t1": 126.6, "text": "Oltin O'rda bu"}, {"k": "sub", "t0": 126.62, "t1": 127.92, "text": "zarbadan hech qachon"}, {"k": "sub", "t0": 127.94, "t1": 129.24, "text": "o'ziga kela olmadi."}, {"k": "sub", "t0": 130.26, "t1": 131.62, "text": "Temur o'z qo'li bilan"}, {"k": "sub", "t0": 131.64, "t1": 133.88, "text": "qutqargan odam o'sha"}, {"k": "sub", "t0": 133.9, "t1": 135.02, "text": "Temurning qo'lida"}, {"k": "sub", "t0": 135.04, "t1": 136.42, "text": "saltanatini yo'qotdi."}, {"k": "sub", "t0": 137.303, "t1": 138.623, "text": "Shimoldagi eng xavfli"}, {"k": "sub", "t0": 138.643, "t1": 139.843, "text": "dushman yengildi."}, {"k": "sub", "t0": 140.183, "t1": 141.503, "text": "Endi Temurning ko'zi"}, {"k": "sub", "t0": 141.523, "t1": 143.083, "text": "janubga Eron va"}, {"k": "sub", "t0": 143.103, "t1": 144.303, "text": "Hindistonga tushadi."}, {"k": "sub", "t0": 144.563, "t1": 145.663, "text": "Hindistonda uni"}, {"k": "sub", "t0": 145.683, "t1": 147.363, "text": "jangovar fillar kutardi."}, {"k": "sub", "t0": 147.603, "t1": 148.963, "text": "Bu jang qanday tugadi?"}, {"k": "sub", "t0": 149.163, "t1": 150.163, "text": "Keyingi qismda."}, {"k": "sub", "t0": 150.776, "t1": 151.396, "text": "Siz-chi,"}, {"k": "sub", "t0": 151.676, "t1": 152.576, "text": "olti oy suvsiz"}, {"k": "sub", "t0": 152.596, "t1": 153.856, "text": "dashtda Temurning"}, {"k": "sub", "t0": 153.876, "t1": 155.196, "text": "ortidan borarmidingiz?"}, {"k": "sub", "t0": 155.316, "t1": 156.996, "text": "Javobingizni izohda yozing."}]}