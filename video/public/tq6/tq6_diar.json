,{"id":"s3","speaker":"Speaker 0","start":4.86,"end":7.16,"text":"Uning qoʻshini uch kunda Ankara yoniga keldi.","wordRange":[10,16]},{"id":"s4","speaker":"Speaker 0","start":7.54,"end":9.66,"text":"Laqabing Yildirim, yaʼni chaqmoq.","wordRange":[17,20]},{"id":"s5","speaker":"Speaker 0","start":10.08,"end":11.32,"text":"Xoʻsh, sen nima qilasan?","wordRange":[21,24]},{"id":"s6","speaker":"Speaker 0","start":11.72,"end":13.3,"text":"Birinchi, jangga chiqasan.","wordRange":[25,27]},{"id":"s7","speaker":"Speaker 0","start":13.68,"end":15.3,"text":"Ikkinchi, qalʼada kutasan.","wordRange":[28,30]},{"id":"s8","speaker":"Speaker 0","start":15.68,"end":17.26,"text":"Uchinchi, elchi yuborasan.","wordRange":[31,33]},{"id":"s9","speaker":"Speaker 0","start":17.78,"end":18.82,"text":"Bu uchalasi taxmin.","wordRange":[34,36]},{"id":"s10","speaker":"Speaker 0","start":19.1,"end":19.96,"text":"Har birini koʻramiz.","wordRange":[37,39]},{"id":"s11","speaker":"Speaker 0","start":20.44,"end":22.42,"text":"Birinchi yoʻl sen jangga chiqasan.","wordRange":[40,44]},{"id":"s12","speaker":"Speaker 0","start":22.82,"end":23.98,"text":"Iyul, Jazirama.","wordRange":[45,46]},{"id":"s13","speaker":"Speaker 0","start":24.36,"end":25.12,"text":"Temur aytgan edi.","wordRange":[47,49]},{"id":"s14","speaker":"Speaker 0","start":25.4,"end":27.26,"text":"Sulton askarlarining koʻpi piyoda.","wordRange":[50,53]},{"id":"s15","speaker":"Speaker 0","start":27.56,"end":28.62,"text":"Ular charchab keladi.","wordRange":[54,56]},{"id":"s16","speaker":"Speaker 0","start":28.94,"end":31.32,"text":"Qarshingda esa sovut kiygan fillar turibdi.","wordRange":[57,62]},{"id":"s17","speaker":"Speaker 0","start":31.78,"end":35.98,"text":"Ikkinchi yoʻl sen qalʼada kutasan, lekin Temurning rejasi tayyor.","wordRange":[63,71]},{"id":"s18","speaker":"Speaker 0","start":36.34,"end":37.84,"text":"Atrofdagi qishloqlarni talash.","wordRange":[72,74]},{"id":"s19","speaker":"Speaker 0","start":38.14,"end":41.64,"text":"Xalqing sendan yordam kutadi, sen esa devor ortida oʻtiribsan.","wordRange":[75,83]},{"id":"s20","speaker":"Speaker 0","start":42,"end":44.1,"text":"Uchinchi yoʻl sen elchi yuborasan.","wordRange":[84,88]},{"id":"s21","speaker":"Speaker 0","start":44.44,"end":46.44,"text":"Temur sendan bitta qalʼani soʻragan edi.","wordRange":[89,94]},{"id":"s22","speaker":"Speaker 0","start":46.78,"end":47.16,"text":"Kamax.","wordRange":[95,95]},{"id":"s23","speaker":"Speaker 0","start":47.56,"end":51.54,"text":"Uni bersang, balki tinchlik boʻlar, lekin hamma seni qoʻrqdi, deydi.","wordRange":[96,105]},{"id":"s24","speaker":"Speaker 0","start":51.94,"end":53.76,"text":"Endi tarix qanday boʻlganini eshit.","wordRange":[106,110]},{"id":"s25","speaker":"Speaker 0","start":54.2,"end":55.3,"text":"Sulton jangga chiqdi.","wordRange":[111,113]},{"id":"s26","speaker":"Speaker 0","start":55.68,"end":57.06,"text":"Jangdan oldin buyruq berildi.","wordRange":[114,117]},{"id":"s27","speaker":"Speaker 0","start":57.42,"end":60.16,"text":"Dushman tomondagi kichik buloqni toʻnkalarlar bilan toʻsing.","wordRange":[118,124]},{"id":"s28","speaker":"Speaker 0","start":60.56,"end":62.3,"text":"Sultonning qoʻshini jangda yutqazdi.","wordRange":[125,128]},{"id":"s29","speaker":"Speaker 0","start":62.62,"end":65.36,"text":"Qochganlarning koʻpi jazirama va chanqoqdan oʻldi.","wordRange":[129,134]},{"id":"s30","speaker":"Speaker 0","start":65.86,"end":68.32,"text":"Eng qiziq joyi Sultonni kim asirga oldi?","wordRange":[135,141]},{"id":"s31","speaker":"Speaker 0","start":68.72,"end":72.2,"text":"Temurning oʻzi taxtga oʻtqazgan xon Sulton Mahmudxon.","wordRange":[142,148]},{"id":"s32","speaker":"Speaker 0","start":72.66,"end":76.4,"text":"Sultonni qoʻli arqon bilan oʻralgan holda Temurning oldiga keltirishdi.","wordRange":[149,157]},{"id":"s33","speaker":"Speaker 0","start":76.78,"end":78.66,"text":"Temur esa arqonni olib tashlatdi.","wordRange":[158,162]},{"id":"s34","speaker":"Speaker 0","start":78.98,"end":79.92,"text":"Qarshisiga oʻtqazdi.","wordRange":[163,164]},{"id":"s35","speaker":"Speaker 0","start":80.3,"end":81.4,"text":"Shoh toʻnini kiydirdi.","wordRange":[165,167]},{"id":"s36","speaker":"Speaker 0","start":81.86,"end":84.04,"text":"Sen Boyazid boʻlsang, qaysini tanlarding?","wordRange":[168,172]},{"id":"s37","speaker":"Speaker 0","start":84.36,"end":88.06,"text":"Birinchi, ikkinchi yoki uchinchi izohga raqam yoz","wordRange":[173,179]}],"model":"elevenlabs-scribe"}