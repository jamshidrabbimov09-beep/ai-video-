lardim.","start":74.82,"end":75.22,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"Izohda","start":75.48,"end":75.86,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"yoz:","start":75.9,"end":76.16,"type":"word","speaker":"speaker_0","confidence":0.999},{"text":"bir,","start":76.44,"end":76.64,"type":"word","speaker":"speaker_0","confidence":1},{"text":"ikki","start":76.94,"end":77.28,"type":"word","speaker":"speaker_0","confidence":0.995},{"text":"yoki","start":77.48,"end":77.76,"type":"word","speaker":"speaker_0","confidence":0.976},{"text":"uch.","start":77.96,"end":78.16,"type":"word","speaker":"speaker_0","confidence":1}],"speakers":["speaker_0"],"duration":78.44575,"language":"uzb","audioUrl":"https://cdn.creativeclaw.co/u/80f144a0/audio/431c376b-17b7-4e7a-a845-9e6aadde9a65.mp3","sentences":[{"id":"s1","speaker":"Speaker 0","start":0.1,"end":0.8,"text":"Tasavvur qil.","wordRange":[0,1]},{"id":"s2","speaker":"Speaker 0","start":1.24,"end":4.3,"text":"Chingizxon otiga kamon o'qini tekizgan dushmanini kechirdi.","wordRange":[2,8]},{"id":"s3","speaker":"Speaker 0","start":4.66,"end":8.98,"text":"Unga eng katta dushmanini bo'rlab olib kelgan odamlarni esa o'ldirishni buyurdi.","wordRange":[9,19]},{"id":"s4","speaker":"Speaker 0","start":9.42,"end":9.74,"text":"Nega?","wordRange":[20,20]},{"id":"s5","speaker":"Speaker 0","start":10.14,"end":14.16,"text":"Bugun sen Chingizxonning o'ng qo'li bo'lasan va hammasini ko'zing bilan ko'rasan.","wordRange":[21,31]},{"id":"s6","speaker":"Speaker 0","start":14.54,"end":15.8,"text":"Jang endigina tugadi.","wordRange":[32,34]},{"id":"s7","speaker":"Speaker 0","start":16.18,"end":19.24,"text":"Dushman tomondan ko'p odam kelib, Chingizxonga bosh egadi.","wordRange":[35,42]},{"id":"s8","speaker":"Speaker 0","start":19.58,"end":23.42,"text":"Chingizxon so'raydi: \"Jangda toğ ustidan mening otimga kim o'q tekizdi?\"","wordRange":[43,52]},{"id":"s9","speaker":"Speaker 0","start":23.86,"end":24.54,"text":"Hamma jim.","wordRange":[53,54]},{"id":"s10","speaker":"Speaker 0","start":24.92,"end":26.36,"text":"Bu odamni hozir o'ldirishadi.","wordRange":[55,58]},{"id":"s11","speaker":"Speaker 0","start":26.72,"end":27.9,"text":"Bir yigit oldinga chiqadi.","wordRange":[59,62]},{"id":"s12","speaker":"Speaker 0","start":28.22,"end":28.94,"text":"\"Men tekizdim.","wordRange":[63,64]},{"id":"s13","speaker":"Speaker 0","start":29.2,"end":31.9,"text":"O'ldirsang, o'laman, kechirsang, senga xizmat qilaman.\"","wordRange":[65,70]},{"id":"s14","speaker":"Speaker 0","start":32.159,"end":35.16,"text":"Chingizxon aytadi: \"Dushman odatda qilganini yashiradi.","wordRange":[71,76]},{"id":"s15","speaker":"Speaker 0","start":35.48,"end":36.28,"text":"Bu yashirmadi.","wordRange":[77,78]},{"id":"s16","speaker":"Speaker 0","start":36.54,"end":38.12,"text":"Bunday odam menga do'st bo'ladi.\"","wordRange":[79,83]},{"id":"s17","speaker":"Speaker 0","start":38.42,"end":40.56,"text":"Va unga yangi ism beradi ‒ Jebe.","wordRange":[84,90]},{"id":"s18","speaker":"Speaker 0","start":40.84,"end":44.02,"text":"Keyin Jebe uning eng mashhur sarkardalaridan biri bo'ladi.","wordRange":[91,98]},{"id":"s19","speaker":"Speaker 0","start":44.32,"end":46.64,"text":"Lekin eng qo'rqinchlisi hali oldinda.","wordRange":[99,103]},{"id":"s20","speaker":"Speaker 0","start":47.02,"end":47.74,"text":"To'rt yil o'tadi.","wordRange":[104,106]},{"id":"s21","speaker":"Speaker 0","start":48,"end":52.42,"text":"Chingizxonning eng katta dushmani Jamuxani o'zining navkarlari bo'rlab olib keladi.","wordRange":[107,116]},{"id":"s22","speaker":"Speaker 0","start":52.7,"end":54.36,"text":"Ular katta mukofot kutyapti.","wordRange":[117,120]},{"id":"s23","speaker":"Speaker 0","start":54.72,"end":56.54,"text":"Sen Chingizxonning yuziga qaraysan.","wordRange":[121,124]},{"id":"s24","speaker":"Speaker 0","start":56.84,"end":59.22,"text":"Xojasiga qo'l ko'targan odamga kim ishonadi?","wordRange":[125,130]},{"id":"s25","speaker":"Speaker 0","start":59.54,"end":61.9,"text":"Xoinlar mukofot o'rniga o'lim topadi.","wordRange":[131,135]},{"id":"s26","speaker":"Speaker 0","start":62.24,"end":62.84,"text":"Mana javob.","wordRange":[136,137]},{"id":"s27","speaker":"Speaker 0","start":63.04,"end":67.04,"text":"Chingizxon uchun rost gapirgan dushman xoin do'stdan qimmatroq edi.","wordRange":[138,146]},{"id":"s28","speaker":"Speaker 0","start":67.38,"end":69.92,"text":"Sen Chingizxon bo'lsang, o'sha yigitni nima qilarding?","wordRange":[147,153]},{"id":"s29","speaker":"Speaker 0","start":70.2,"end":75.22,"text":"Birinchi ‒ o'ldirardim, ikkinchi ‒ qo'yib yuborardim, uchinchi ‒ qo'shinimga olardim.","wordRange":[154,164]},{"id":"s30","speaker":"Speaker 0","start":75.48,"end":78.16,"text":"Izohda yoz: bir, ikki yoki uch.","wordRange":[165,170]}],"model":"elevenlabs-scribe"}