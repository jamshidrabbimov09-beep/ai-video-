wordRange":[0,1]},{"id":"s2","speaker":"Speaker 0","start":1.16,"end":4.68,"text":"Bir zamonda yashagan ikki eng kuchli hukmdor yuzma-yuz turibdi.","wordRange":[2,10]},{"id":"s3","speaker":"Speaker 0","start":5.02,"end":6.1,"text":"Yutqazgan asir bo'ladi.","wordRange":[11,13]},{"id":"s4","speaker":"Speaker 0","start":6.4,"end":6.94,"text":"Kim engadi?","wordRange":[14,15]},{"id":"s5","speaker":"Speaker 0","start":7.32,"end":10.48,"text":"Birinchi Temur, ikkinchi sulton Boyazid.","wordRange":[16,20]},{"id":"s6","speaker":"Speaker 0","start":11,"end":12.32,"text":"Ming to'rt yuz ikkinchi yil.","wordRange":[21,25]},{"id":"s7","speaker":"Speaker 0","start":12.74,"end":13.14,"text":"Anqara.","wordRange":[26,26]},{"id":"s8","speaker":"Speaker 0","start":13.58,"end":16.54,"text":"Sultonning laqabi Yildirim, ya'ni Chaqmoq.","wordRange":[27,31]},{"id":"s9","speaker":"Speaker 0","start":17,"end":18.7,"text":"U Yevropa ritzerlarini enggan.","wordRange":[32,35]},{"id":"s10","speaker":"Speaker 0","start":19.02,"end":21.96,"text":"Qo'shinida boshdan oyoq po'lat sovit kiygan jangchilar bor.","wordRange":[36,43]},{"id":"s11","speaker":"Speaker 0","start":22.3,"end":23.56,"text":"Faqat ko'zlari ko'rinadi.","wordRange":[44,46]},{"id":"s12","speaker":"Speaker 0","start":23.92,"end":26.04,"text":"Temurda esa sovit kiygan fillar bor.","wordRange":[47,52]},{"id":"s13","speaker":"Speaker 0","start":26.3,"end":28.08,"text":"Ularning ustida kamonchilar o'tiribdi.","wordRange":[53,56]},{"id":"s14","speaker":"Speaker 0","start":28.52,"end":30.04,"text":"Temurning yana bitta hiylasi bor.","wordRange":[57,61]},{"id":"s15","speaker":"Speaker 0","start":30.4,"end":31.78,"text":"Jangdan oldin buyruq berildi.","wordRange":[62,65]},{"id":"s16","speaker":"Speaker 0","start":32.14,"end":35.28,"text":"Dushman tomondagi kichik buloqni to'nkalarlar bilan to'sib tashlang.","wordRange":[66,73]},{"id":"s17","speaker":"Speaker 0","start":35.72,"end":36.06,"text":"Iyul.","wordRange":[74,74]},{"id":"s18","speaker":"Speaker 0","start":36.4,"end":37.04,"text":"Jazirama.","wordRange":[75,75]},{"id":"s19","speaker":"Speaker 0","start":37.32,"end":37.94,"text":"Temur dedi.","wordRange":[76,77]},{"id":"s20","speaker":"Speaker 0","start":38.26,"end":40.04,"text":"Sulton askarlarining ko'pi piyoda.","wordRange":[78,81]},{"id":"s21","speaker":"Speaker 0","start":40.32,"end":41.28,"text":"Ular charchab keladi.","wordRange":[82,84]},{"id":"s22","speaker":"Speaker 0","start":41.64,"end":43.98,"text":"Shuning uchun u sultonni ataylab shoshirdi.","wordRange":[85,90]},{"id":"s23","speaker":"Speaker 0","start":44.3,"end":45.4,"text":"Xo'sh, kim engadi?","wordRange":[91,93]},{"id":"s24","speaker":"Speaker 0","start":45.78,"end":46.68,"text":"Izohga raqam yoz.","wordRange":[94,96]},{"id":"s25","speaker":"Speaker 0","start":46.92,"end":48.1,"text":"Bir yoki ikki.","wordRange":[97,99]}],"model":"elevenlabs-scribe"}